#lang rhombus

import:
  lib("racket/file.rkt") as rktfile
  "../src/kernel/session.rhm" open
  "../src/kernel/compaction.rhm" as compaction

def tmp = to_string(rktfile.#{make-temporary-file}("rho-comp-~a", #'directory))
def cwd = (if tmp.substring(tmp.length() - 1 ..) == "/" | tmp.substring(0 .. tmp.length() - 1) | tmp)

def s = start_session(~cwd: cwd)

fun big(n :: Int) :: String:
  String.make(n, Char"x")

// 3 turns; each turn ~2500 tokens (10k chars)
for (i in 0..3):
  s.append_message({ "role": "user", "content": "question " +& i +& " " +& big(2000) })
  s.append_message({ "role": "assistant", "content": "answer " +& i +& " " +& big(8000),
                     "tool_calls": [] })

class FakeConfig(settings :: Map, model :: String)
def cfg = FakeConfig({ "keep_recent_tokens": 3000, "reserve_tokens": 16384 }, "unknown-model")

// cut should land on the latest user message (only last turn fits in 3000)
def cut = compaction.find_cut(s, cfg)
def cut_entry = s.entry(cut)
when cut_entry["data"].get("role", "") != "user" | error("cut not at user message")
when !cut_entry["data"]["content"].contains("question 2") | error("expected cut at turn 3, got: " +& cut)

// simulate a compaction entry without calling a model
s.append("compaction", { "summary": "SUMMARY OF TURNS 0-1", "first_kept": cut })
def msgs = s.messages()
when !(msgs[0]["content"].contains("SUMMARY OF TURNS 0-1")) | error("summary not injected")
when !(msgs[1]["content"].contains("question 2")) | error("kept messages wrong")
when msgs.length() != 3 | error("expected summary + last turn, got " +& msgs.length())

// context_tokens estimates from chars when no usage present
when compaction.context_tokens(s) <= 0 | error("context_tokens broken")

// persists across reload
def s2 = start_session(~cwd: cwd, ~continue_latest: #true)
when !(s2.messages()[0]["content"].contains("SUMMARY")) | error("compaction not persisted")

// oversized single turn: cut inside the turn (not only at the user message)
def s3 = start_session(~cwd: cwd +& "-big", ~no_session: #true)
s3.append_message({ "role": "user", "content": "one question" })
s3.append_message({ "role": "assistant", "content": "thinking " +& big(8000),
                    "tool_calls": [{ "id": "c1", "name": "bash", "arguments": "{}" }] })
s3.append_message({ "role": "tool", "tool_call_id": "c1", "content": "out " +& big(8000) })
s3.append_message({ "role": "assistant", "content": "done " +& big(200) })
def intra = compaction.find_cut_detail(s3, cfg)
when !intra | error("expected intra-turn cut")
when intra["id"] == 0 | error("intra-turn cut should not stay on the user message")
when intra.get("keep_suffix", #false) is_a Int
    && intra["id"] != 3
| error("keep_suffix should land on the last oversized message")

// single huge message: keep_suffix trims the kept tail
def s4 = start_session(~cwd: cwd +& "-huge", ~no_session: #true)
s4.append_message({ "role": "user", "content": "q " +& big(20000) })
def huge = compaction.find_cut_detail(s4, cfg)
when !(huge is_a Map) | error("expected keep_suffix cut for a single huge turn")
when !(huge.get("keep_suffix", #false) is_a Int) | error("expected keep_suffix")
s4.append("compaction", { "summary": "HEAD OF Q", "first_kept": huge["id"],
                          "keep_suffix": 20 })
def hm = s4.messages()
when !(hm[0]["content"].contains("HEAD OF Q")) | error("huge summary missing")
when hm[1]["content"].length() > 80 | error("keep_suffix not applied")
when !hm[1]["content"].contains("earlier content summarized") | error("trim marker missing")

// large → small switch: overflow is against the *target* window
when !compaction.overflows_window(s, cfg, 1000) | error("expected overflow vs 1000-token window")
when compaction.overflows_window(s, cfg, 1000000) | error("should fit a 1M window")
when compaction.should_compact_for_switch(s, cfg, "unknown-model", "unknown-model")
| error("same window should not compact-before-switch")
when compaction.keep_for_window(cfg, 20000) != 2048
| error("keep_for_window should clamp to 2048 when room is tiny")
when compaction.keep_for_window(cfg, 100000) != 3000
| error("keep_for_window should honor configured keep when it fits")

def s5 = start_session(~cwd: cwd +& "-switch", ~no_session: #true)
s5.append_message({ "role": "user", "content": "q" })
s5.append_message({ "role": "assistant", "content": "a", "tool_calls": [],
                    "usage": { "input": 200000, "output": 100 } })
when !compaction.should_compact_for_switch(s5, cfg, "gpt-5.2", "unknown-model")
| error("400k → 128k with 200k tokens should compact-before-switch")
when compaction.should_compact_for_switch(s5, cfg, "unknown-model", "gpt-5.2")
| error("small → large should not compact-before-switch")

when compaction.estimate_tokens({ "role": "assistant", "content": "hi",
                                  "tool_calls": [{ "arguments": { "command": "ls" } }] }) <= 0
| error("estimate_tokens should accept map arguments")

println("t_compaction OK")
