#lang rhombus

// Guard extension: blocks dangerous bash commands via the tool_call event.
// Also counts blocked attempts in rho.state (survives /reload).

export:
  init

def dangerous = ["rm -rf /", "rm -rf ~", "sudo ", "mkfs", "> /dev/sd"]

fun init(rho):
  rho.on("tool_call",
         fun (ev :: Map):
           let name = ev.get("toolName", "")
           let cmd = ev.get("input", {}).get("command", "")
           let hit:
             name == "bash"
               && (for any (pat in dangerous):
                     cmd is_a String && cmd.contains(pat))
           if hit
           | rho.state["blocked_count"] := rho.state.get("blocked_count", 0) + 1
             { "block": #true,
               "reason": "guard extension blocked dangerous command ("
                           +& rho.state["blocked_count"] +& " so far)" }
           | #false)
