#lang rhombus

// Built-in tools: read_file, write_file, edit_file, bash, grep, find, ls.
//
// Truncation follows pi: two independent limits, 2000 lines / 50KB,
// whichever is hit first; whole lines only. Reads truncate from the head,
// bash output from the tail (errors and final results matter most), and the
// full bash output is spilled to a temp file referenced in the result.

import:
  rhombus/subprocess
  rhombus/thread open
  lib("racket/base.rkt") as rkt
  lib("racket/file.rkt") as rktfile
  lib("racket/system.rkt") as rktsys
  lib("net/base64.rkt") as rkt64

export:
  install_core_tools
  set_stream_handler
  image_media_type
  encode_image
  apply_bash_hook

def MAX_LINES = 2000
def MAX_BYTES = 50 * 1024

fun byte_len(s :: String) :: Int:
  rkt.#{string-utf-8-length}(s)

fun fmt_size(n :: Int) :: String:
  cond
  | n < 1024: n +& "B"
  | n < 1024 * 1024: (math.exact(math.round(n / 102.4)) / 10.0) +& "KB"
  | ~else: (math.exact(math.round(n / (104857.6))) / 10.0) +& "MB"

// Keep the first whole lines within both limits.
// Returns values(kept_lines :: List, truncated? :: Boolean)
fun head_lines(lines :: List, max_lines :: Int, max_bytes :: Int):
  recur go(i = 0, used = 0, acc :: List = []):
    cond
    | i >= lines.length(): values(acc, #false)
    | i >= max_lines: values(acc, #true)
    | ~else:
        let l = to_string(lines[i])
        let cost = byte_len(l) + (if i > 0 | 1 | 0)
        if used + cost > max_bytes
        | values(acc, #true)
        | go(i + 1, used + cost, acc.add(l))

// Keep the last whole lines within both limits.
fun tail_lines(lines :: List, max_lines :: Int, max_bytes :: Int):
  recur go(i = lines.length() - 1, used = 0, acc :: List = []):
    cond
    | i < 0: values(acc, #false)
    | acc.length() >= max_lines: values(acc, #true)
    | ~else:
        let l = to_string(lines[i])
        let cost = byte_len(l) + (if acc == [] | 0 | 1)
        if used + cost > max_bytes
        | values(acc, #true)
        | go(i - 1, used + cost, acc.insert(0, l))

// Head truncation for tool output that reads top-down (read, grep, ls).
fun truncate_head(s :: String, ~max_lines: max_lines = MAX_LINES) :: String:
  let lines = s.split("\n", ~trim: #false)
  let values(kept, truncated) = head_lines(lines, max_lines, MAX_BYTES)
  if truncated
  | String.join(kept, "\n")
      +& "\n... [truncated: showing " +& kept.length() +& " of "
      +& lines.length() +& " lines (" +& fmt_size(byte_len(s)) +& " total)]"
  | s

def image_types :: Map:
  { ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
    ".gif": "image/gif", ".webp": "image/webp" }

fun image_media_type(path :: String) :: maybe(String):
  for values(found = #false) (ext in image_types.keys()):
    found || (path.foldcase().ends_with(ext) && image_types[ext])

fun encode_image(path :: String) :: Map:
  let data = rkt64.#{base64-encode}(filesystem.read_bytes(path), #"")
  { "media_type": image_media_type(path) || "image/png",
    "data": Bytes.utf8_string(data),
    "name": path }

// Reading an image stages it in registry.state["pending_images"]; the agent
// loop turns staged images into a user message with attachments.
fun tool_read_file(args :: Map, registry = #false):
  let path = args.get("path", "")
  cond
  | !filesystem.file_exists(path):
      "error: file not found: " +& path
  | image_media_type(path) is_a String && registry:
      registry.state["pending_images"]
        := registry.state.get("pending_images", []).add(encode_image(path))
      "[image " +& path +& " attached to the conversation]"
  | ~else:
      let content = filesystem.read_string(path)
      let lines = content.split("\n", ~trim: #false)
      let offset = math.max(1, args.get("offset", 1))
      let limit = args.get("limit", MAX_LINES)
      let window:
        for List (i in offset .. math.min(offset + limit, lines.length() + 1)):
          i +& "| " +& lines[i - 1]
      let values(kept, _) = head_lines(window, math.min(limit, MAX_LINES), MAX_BYTES)
      let last_shown = offset + kept.length() - 1
      cond
      | window == []:
          "error: offset " +& offset +& " is past the end (" +& lines.length() +& " lines)"
      | last_shown < lines.length():
          String.join(kept, "\n")
            +& "\n... [truncated: lines " +& offset +& "-" +& last_shown
            +& " of " +& lines.length()
            +& "; continue with offset=" +& (last_shown + 1) +& "]"
      | ~else: String.join(kept, "\n")

fun tool_write_file(args :: Map):
  let path = args.get("path", "")
  let content = args.get("content", "")
  let dir = Path(path).parent()
  when dir is_a Path && !filesystem.directory_exists(dir)
  | filesystem.make_directory(dir, ~parents: #true)
  filesystem.write_string(path, content, ~exists: #'truncate)
  "wrote " +& content.length() +& " chars to " +& path

// Apply one exact replacement spec against `content`; returns
// values(start, end, replacement) or an error string.
fun locate_edit(content :: String, path :: String, old_str :: String):
  cond
  | old_str == "": "error: old_string must not be empty"
  | ~else:
      let pieces = content.split(old_str, ~trim: #false)
      cond
      | pieces.length() == 1:
          "error: old_string not found in " +& path +& ": "
            +& old_str.substring(0 .. math.min(80, old_str.length()))
      | pieces.length() > 2:
          "error: old_string occurs " +& (pieces.length() - 1)
            +& " times in " +& path +& "; make it unique"
      | ~else:
          let start = to_string(pieces[0]).length()
          [start, start + old_str.length()]

// pi-style edit: one or many exact replacements, all matched against the
// ORIGINAL file content; spans must be unique and non-overlapping.
fun tool_edit_file(args :: Map):
  let path = args.get("path", "")
  cond
  | !filesystem.file_exists(path):
      "error: file not found: " +& path
  | ~else:
      let content = filesystem.read_string(path)
      let specs:
        match args.get("edits", #false)
        | l :: List:
            for List (e in l):
              if e is_a Map
              | [to_string(e.get("old_string", e.get("oldText", ""))),
                 to_string(e.get("new_string", e.get("newText", "")))]
              | ["", ""]
        | ~else:
            [[to_string(args.get("old_string", "")),
              to_string(args.get("new_string", ""))]]
      // locate every edit against the original content
      let located:
        for values(acc = []) (spec in specs):
          match acc
          | s :: String: s      // propagate first error
          | l :: List:
              let [old_str, new_str] = spec
              match locate_edit(content, path, old_str)
              | err :: String: err
              | [start, endpos]: l ++ [[start, endpos, new_str]]
      match located
      | err :: String: err
      | spans :: List:
          let sorted = spans.sort(fun (a, b): a[0] < b[0])
          let overlap:
            for values(bad = #false) (i in 0 .. sorted.length() - 1):
              bad || (sorted[i + 1][0] < sorted[i][1])
          cond
          | overlap: "error: edits overlap; make them disjoint"
          | ~else:
              let out:
                for values(acc = ["", 0]) (span in sorted):
                  let [built, pos] = acc
                  let [start, endpos, new_str] = span
                  [built +& content.substring(pos .. start) +& new_str, endpos]
              let [built, pos] = out
              filesystem.write_string(path, built +& content.substring(pos ..),
                                      ~exists: #'truncate)
              "edited " +& path
                +& (if sorted.length() > 1 | " (" +& sorted.length() +& " edits)" | "")

// Optional live-output hook (set by the TUI): called with each output line
// while a bash command runs.
def mutable stream_handler = #false
fun set_stream_handler(h):
  stream_handler := h

fun kill_tree(sp):
  // the subprocess runs in its own group: signal the whole group
  try:
    rktsys.system("kill -TERM -" +& sp.pid +& " 2>/dev/null")
    ~catch _: #void
  sp.kill()

fun shell_capture(cmd :: String, timeout :: Int,
                  ~stream: stream = #false) :: values(Any, String):
  let sp = subprocess.run_shell(cmd,
                                ~in: Port.Input.open_string(""),
                                ~out: #'pipe,
                                ~err: #'out,
                                ~group: #'new)
  let buf = Port.Output.open_string()
  let reader:
    thread:
      recur go():
        match sp.out.read_line(~mode: #'any)
        | s :: String:
            buf.write_string(s +& "\n")
            when stream && stream_handler
            | try:
                stream_handler(s)
                ~catch _: #void
            go()
        | ~else: #void
  let status:
    recur poll_loop(ticks = timeout * 10):
      cond
      | ticks <= 0:
          kill_tree(sp)
          #'timeout
      | ~else:
          match sp.poll()
          | #false:
              Thread.sleep(0.1)
              poll_loop(ticks - 1)
          | code: code
  reader.wait()
  values(status, buf.get_string().to_string())

fun prune_bash_spills():
  try:
    let dir = to_string(rkt.#{find-system-path}(rkt.#{string->symbol}("temp-dir")))
    let now = rkt.#{current-seconds}()
    for (f in filesystem.files(dir)):
      let name = to_string(f)
      skip_when !(name.starts_with("rho-bash-") && name.ends_with(".txt"))
      let path = dir +& "/" +& name
      when now - rkt.#{file-or-directory-modify-seconds}(path) > 86400
      | filesystem.delete(path)
    ~catch _:
      #void

fun bash_command(args :: Map) :: String:
  let cmd = args.get("command", args.get("cmd", ""))
  cond
  | cmd is_a String: cmd
  | cmd is_a List:
      String.join((for List (x in cmd): to_string(x)), " ")
  | ~else: ""

fun apply_bash_hook(registry, cmd :: String) :: String:
  match registry.state.get("bash_spawn_hook", #false)
  | fn :: Function:
      try:
        let r = fn({ "command": cmd })
        cond
        | r is_a String: r
        | r is_a Map: to_string(r.get("command", cmd))
        | ~else: cmd
        ~catch _: cmd
  | ~else: cmd

fun tool_bash(args :: Map, registry):
  let cmd = apply_bash_hook(registry, bash_command(args))
  cond
  | cmd == "": "error: bash called with empty command (missing arguments)"
  | ~else:
      let timeout = args.get("timeout", 120)
      let values(status, output) = shell_capture(cmd, timeout, ~stream: #true)
      let lines = output.split("\n", ~trim: #false)
      // drop the trailing empty piece from a final newline
      let lines:
        if lines.length() > 0 && lines[lines.length() - 1] == ""
        | lines.delete(lines.length() - 1)
        | lines
      let values(kept, truncated) = tail_lines(lines, MAX_LINES, MAX_BYTES)
      let shown:
        if truncated
        | // spill the full output so the model (or user) can dig further
          prune_bash_spills()
          let tmp = to_string(rktfile.#{make-temporary-file}("rho-bash-~a.txt"))
          filesystem.write_string(tmp, output, ~exists: #'truncate)
          "... [truncated: showing last " +& kept.length() +& " of "
            +& lines.length() +& " lines (" +& fmt_size(byte_len(output))
            +& "); full output: " +& tmp +& "]\n"
            +& String.join(kept, "\n")
        | output
      match status
      | #'timeout: "error: command timed out after " +& timeout +& "s\n" +& shown
      | 0: (if shown == "" | "(no output)" | shown)
      | code: "exit code " +& code +& "\n" +& shown

fun shell_quote(s :: String) :: String:
  "'" +& String.join(s.split("'", ~trim: #false), "'\\''") +& "'"

def have_rg = (block:
                 let values(status, _) = shell_capture("command -v rg", 10)
                 status == 0)

fun tool_grep(args :: Map):
  let pat = args.get("pattern", "")
  let path = args.get("path", ".")
  let glob = args.get("glob", "")
  let ignore_case = args.get("ignore_case", #false)
  cond
  | pat == "": "error: pattern must not be empty"
  | ~else:
      let limit = args.get("limit", 100)
      let cmd:
        if have_rg
        | "rg -n --no-heading --color never -M 500 "
            +& (if ignore_case | "-i " | "")
            +& (if glob == "" | "" | "-g " +& shell_quote(glob) +& " ")
            +& "-e " +& shell_quote(pat) +& " " +& shell_quote(path)
        | "grep -rn "
            +& (if ignore_case | "-i " | "")
            +& (if glob == "" | "" | "--include=" +& shell_quote(glob) +& " ")
            +& "-e " +& shell_quote(pat) +& " " +& shell_quote(path)
      let values(status, output) = shell_capture(cmd, 60)
      match status
      | 0: (if output == "" | "(no matches)" | truncate_head(output, ~max_lines: limit))
      | 1: "(no matches)"
      | #'timeout: "error: grep timed out"
      | code: "exit code " +& code +& "\n" +& truncate_head(output)

fun tool_find(args :: Map):
  let pat = args.get("pattern", "*")
  let path = args.get("path", ".")
  let cmd:
    "find " +& shell_quote(path)
      +& " -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/compiled/*'"
      +& " -name " +& shell_quote(pat) +& " | head -1000"
  let values(status, output) = shell_capture(cmd, 60)
  match status
  | 0: (if output == "" | "(no matches)" | truncate_head(output, ~max_lines: 1000))
  | #'timeout: "error: find timed out"
  | code: "exit code " +& code +& "\n" +& truncate_head(output)

fun tool_ls(args :: Map):
  let path = args.get("path", ".")
  cond
  | !filesystem.directory_exists(path):
      "error: not a directory: " +& path
  | ~else:
      let entries:
        for List (p in filesystem.files(path).sort()):
          let full = path +& "/" +& (p +& "")
          if filesystem.directory_exists(full)
          | (p +& "") +& "/"
          | p +& ""
      if entries == []
      | "(empty directory)"
      | truncate_head(String.join(entries, "\n"), ~max_lines: 500)

fun install_core_tools(registry):
  registry.register_tool(
    ~name: "read_file",
    ~description: "Read a file from the filesystem with line numbers. Returns up to `limit` lines starting at line `offset` (1-based). Reading an image file (png/jpg/gif/webp) attaches the image to the conversation.",
    ~schema: { "type": "object",
               "properties": {
                 "path": { "type": "string", "description": "Path to the file" },
                 "offset": { "type": "integer", "description": "1-based first line to read (default 1)" },
                 "limit": { "type": "integer", "description": "Max number of lines (default 2000)" }
               },
               "required": ["path"] },
    ~fn: fun (args): tool_read_file(args, registry))
  registry.register_tool(
    ~name: "write_file",
    ~description: "Write content to a file, creating parent directories as needed. Overwrites existing files.",
    ~schema: { "type": "object",
               "properties": {
                 "path": { "type": "string", "description": "Path to the file" },
                 "content": { "type": "string", "description": "Full file content" }
               },
               "required": ["path", "content"] },
    ~fn: tool_write_file)
  registry.register_tool(
    ~name: "edit_file",
    ~description: "Replace exact strings in a file. Either pass old_string/new_string for a single edit, or edits (a list of {old_string, new_string}) for several edits in one call. Each old_string must occur exactly once in the original file and edits must not overlap; include enough context to make them unique.",
    ~schema: { "type": "object",
               "properties": {
                 "path": { "type": "string", "description": "Path to the file" },
                 "old_string": { "type": "string", "description": "Exact text to replace (single-edit form)" },
                 "new_string": { "type": "string", "description": "Replacement text (single-edit form)" },
                 "edits": { "type": "array",
                            "description": "Multiple edits applied together, each matched against the original file",
                            "items": { "type": "object",
                                       "properties": {
                                         "old_string": { "type": "string" },
                                         "new_string": { "type": "string" }
                                       },
                                       "required": ["old_string", "new_string"] } }
               },
               "required": ["path"] },
    ~fn: tool_edit_file)
  registry.register_tool(
    ~name: "bash",
    ~description: "Run a shell command and return its combined stdout/stderr output. Long output is tail-truncated; the full output is saved to a temp file whose path appears in the result.",
    ~schema: { "type": "object",
               "properties": {
                 "command": { "type": "string", "description": "Shell command to run" },
                 "timeout": { "type": "integer", "description": "Timeout in seconds (default 120)" }
               },
               "required": ["command"] },
    ~fn: fun (args): tool_bash(args, registry))
  registry.register_tool(
    ~name: "grep",
    ~description: "Search file contents for a regex pattern. Returns matching lines with file:line prefixes.",
    ~schema: { "type": "object",
               "properties": {
                 "pattern": { "type": "string", "description": "Regex pattern to search for" },
                 "path": { "type": "string", "description": "File or directory to search (default .)" },
                 "glob": { "type": "string", "description": "Only search files matching this glob, e.g. *.rhm" },
                 "ignore_case": { "type": "boolean", "description": "Case-insensitive search" }
               },
               "required": ["pattern"] },
    ~fn: tool_grep)
  registry.register_tool(
    ~name: "find",
    ~description: "Find files by name glob pattern under a directory (skips .git, node_modules, compiled).",
    ~schema: { "type": "object",
               "properties": {
                 "pattern": { "type": "string", "description": "Filename glob, e.g. *.rhm" },
                 "path": { "type": "string", "description": "Directory to search (default .)" }
               },
               "required": ["pattern"] },
    ~fn: tool_find)
  registry.register_tool(
    ~name: "ls",
    ~description: "List the entries of a directory. Directories are suffixed with /.",
    ~schema: { "type": "object",
               "properties": {
                 "path": { "type": "string", "description": "Directory to list (default .)" }
               },
               "required": ["path"] },
    ~fn: tool_ls)
