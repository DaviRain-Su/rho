#lang rhombus

// The agent loop: stream model output, execute tool calls, repeat.

import:
  json
  lib("racket/base.rkt") as rkt
  "../ai/openai.rhm"
  "../ai/anthropic.rhm"
  "../ai/types.rhm" open

export:
  run_turn
  call_provider

def MAX_STEPS = 40

fun call_provider(config, messages, tools, on_text,
                  ~on_thinking: on_thinking = fun (s): #void,
                  ~headers: headers :: Map = {}):
  // auto-retry with exponential backoff (settings: auto_retry / max_retries)
  let retries:
    if config.settings.get("auto_retry", #true) == #false
    | 0
    | config.settings.get("max_retries", 3)
  recur attempt(n = 0):
    try:
      do_call_provider(config, messages, tools, on_text, on_thinking, headers)
      ~catch e :: Exn.Fail:
        let transient:
          e.message.contains("timed out") || e.message.contains("connection")
            || e.message.contains("HTTP 429") || e.message.contains("HTTP 5")
        if transient && n < retries
        | rkt.sleep(math.min(8, rkt.expt(2, n)))
          attempt(n + 1)
        | throw e

fun do_call_provider(config, messages, tools, on_text, on_thinking, headers :: Map):
  match config.kind()
  | "anthropic":
      anthropic.stream_chat(~base_url: config.base_url(),
                            ~api_key: config.api_key(),
                            ~model: config.model,
                            ~messages: messages,
                            ~tools: tools,
                            ~on_text: on_text,
                            ~on_thinking: on_thinking,
                            ~thinking: config.thinking,
                            ~extra_headers: headers)
  | ~else:
      openai.stream_chat(~base_url: config.base_url(),
                         ~api_key: config.api_key(),
                         ~model: config.model,
                         ~messages: messages,
                         ~tools: tools,
                         ~on_text: on_text,
                         ~on_thinking: on_thinking,
                         ~thinking: config.thinking,
                         ~extra_headers: headers)

// Drain steering messages (sent to the current thread's mailbox by the REPL
// while a turn runs) into the session. Returns #true if any arrived.
// steering_mode "one-at-a-time" (registry.state) delivers one per round.
fun drain_steering(session, registry, on_steer):
  let one_at_a_time = registry.state.get("steering_mode", "all") == "one-at-a-time"
  recur go(any = #false):
    match rkt.#{thread-try-receive}()
    | #false: any
    | v:
        let s = to_string(v)
        session.append_message(user_message(s))
        registry.emit("user_message", { "content": s, "steering": #true })
        on_steer(s)
        if one_at_a_time | #true | go(#true)

// Executes one full user turn. UI callbacks:
//   on_text(delta)                     streaming assistant text
//   on_thinking(delta)                 streaming chain-of-thought text
//   on_tool(name, args_map)            before a tool runs
//   on_tool_result(name, result_str)   after a tool ran
//   on_steer(msg)                      a queued steering message was injected
//
// Events emitted: input (may rewrite {"text"}), agent_start/agent_end/
// agent_settled (whole turn), turn_start/turn_end (each model round),
// before_request (may return {"messages": [...]} to inject transient
// context), context (may rewrite the full outgoing {"messages"}),
// before_provider_request (may return {"headers": {...}}), message_start/
// message_update/message_end (streaming), tool_call (may block),
// tool_execution_start/tool_execution_end, tool_result, user_message.
fun run_turn(~config: config,
             ~registry: registry,
             ~session: session,
             ~system_prompt: system_prompt :: String,
             ~input: input :: String,
             ~on_text: on_text = fun (s): #void,
             ~on_thinking: on_thinking = fun (s): #void,
             ~on_tool: on_tool = fun (name, args): #void,
             ~on_tool_result: on_tool_result = fun (name, r): #void,
             ~on_steer: on_steer = fun (s): #void,
             ~images: images :: List = []):
  // "input" may rewrite the user's text before it enters the session
  let input:
    match registry.emit("input", { "text": input })
    | m :: Map:
        match m.get("text", #false)
        | s :: String: s
        | ~else: input
    | ~else: input
  session.append_message(if images == []
                         | user_message(input)
                         | user_message(input) ++ { "images": images })
  registry.emit("user_message", { "content": input })
  registry.emit("agent_start", { "input": input })
  recur step(n = 0):
    when n >= MAX_STEPS
    | error("agent loop exceeded " +& MAX_STEPS +& " steps")
    registry.emit("turn_start", { "step": n })
    let injected:
      match registry.emit("before_request", { "step": n })
      | m :: Map:
          let ms = m.get("messages", [])
          if ms is_a List | ms | []
      | ~else: []
    let messages = [system_message(system_prompt)] ++ injected ++ session.messages()
    // "context" may rewrite the outgoing message list wholesale
    let messages:
      match registry.emit("context", { "messages": messages })
      | m :: Map:
          match m.get("messages", #false)
          | ms :: List: ms
          | ~else: messages
      | ~else: messages
    // "before_provider_request" may contribute extra HTTP headers
    let extra_headers:
      match registry.emit("before_provider_request",
                          { "model": config.model, "step": n })
      | m :: Map:
          let h = m.get("headers", {})
          if h is_a Map | h | {}
      | ~else: {}
    registry.emit("message_start", { "step": n })
    let assistant = call_provider(config, messages, registry.tools_wire(),
                                  fun (s):
                                    registry.emit("message_update", { "delta": s })
                                    on_text(s),
                                  ~on_thinking:
                                    fun (s):
                                      registry.emit("thinking_update", { "delta": s })
                                      on_thinking(s),
                                  ~headers: extra_headers)
    registry.emit("message_end", { "message": assistant })
    session.append_message(assistant)
    let tool_calls = tool_calls_of(assistant)
    for (tc in tool_calls):
      let name = tc["name"]
      let args = try:
                   json.from_string(tc["arguments"])
                   ~catch _: {}
      let args = (if args is_a Map | args | {})
      on_tool(name, args)
      let verdict = registry.emit("tool_call", { "toolName": name, "input": args })
      registry.emit("tool_execution_start", { "toolName": name, "input": args })
      let result:
        cond
        | verdict is_a Map && verdict.get("block", #false):
            "blocked: " +& verdict.get("reason", "blocked by extension")
        | ~else:
            let tool = registry.find_tool(name)
            cond
            | !tool: "error: unknown tool: " +& name
            | ~else:
                try:
                  to_string(tool.fn(args))
                  ~catch e :: Exn.Fail:
                    "error: " +& e.message
      registry.emit("tool_execution_end", { "toolName": name, "result": result })
      registry.emit("tool_result", { "toolName": name, "result": result })
      on_tool_result(name, result)
      session.append_message(tool_message(tc["id"], result))
    // images staged by tools (read_file on an image) become a user message
    // with attachments so both provider protocols can carry them
    match registry.state.get("pending_images", [])
    | [] : #void
    | imgs :: List:
        registry.state["pending_images"] := []
        let names:
          String.join((for List (im in imgs): to_string(im.get("name", "image"))), ", ")
        session.append_message(user_message("[attached image(s): " +& names +& "]")
                                 ++ { "images": imgs })
    registry.emit("turn_end", { "step": n,
                                "content": assistant.get("content", ""),
                                "tool_count": tool_calls.length() })
    let steered = drain_steering(session, registry, on_steer)
    when tool_calls != [] || steered
    | step(n + 1)
  registry.emit("agent_end", {})
  registry.emit("agent_settled", {})
  #void
