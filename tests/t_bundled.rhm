#lang rhombus

import:
  lib("racket/file.rkt") as rktfile
  "../src/kernel/registry.rhm" open
  "../src/kernel/session.rhm" open
  "../src/kernel/loop.rhm" as loop
  "../src/ext/api.rhm" open
  "../src/ext/loader.rhm" as loader
  "../src/kernel/reload.rkt" as reload
  "../src/tools/core.rhm" as core
  "../src/ext/bundled/sandbox.rhm" as sandbox
  "../src/ext/bundled/plan.rhm" as plan
  "../src/ext/bundled/todo.rhm" as todo
  "../src/ext/bundled/question.rhm" as question
  "../src/ext/bundled/checkpoint.rhm" as checkpoint
  "../src/ext/bundled/fetch.rhm" as fetch
  "../src/ext/bundled/permission.rhm" as permission
  lib("racket/base.rkt") as rkt

def mutable failures = 0
fun check(label :: String, ok):
  if ok
  | println("ok   " +& label)
  | println("FAIL " +& label)
    failures := failures + 1

def bundled = loader.bundled_extensions_dir()
check("bundled dir exists", filesystem.directory_exists(bundled))
check("guards shipped", filesystem.file_exists(bundled +& "/guards.rhm"))
check("audit shipped", filesystem.file_exists(bundled +& "/audit.rhm"))
check("memory shipped", filesystem.file_exists(bundled +& "/memory.rhm"))
check("doctor shipped", filesystem.file_exists(bundled +& "/doctor.rhm"))
check("usage shipped", filesystem.file_exists(bundled +& "/usage.rhm"))
check("verify shipped", filesystem.file_exists(bundled +& "/verify.rhm"))
check("agent shipped", filesystem.file_exists(bundled +& "/agent.rhm"))
check("dashboard shipped", filesystem.file_exists(bundled +& "/dashboard.rhm"))
check("sandbox shipped", filesystem.file_exists(bundled +& "/sandbox.rhm"))
check("todo shipped", filesystem.file_exists(bundled +& "/todo.rhm"))
check("plan shipped", filesystem.file_exists(bundled +& "/plan.rhm"))
check("question shipped", filesystem.file_exists(bundled +& "/question.rhm"))
check("checkpoint shipped", filesystem.file_exists(bundled +& "/checkpoint.rhm"))
check("fetch shipped", filesystem.file_exists(bundled +& "/fetch.rhm"))
check("mcp_ext shipped", filesystem.file_exists(bundled +& "/mcp_ext.rhm"))
check("permission shipped", filesystem.file_exists(bundled +& "/permission.rhm"))

def found = loader.discover_extensions(~include_project: #false)
check("discover includes guards",
      found.contains(bundled +& "/guards.rhm"))

def tmp = to_string(rktfile.#{make-temporary-file}("rho-bundled-~a", #'directory))
def notes = Port.Output.open_string()
def reg = make_registry()
def sess = start_session(~cwd: tmp, ~no_session: #true)
def api = PiAPI(reg, fun (): notes, fun (): sess, [])

fun load_one(name :: String):
  let path = bundled +& "/" +& name
  reload.rerequire_path(path)
  let init = reload.get_export(path, "init")
  reg.current_source := path
  init(api)
  reg.current_source := "builtin"

load_one("guards.rhm")
check("block rm -rf /",
      reg.emit("tool_call",
               { "toolName": "bash",
                 "input": { "command": "rm -rf /" } }).get("block", #false))
check("block grep -r",
      reg.emit("tool_call",
               { "toolName": "bash",
                 "input": { "command": "grep -rn foo src" } }).get("block", #false))
check("allow ls | grep",
      reg.emit("tool_call",
               { "toolName": "bash",
                 "input": { "command": "ls -R | grep foo" } }) == #false)
check("allow grep -e -r",
      reg.emit("tool_call",
               { "toolName": "bash",
                 "input": { "command": "grep -e -r file" } }) == #false)
check("allow echo",
      reg.emit("tool_call",
               { "toolName": "bash",
                 "input": { "command": "echo hi" } }) == #false)

load_one("audit.rhm")
reg.state["audit_dir"] := tmp +& "/logs"
reg.emit("agent_start", { "input": "hello" })
reg.emit("tool_execution_start",
         { "toolName": "bash", "input": { "command": "echo x" } })
reg.emit("agent_end", {})
check("session log",
      filesystem.file_exists(tmp +& "/logs/session.log")
        && filesystem.read_string(tmp +& "/logs/session.log").contains("start"))
check("tools log",
      filesystem.file_exists(tmp +& "/logs/tools.log")
        && filesystem.read_string(tmp +& "/logs/tools.log").contains("bash"))

load_one("memory.rhm")
reg.state["memory_path"] := tmp +& "/MEMORY.md"
reg.find_command("remember").handler("staging uses eu-west")
check("remember wrote",
      filesystem.read_string(tmp +& "/MEMORY.md").contains("eu-west"))
def injected = reg.emit("before_request", { "step": 0 })
check("memory injected",
      injected is_a Map
        && to_string(injected["messages"][0]["content"]).contains("eu-west"))
check("memory skip later step",
      reg.emit("before_request", { "step": 1 }) == #false)

load_one("doctor.rhm")
check("doctor registered", reg.find_command("doctor") && #true)
reg.find_command("doctor").handler("")
check("doctor notified", notes.get_string().to_string().contains("HOME"))

load_one("usage.rhm")
sess.append_message({ "role": "user", "content": "hello there" })
check("context registered", reg.find_command("context") && #true)
reg.find_command("context").handler("")
check("context notified", notes.get_string().to_string().contains("estimated tokens"))

check("stop reason",
      loop.stop_reason({ "block": #true, "reason": "tests failed" }, 0)
        == "tests failed")
check("stop ignores empty verdict", loop.stop_reason(#false, 0) == #false)
check("stop cap",
      loop.stop_reason({ "block": #true, "reason": "x" },
                       loop.MAX_STOP_CONTINUATIONS)
        == #false)

class StepCfg(settings :: Map)
check("step default 200", loop.step_limit(StepCfg({})) == 200)
check("step custom", loop.step_limit(StepCfg({ "max_steps": 80 })) == 80)
check("step clamp high",
      loop.step_limit(StepCfg({ "max_steps": 99999 })) == loop.MAX_STEPS_CAP)
check("step reject zero",
      loop.step_limit(StepCfg({ "max_steps": 0 })) == loop.MAX_STEPS)
check("step parse string",
      loop.step_limit(StepCfg({ "max_steps": "120" })) == 120)
check("step limit message",
      loop.step_limit_message(200).contains("/steps"))

check("safe read_file", permission.safe_tool("read_file"))
check("unsafe bash", !permission.safe_tool("bash"))
check("ask mode prompts bash", permission.should_ask("ask", "bash", #false))
check("ask mode skips read", !permission.should_ask("ask", "read_file", #false))
check("allow mode skips bash", !permission.should_ask("allow", "bash", #false))
check("verdict ask forces prompt",
      permission.should_ask("allow", "read_file", { "ask": #true }))
class FakeCfg(settings :: Map)
check("permission default allow",
      permission.permission_mode(FakeCfg({})) == "allow")
check("permission ask setting",
      permission.permission_mode(FakeCfg({ "permission_mode": "ask" })) == "ask")
check("wants_ask verdict",
      loop.wants_ask(reg, "read_file", { "ask": #true }))
check("wants_ask no hook",
      !loop.wants_ask(make_registry(), "bash", #false))

def ask_reg = make_registry()
check("request_ask default allow",
      loop.request_ask(ask_reg, { "toolName": "bash" }) == "allow")
check("pending_ask cleared after default",
      ask_reg.state.get("pending_ask", #true) == #false)
fun deny_ask():
  "deny"
ask_reg.state["ask_reply"] := deny_ask
check("request_ask deny reply",
      loop.request_ask(ask_reg, { "toolName": "bash" }) == "deny")
fun yes_ask():
  "Y"
ask_reg.state["ask_reply"] := yes_ask
check("request_ask y means allow",
      loop.request_ask(ask_reg, { "toolName": "write_file" }) == "allow")

load_one("verify.rhm")
reg.state["verify_cmd"] := "exit 7"
def blocked = reg.emit("agent_end", { "continuations": 0 })
check("verify blocks on failure",
      blocked is_a Map && blocked.get("block", #false)
        && to_string(blocked.get("reason", "")).contains("exit 7"))
reg.state["verify_cmd"] := "true"
check("verify allows success",
      reg.emit("agent_end", { "continuations": 0 }) == #false)
reg.find_command("verify").handler("off")
check("verify off", reg.state.get("verify_cmd", #true) == #false)

load_one("permission.rhm")
check("permission command", reg.find_command("permission") && #true)
check("allow command", reg.find_command("allow") && #true)
check("ask command", reg.find_command("ask") && #true)
check("wants_ask hook",
      loop.wants_ask(reg, "bash", #false) == #false)

load_one("agent.rhm")
check("agent tool", reg.find_tool("agent") && #true)
check("agent empty prompt",
      to_string(reg.find_tool("agent").fn({})).contains("prompt is required"))
check("agent no config",
      to_string(reg.find_tool("agent").fn({ "prompt": "hi" })).contains("no live config"))
check("tasks pane registered",
      match reg.state.get("panes", #false)
      | m :: MutableMap: m.has_key("tasks")
      | ~else: #false)
check("agent snippet",
      to_string(reg.state.get("prompt_snippets", [])).contains("`agent`"))
check("max_agent_depth default",
      reg.state.get("max_agent_depth", 0) == 1)

load_one("dashboard.rhm")
check("dashboard command", reg.find_command("dashboard") && #true)
reg.find_command("dashboard").handler("")
check("dashboard snapshot",
      to_string(reg.state.get("dashboard_snap", "")).contains("permission:"))

load_one("sandbox.rhm")
check("sandbox command", reg.find_command("sandbox") && #true)
check("sandbox default off", reg.state.get("sandbox_on", #true) == #false)
check("sandbox hook off", core.apply_bash_hook(reg, "echo hi") == "echo hi")
reg.find_command("sandbox").handler("on")
check("sandbox on", reg.state.get("sandbox_on", #false))
def wrapped = core.apply_bash_hook(reg, "echo hi")
check("sandbox wrap or passthrough",
      wrapped != "echo hi" || sandbox.wrap_command("echo hi") == "echo hi")
check("sh_quote", sandbox.sh_quote("it's") == "'it'\\''s'")
reg.find_command("sandbox").handler("off")
check("sandbox off again", core.apply_bash_hook(reg, "echo hi") == "echo hi")

load_one("todo.rhm")
check("todo tool", reg.find_tool("todo") && #true)
check("todo add",
      to_string(reg.find_tool("todo").fn({ "action": "add", "text": "ship plan" }))
        .contains("#1"))
check("todo list",
      to_string(reg.find_tool("todo").fn({ "action": "list" })).contains("ship plan"))
check("todo toggle",
      to_string(reg.find_tool("todo").fn({ "action": "toggle", "id": 1 }))
        .contains("[x]"))
check("todos command", reg.find_command("todos") && #true)
check("todos pane registered",
      match reg.state.get("panes", #false)
      | m :: MutableMap: m.has_key("todos")
      | ~else: #false)
reg.find_command("todos").handler("")
check("todos notified", notes.get_string().to_string().contains("ship plan"))

check("plan echo safe", plan.is_safe_command("echo hi"))
check("plan git status safe", plan.is_safe_command("git status"))
check("plan git push blocked", !plan.is_safe_command("git push origin main"))
check("plan rm blocked", !plan.is_safe_command("rm -rf src"))
check("plan redirect blocked", !plan.is_safe_command("echo x > file"))
def extracted = plan.extract_plan_items("intro\nPlan:\n1. Read the loop\n2. Add tests\n")
check("plan extract count", extracted.length() == 2)
check("plan extract text",
      extracted[0] is_a Map && extracted[0].get("text", "") == "Read the loop")
def marked = plan.apply_dones("did it [DONE:1]", extracted)
check("plan done tag",
      marked[0] is_a Map && marked[0].get("done", #false))
check("plan format", todo.format_list([]).contains("no todos"))

load_one("plan.rhm")
check("plan command", reg.find_command("plan") && #true)
reg.find_command("plan").handler("on")
check("plan on", reg.state.get("plan_on", #false))
check("plan blocks write",
      reg.emit("tool_call",
               { "toolName": "write_file", "input": {} }).get("block", #false))
check("plan allows echo bash",
      reg.emit("tool_call",
               { "toolName": "bash",
                 "input": { "command": "echo hi" } }) == #false)
check("plan blocks rm bash",
      reg.emit("tool_call",
               { "toolName": "bash",
                 "input": { "command": "rm -rf x" } }).get("block", #false))
reg.find_command("plan").handler("off")
check("plan off", !reg.state.get("plan_on", #true))
check("plan off allows write",
      reg.emit("tool_call",
               { "toolName": "write_file", "input": {} }) == #false)
check("plan whitelist has question", plan.PLAN_TOOLS.contains("question"))

check("option_labels strings",
      question.option_labels(["a", "b"]) == ["a", "b"])
check("option_labels maps",
      question.option_labels([{ "label": "Yes", "description": "do it" }])
        == ["Yes"])
def qreg = make_registry()
fun no_out():
  #false
def qapi = PiAPI(qreg, no_out, fun (): sess, [])
let qpath = bundled +& "/question.rhm"
reload.rerequire_path(qpath)
qreg.current_source := qpath
reload.get_export(qpath, "init")(qapi)
qreg.current_source := "builtin"
check("question tool", qreg.find_tool("question") && #true)
check("question no UI",
      to_string(qreg.find_tool("question").fn({ "question": "pick",
                                                "options": ["a", "b"] }))
        .contains("no UI"))

check("fetch rejects file", !fetch.ok_url("file:///tmp/x"))
check("fetch rejects empty", !fetch.ok_url(""))
check("fetch allows https", fetch.ok_url("https://example.com/x"))
check("fetch allows http", fetch.ok_url("http://example.com/x"))
def stripped = fetch.strip_html("<html><head><style>p{color:red}</style></head>"
                                  +& "<body><script>alert(1)</script>"
                                  +& "<h1>Hello</h1><p>World</p></body></html>")
check("fetch strips script", !stripped.contains("alert"))
check("fetch strips tags", !stripped.contains("<h1>") && stripped.contains("Hello"))
check("fetch clip", fetch.clip("abcd", 2).contains("truncated"))

def csess = start_session(~cwd: tmp, ~no_session: #true)
csess.append("custom",
             { "type": "git_checkpoint", "entry_id": 3, "ref": "abc123def" })
check("checkpoint lookup", checkpoint.lookup_ref(csess, 3) == "abc123def")
check("checkpoint miss", checkpoint.lookup_ref(csess, 9) == "")
check("checkpoint no session", checkpoint.lookup_ref(#false, 3) == "")
def old_cwd = to_string(rkt.#{current-directory}())
rkt.#{current-directory}(tmp)
check("checkpoint skips non-git", !checkpoint.in_git_repo())
rkt.#{current-directory}(old_cwd)

load_one("checkpoint.rhm")
check("checkpoint fork handler idle",
      reg.emit("session_before_fork",
               { "target": 3, "path": tmp }) == #false)

reg.state["mcp_skip_reload"] := #true
load_one("mcp_ext.rhm")
check("mcp command", reg.find_command("mcp") && #true)
reg.find_command("mcp").handler("list")
check("mcp list notified",
      notes.get_string().to_string().contains("MCP")
        || notes.get_string().to_string().contains("mcp"))

def main_src = filesystem.read_string("src/main.rhm")
check("fork emits target event",
      main_src.contains("session_before_fork")
        && main_src.contains("\"target\":"))
check("clone uses clone event", main_src.contains("session_before_clone"))
check("main does not connect MCP", !main_src.contains("mcp.reload"))

if failures == 0
| println("t_bundled OK")
| error("bundled tests failed: " +& failures)
