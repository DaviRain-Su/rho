#lang rhombus

// Full-screen TUI on top of raart (via the term.rkt shim).
//
// Layout (pi-style): transcript area / status line / separator / multi-line
// editor / footer. The status line (spinner + activity + elapsed) is its own
// row above the editor, so it never covers the footer stats.
// Keys: Enter submit, Ctrl-J newline, Alt-Enter queue follow-up, Tab path
// completion, Up/Down history (or cursor movement in multi-line input),
// PgUp/PgDn or mouse wheel scroll, click tool output to fold/expand, click
// the status row to interrupt, click autocomplete / editor / footer (footer
// cycles the model). A pending tool-permission card is clickable
// ([1] Allow / [2] Deny; y/n/Enter/Esc). Mouse drag still selects transcript text and copies
// it on release (OSC 52 + clipboard tools; Shift+drag falls back to
// native terminal selection), Ctrl-C interrupt turn (or clear input /
// quit), Escape interrupt (restores queued follow-ups to the editor),
// Ctrl-G external editor, Ctrl-X copy last assistant message, Ctrl-O
// expand/collapse tool output, Ctrl-T show/hide chain of thought,
// Shift-Tab cycle thinking level, Ctrl-P cycle scoped models,
// Ctrl-K/W/Y/U + Alt-Y kill-ring, Ctrl-L redraw, Ctrl-D quit.
// ~/.rho/keybindings.json remaps actions (external_editor, copy_last,
// toggle_tool_output, toggle_thinking, cycle_thinking, queue_followup,
// kill_line, yank, kill_word, yank_pop).
// The editor highlights /commands, !shell, @files, and `code`.
// Assistant output is rendered with lightweight markdown styling (headers,
// bold, `code`, ``` fences, lists, quotes).
//
// While a turn runs, typed lines steer (same mailbox protocol as the line
// REPL); "/follow <msg>" queues a follow-up turn. "!cmd" runs a shell
// command directly.

import:
  lib("racket/base.rkt") as rkt
  lib("racket/file.rkt") as rktfile
  lib("racket/system.rkt") as rktsys
  lib("net/base64.rkt") as rkt64
  json
  "term.rkt" as term
  "style.rhm" open
  "pager.rhm" as pager
  "../kernel/sync.rkt" as sync
  "../kernel/tasks.rhm" as tasks

export:
  run_tui
  push
  push_block
  push_delta
  push_delta_kind
  push_think_delta
  set_activity
  set_widget
  set_footer_extra
  set_working_indicator
  set_header
  set_title
  copy_text
  default_theme
  md_line_spans
  editor_line_spans
  wrap_spans
  highlight_search_row
  search_prompt_rows
  fit_tui_layout
  take_paste_images
  make_hit
  hit_at
  ask_card_rows
  ask_card_hits
  ASK_CARD_H
  toggle_pane
  open_overlay
  close_overlay
  open_page
  close_page
  begin_question
  begin_plan_review
  active_pane
  overlay_kind
  page_kind

// Images pasted from the clipboard (Ctrl-V / Alt-V) while the TUI is
// running.  Each entry is an attachment map shaped like encode_image's
// output: { media_type, data (base64), name }.  take_paste_images()
// drains and returns them so handle_input_tui can attach them to the
// next turn.
def mutable pending_images :: List = []

def mutable pending_image_count = 0

fun take_paste_images() :: List:
  let l = pending_images
  pending_images := []
  pending_image_count := 0
  l

// ---- shared transcript state (written by turn threads, read by render) ----
def mutable lines :: List = []       // [kind, text] finalized lines
def mutable partial :: String = ""   // streaming tail without newline yet
def mutable partial_kind :: String = "assistant"  // "assistant" | "think"
def mutable dirty = #true
def mutable activity = #false        // "thinking" / "tool: x" / ... while a turn runs
def trans_lock = sync.#{make-lock}()

fun with_trans(fn):
  sync.#{with-lock}(trans_lock, fn)

def spinner_frames = ["\u280B", "\u2819", "\u2839", "\u2838", "\u283C",
                      "\u2834", "\u2826", "\u2827", "\u2807", "\u280F"]
// extension-customizable spinner; #false means use the default frames
def mutable spinner_frames_custom = #false
def mutable spinner_interval_ms = 200

fun set_working_indicator(~frames: frames :: List = [], ~interval_ms: interval_ms :: Int = 200):
  fun go():
    when frames != []
    | spinner_frames_custom := frames
    spinner_interval_ms := interval_ms
    dirty := #true
    #void
  with_trans(go)
  wake()

// extension-owned header / title lines above the transcript
def mutable header_extra :: String = ""
def mutable title_str :: String = ""

fun set_header(s :: String):
  fun go():
    header_extra := s
    dirty := #true
    #void
  with_trans(go)
  wake()

fun set_title(s :: String):
  fun go():
    title_str := s
    dirty := #true
    #void
  with_trans(go)
  wake()

// Posting this semaphore wakes the render loop immediately, so pushes from
// background threads (turn streaming, notify pump, shell output) appear
// without waiting out the input-poll timeout.
def wake_sema = rkt.#{make-semaphore}(0)
fun wake():
  rkt.#{semaphore-post}(wake_sema)

// ---- pager chrome (panes / overlays / blocking cards) ----
def mutable active_pane = #false
def mutable overlay_kind = #false
def mutable overlay_sel = 0
def mutable overlay_query :: String = ""
def mutable overlay_data = #false

fun toggle_pane(id :: String):
  active_pane := (if active_pane == id | #false | id)
  dirty := #true
  wake()

fun open_overlay(id :: String, data = #false):
  overlay_kind := id
  overlay_sel := 0
  overlay_query := ""
  overlay_data := data
  dirty := #true
  wake()

fun close_overlay():
  overlay_kind := #false
  overlay_query := ""
  overlay_data := #false
  dirty := #true
  wake()

def mutable page_kind = #false
def mutable page_data = #false
def mutable page_sel = 0
def mutable page_query :: String = ""
def mutable page_drafts :: Map = {}

fun open_page(id :: String, data = #false):
  page_kind := id
  page_data := data
  page_sel := 0
  page_query := ""
  page_drafts := {}
  dirty := #true
  wake()

fun close_page():
  page_kind := #false
  page_data := #false
  page_sel := 0
  page_query := ""
  page_drafts := {}
  dirty := #true
  wake()

def mutable q_sema = #false
def mutable q_result :: String = ""
def mutable q_waiting = #false
def mutable q_prompt :: String = ""
def mutable q_options :: List = []

fun begin_question(prompt :: String, options :: List) :: String:
  q_prompt := prompt
  q_options := options
  q_result := ""
  q_waiting := #true
  q_sema := rkt.#{make-semaphore}(0)
  dirty := #true
  wake()
  rkt.#{semaphore-wait}(q_sema)
  q_result

fun answer_question(s :: String):
  when q_waiting
  | q_waiting := #false
    q_result := s
    match q_sema
    | #false: #void
    | sema: rkt.#{semaphore-post}(sema)
    dirty := #true
    wake()

def mutable plan_sema = #false
def mutable plan_result :: String = ""
def mutable plan_waiting = #false
def mutable plan_items_ui :: List = []

fun begin_plan_review(items :: List) :: String:
  plan_items_ui := items
  plan_result := "s"
  plan_waiting := #true
  plan_sema := rkt.#{make-semaphore}(0)
  dirty := #true
  wake()
  rkt.#{semaphore-wait}(plan_sema)
  plan_result

fun answer_plan(s :: String):
  when plan_waiting
  | plan_waiting := #false
    plan_result := s
    match plan_sema
    | #false: #void
    | sema: rkt.#{semaphore-post}(sema)
    dirty := #true
    wake()

fun set_activity(s):
  fun go():
    activity := s
    dirty := #true
    #void
  with_trans(go)
  wake()

// extension widgets: id -> text (may be multi-line), rendered above the
// status row; #false removes the widget
def mutable widgets :: Map = {}
fun set_widget(id :: String, text):
  fun go():
    widgets := (if text is_a String
                | widgets ++ { id: text }
                | widgets.remove(id))
    dirty := #true
    #void
  with_trans(go)
  wake()

// extension-owned suffix appended to the footer line
def mutable footer_extra :: String = ""
fun set_footer_extra(s :: String):
  fun go():
    footer_extra := s
    dirty := #true
    #void
  with_trans(go)
  wake()

// module-level debug log (enabled by RHO_TUI_DEBUG=/path in run_tui)
def mutable debug_port = #false
fun dlog(msg :: String):
  when debug_port
  | rkt.#{write-string}(msg +& "\n", debug_port)
    rkt.#{flush-output}(debug_port)

fun strip_ansi(s :: String) :: String:
  // remove \e[...m style sequences
  recur go(rest = s, acc = ""):
    let idx:
      for values(found = #false) (i in 0 .. rest.length()):
        found || (rest[i] == Char"\u001B" && i)
    cond
    | !idx: acc +& rest
    | ~else:
        let close:
          for values(found = #false) (j in idx + 1 .. rest.length()):
            found || ((rest[j] == Char"m") && j)
        if close
        | go(rest.substring(close + 1 ..), acc +& rest.substring(0 .. idx))
        | acc +& rest.substring(0 .. idx)

fun push(kind :: String, text :: String):
  dlog("push " +& kind +& " at " +& math.exact(math.round(rkt.#{current-inexact-milliseconds}())))
  fun go():
    for (l in strip_ansi(text).split("\n", ~trim: #false)):
      lines := lines.add([kind, to_string(l)])
    dirty := #true
    #void
  with_trans(go)
  wake()

// Keep a multi-line text as ONE transcript entry (kept newlines), so the
// renderer can fold it to its first line (tool output, Ctrl-O toggles).
fun push_block(kind :: String, text :: String):
  fun go():
    lines := lines.add([kind, strip_ansi(text)])
    dirty := #true
    #void
  with_trans(go)
  wake()

// Copy text to the system clipboard: OSC 52 escape (when the TUI is active)
// plus best-effort external clipboard tools.
fun copy_text(s :: String) :: Boolean:
  let osc = term.#{term-copy!}(s) == #true
  let tool_ok:
    try:
      let tmp = to_string(rktfile.#{make-temporary-file}("rho-clip-~a.txt"))
      filesystem.write_string(tmp, s, ~exists: #'truncate)
      let ok = rktsys.system("{ command -v wl-copy >/dev/null && wl-copy < " +& tmp
                               +& "; } || { command -v xclip >/dev/null && xclip -selection clipboard < "
                               +& tmp +& "; } || { command -v xsel >/dev/null && xsel -ib < "
                               +& tmp +& "; } 2>/dev/null")
      filesystem.delete(tmp)
      ok == #true
      ~catch _: #false
  osc || tool_ok

fun push_delta_kind(kind :: String, s :: String):
  dlog("delta " +& kind +& " " +& s.length() +& " at "
         +& math.exact(math.round(rkt.#{current-inexact-milliseconds}())))
  fun go():
    // switching streams (thinking -> text or back) finalizes the partial line
    when partial != "" && partial_kind != kind
    | lines := lines.add([partial_kind, strip_ansi(partial)])
      partial := ""
    partial_kind := kind
    partial := partial +& s
    recur split():
      let idx:
        for values(found = #false) (i in 0 .. partial.length()):
          found || (partial[i] == Char"\n" && i)
      when idx is_a Int
      | lines := lines.add([kind, strip_ansi(partial.substring(0 .. idx))])
        partial := partial.substring(idx + 1 ..)
        split()
    dirty := #true
    #void
  with_trans(go)
  wake()

fun push_delta(s :: String):
  push_delta_kind("assistant", s)

// streaming chain-of-thought: rendered dim, Ctrl-T hides/shows
fun push_think_delta(s :: String):
  push_delta_kind("think", s)

fun flush_partial_locked():
  cond
  | partial == "": #false
  | ~else:
      lines := lines.add([partial_kind, strip_ansi(partial)])
      partial := ""
      partial_kind := "assistant"
      dirty := #true
      #true

fun flush_partial():
  let woke = with_trans(flush_partial_locked)
  when woke | wake()

fun take_frame_locked() :: Map:
  dirty := #false
  { "lines": lines,
    "partial": partial,
    "partial_kind": partial_kind,
    "activity": activity,
    "widgets": widgets,
    "footer_extra": footer_extra,
    "header_extra": header_extra,
    "title_str": title_str,
    "spinner_frames_custom": spinner_frames_custom }

fun take_frame() :: Map:
  with_trans(take_frame_locked)

fun clear_activity():
  fun go():
    activity := #false
    dirty := #true
    #void
  with_trans(go)

// First character index at (or covering) display column col.
fun idx_at_col(text :: String, col :: Int) :: Int:
  recur go(i = 0, w = 0):
    cond
    | i >= text.length() || w >= col: i
    | ~else: go(i + 1, w + char_width(text[i]))

fun clamp(x, lo, hi):
  math.max(lo, math.min(x, hi))

// Return the original-string range for a case-insensitive match. We map the
// folded match back through prefix lengths because Unicode folds such as
// ß -> ss can expand one source character into multiple folded characters.
fun casefold_match_range(text :: String, query :: String):
  let folded_query = query.foldcase()
  let folded_text = text.foldcase()
  if folded_query == ""
  | #false
  | match folded_text.find(folded_query)
    | folded_start :: Int:
        let folded_end = folded_start + folded_query.length()
        fun source_start(i :: Int) :: Int:
          if i >= text.length()
          | text.length()
          | if text.substring(0 .. i + 1).foldcase().length() > folded_start
            | i
            | source_start(i + 1)
        fun source_end(i :: Int) :: Int:
          if i >= text.length()
          | text.length()
          | if text.substring(0 .. i + 1).foldcase().length() >= folded_end
            | i + 1
            | source_end(i + 1)
        [source_start(0), source_end(0)]
    | ~else: #false

// Highlight one case-insensitive search match while preserving the required
// row shape: a row is a list of spans, never a list containing a row.
fun highlight_search_row(row :: List, query :: String) :: List:
  let text:
    for values(acc = "") (sp in row):
      acc +& to_string(sp[3])
  match casefold_match_range(text, query)
  | [start, end]:
      for List:
        each sp in [[#false, #false, #false, text.substring(0 .. start)],
                    [#false, #false, "invert", text.substring(start .. end)],
                    [#false, #false, #false, text.substring(end ..)]]
        skip_when sp[3] == ""
        sp
  | ~else: row

// Search consumes a screen row only while its prompt is visible.
fun search_prompt_rows(active :: Boolean, query :: String, tcolor) :: List:
  if active
  | [[[tcolor("prompt"), #false, "bold", " search: " +& query +& "_"]]]
  | []

// Fit optional regions into the terminal while reserving the fixed status,
// separator, footer, editor, and at least one transcript row. Popup rows get
// first priority because they are interactive.
fun fit_tui_layout(rows :: Int,
                   editor_want :: Int,
                   header_want :: Int,
                   widget_want :: Int,
                   queue_want :: Int,
                   popup_want :: Int,
                   search_h :: Int,
                   ~ask_h: ask_h :: Int = 0,
                   ~pane_want: pane_want :: Int = 0) :: Map:
  let fixed_h = 3 + search_h + ask_h
  let editor_h = math.min(editor_want, math.max(0, rows - fixed_h - 1))
  def mutable budget = math.max(0, rows - fixed_h - editor_h - 1)
  let popup_h = math.min(popup_want, budget)
  budget := budget - popup_h
  let header_h = math.min(header_want, budget)
  budget := budget - header_h
  let pane_h = math.min(pane_want, budget)
  budget := budget - pane_h
  let queue_h = math.min(queue_want, budget)
  budget := budget - queue_h
  let widget_h = math.min(widget_want, budget)
  let trans_h = math.max(0, rows - fixed_h - editor_h - popup_h
                            - header_h - queue_h - widget_h - pane_h)
  { "editor": editor_h,
    "header": header_h,
    "widget": widget_h,
    "queue": queue_h,
    "popup": popup_h,
    "pane": pane_h,
    "transcript": trans_h }

def ASK_CARD_H = 3

fun clip_cols(s :: String, cols :: Int) :: String:
  if s.length() <= cols | s | s.substring(0 .. math.max(0, cols))

fun ask_detail(ask :: Map) :: String:
  let reason = to_string(ask.get("reason", "")).trim()
  cond
  | reason != "": reason
  | ~else:
      let input = ask.get("input", {})
      if input is_a Map
      | to_string(input.get("command",
                            input.get("path",
                                      input.get("old_string", ""))))
      | to_string(input)

fun ask_card_rows(ask :: Map, tcolor, cols :: Int) :: List:
  let name = to_string(ask.get("toolName", "tool"))
  [[[tcolor("prompt"), #false, "bold",
     clip_cols(" Allow " +& name +& "?", cols)]],
   [[tcolor("tool_result"), #false, #false,
     clip_cols("   " +& ask_detail(ask), cols)]],
   [[tcolor("prompt"), #false, #false,
     clip_cols("  [1] Allow    [2] Deny", cols)]]]

fun ask_card_hits(y0 :: Int) :: List:
  [make_hit(y0 + 2, 2, 12, "ask_allow", #false),
   make_hit(y0 + 2, 16, 26, "ask_deny", #false)]

// Click hit-rects: row is a screen row, [c0, c1) is a column range.
// Later hits on the same cell win (popup over transcript, etc.).
fun make_hit(row :: Int, c0 :: Int, c1 :: Int, id :: String, data) :: Map:
  { "row": row, "c0": c0, "c1": c1, "id": id, "data": data }

fun hit_at(hits :: List, row :: Int, col :: Int):
  for values(found = #false) (h in hits):
    if row == h["row"] && col >= h["c0"] && col < h["c1"] | h | found

fun list_find_index(xs :: List, target):
  recur loop(i = 0):
    cond
    | i >= xs.length(): #false
    | xs[i] == target: i
    | ~else: loop(i + 1)

fun list_prefix(xs :: List, n :: Int) :: List:
  for List (i in 0 .. math.min(n, xs.length())): xs[i]

fun list_dir_safe(dir :: String) :: List:
  if filesystem.directory_exists(dir)
  | for List (f in filesystem.files(dir).sort()): f +& ""
  | []

// recursive fuzzy candidates for @token (case-insensitive)
fun fuzzy_files(needle :: String) :: List:
  let needle = needle.foldcase()
  def mutable count = 0
  fun walk(dir :: String, prefix :: String) :: List:
    cond
    | count > 2000: []
    | ~else:
        for List:
          each f in list_dir_safe(dir)
          skip_when f == ".git" || f == "node_modules" || f == "compiled" || f == ".rho"
          each path in (block:
                          count := count + 1
                          let full = (if dir == "." | f | dir +& "/" +& f)
                          if filesystem.directory_exists(full)
                          | walk(full, "")
                          | [full])
          skip_when !path.foldcase().contains(needle)
          path
  walk(".", "")

fun common_prefix(strs :: List) :: String:
  match strs
  | []: ""
  | [first, & rest]:
      for values(acc = first) (s in rest):
        recur go(i = 0):
          cond
          | i >= acc.length() || i >= s.length() || acc[i] != s[i]:
              acc.substring(0 .. i)
          | ~else: go(i + 1)

// ---- the main TUI loop ----
fun run_tui(~theme: theme_in :: Map = {},
            ~banner: banner :: String = "",
            ~tui_mode: tui_mode_in :: String = "tui",
            ~handle_command: handle_command,
            ~handle_input: handle_input,
            ~footer: footer = fun (): "rho",
            ~cycle_model: cycle_model = fun (): "",
            ~cycle_thinking: cycle_thinking = fun (): "",
            ~shell_exec: shell_exec = fun (cmd): "(no shell handler)",
            ~tool_line: tool_line = fun (kind, text): #false,
            ~commands: commands = fun (): [],
            ~arg_complete: arg_complete = fun (cmd, prefix): #false,
            ~editor_cmd: editor_cmd = fun (): "",
            ~last_assistant: last_assistant = fun (): "",
            ~keybind: keybind = fun (action, default): default,
            ~shortcuts: shortcuts = fun (): {},
            ~markdown_transformers: md_transformers = fun (): [],
            ~theme_loader: theme_loader = fun (): theme_in,
            ~clicks: clicks = fun (): #false,
            ~pending_ask: pending_ask = fun (): #false,
            ~bind_ask: bind_ask = fun (w): #void,
            ~panes: panes_cb = fun (): #false,
            ~list_sessions: list_sessions = fun (): [],
            ~on_resume: on_resume = fun (p): #void,
            ~on_fork: on_fork = fun (): #void,
            ~dashboard_snap: dashboard_snap = fun (): "",
            ~settings_rows: settings_rows = fun (): [],
            ~model_rows: model_rows = fun (): [],
            ~current_model: current_model = fun (): "",
            ~theme_rows: theme_rows = fun (): [],
            ~current_theme_name: current_theme_name = fun (): "",
            ~help_text: help_text = fun (): "",
            ~extensions_rows: extensions_rows = fun (): { "mcp": [], "skills": [] }):
  def mutable current_theme = default_theme ++ theme_in
  def mutable last_theme_json = json.to_string(theme_in)
  fun tcolor(kind :: String):
    let c = current_theme.get(kind, "default")
    if c == "default" | #false | c
  // keybindings.json can remap these action names
  fun kb(action :: String, default :: String) :: String:
    to_string(keybind(action, default))

  // Apply registered markdown transformers to a text line, chaining them
  // left-to-right.  Each transformer takes and returns a string; failures
  // fall back to the previous value so a broken extension can't break the
  // render pipeline.
  fun apply_transformers(text :: String) :: String:
    recur go(t = text, rest = md_transformers()):
      match rest
      | []: t
      | [fn, & more]:
          let next = try:
                       let r = fn(t)
                       if r is_a String | r | t
                       ~catch _: t
          go(next, more)

  def mutable input_lines :: List = [""]

  // Reads an image from the system clipboard, returns a base64 attachment
  // map or #false.  Tries pngpaste (macOS), xclip / xclip2 (Linux), and
  // PowerShell (Windows / WSL).  Each attempt writes to a temp file which
  // we read and base64-encode.
  fun read_clipboard_image():
    let tmp = to_string(rktfile.#{make-temporary-file}("rho-clip-~a.png"))
    let script = "{ command -v pngpaste >/dev/null 2>&1 && pngpaste " +& tmp +& " 2>/dev/null; } "
      +& "|| { command -v xclip >/dev/null 2>&1 && xclip -selection clipboard -t image/png -o > " +& tmp +& " 2>/dev/null; } "
      +& "|| { command -v wl-paste >/dev/null 2>&1 && wl-paste -t image/png > " +& tmp +& " 2>/dev/null; } "
      +& "; test -s " +& tmp
    let ok = block:
               try:
                 rktsys.system(script)
                 ~catch _:
                   #false
    cond
    | !filesystem.file_exists(tmp): #false
    | ~else:
        let data = filesystem.read_bytes(tmp)
        try:
          filesystem.delete(tmp)
          ~catch _:
            #void
        if data.length() > 0
        | let b64 = Bytes.utf8_string(rkt64.#{base64-encode}(data, #""))
          { "media_type": "image/png",
            "data": b64,
            "name": "clipboard-" +& pending_image_count +& ".png" }
        | #false
  def mutable cur_line = 0
  def mutable cur_col = 0
  def mutable scroll = 0
  def mutable history :: List = []
  def mutable hist_idx = -1
  def mutable turn_thread = #false
  def mutable followups :: List = []
  def mutable running = #true
  def mutable spin_i = 0
  def mutable turn_started = 0
  def mutable last_size_poll = rkt.#{current-inexact-milliseconds}()
  def mutable last_trans_h = 20      // visible transcript height from last render
  def mutable last_trans_y = 0       // first transcript screen row
  def mutable last_hits :: List = [] // click regions from the last render
  def mutable focus :: String = "prompt"
  def mutable hover_hit = #false
  def mutable selected_block = #false
  def mutable expanded_tools :: Map = {}
  def mutable last_ed_y = 0
  def mutable last_pane_y = 0
  def mutable last_selected_kind :: String = ""
  def mutable ask_sema = #false
  def mutable ask_answer = "deny"
  def mutable ask_waiting = #false
  def mutable tools_expanded = #false  // Ctrl-O: expand tool output blocks
  def mutable thinking_shown = #true   // Ctrl-T: show/hide chain of thought
  def mutable fullscreen_mode = (tui_mode_in == "fullscreen")  // Alt-F toggles
  def mutable kill_ring :: List = []   // newest first
  def mutable kill_idx = 0
  def mutable last_was_kill = #false
  def mutable last_was_yank = #false
  def mutable yank_start = 0
  def mutable yank_line = 0
  def mutable yank_len = 0

  // mouse text selection (pi-style, app-owned since mouse reporting is on):
  // press anchors, drag extends (inverse-video highlight), release copies.
  // Coordinates are 0-based [screen_row, display_col] in the transcript area.
  def mutable sel_anchor = #false
  def mutable sel_focus = #false
  def mutable sel_dragged = #false
  def mutable visible_plain :: List = []  // plain text of rendered transcript rows

  // transcript search (Ctrl-S): query, matches, current index
  def mutable search_active = #false      // #false or search query being typed
  def mutable search_query :: String = ""
  def mutable search_matches :: List = []  // raw entry indices in transcript
  def mutable search_idx = 0              // current match (0-based)
  def mutable search_target = #false      // raw entry to reveal on next render

  fun norm_sel() :: List:
    let [ar, ac] = sel_anchor
    let [fr, fc] = sel_focus
    if fr < ar || (fr == ar && fc < ac)
    | [fr, fc, ar, ac]
    | [ar, ac, fr, fc]

  fun selection_text() :: String:
    if !(sel_anchor && sel_focus)
    | ""
    | let [r0, c0, r1, c1] = norm_sel()
      let parts:
        for List:
          each r in r0 .. r1 + 1
          skip_when r >= visible_plain.length()
          let t = to_string(visible_plain[r])
          let a = (if r == r0 | c0 | 0)
          let b = (if r == r1 | c1 + 1 | 999999)
          let i0 = math.min(idx_at_col(t, a), t.length())
          let i1 = math.min(idx_at_col(t, b), t.length())
          t.substring(i0 .. i1)
      String.join(parts, "\n")

  fun clear_selection():
    when sel_anchor
    | sel_anchor := #false
      sel_focus := #false
      sel_dragged := #false
      dirty := #true

  // autocomplete popup (pi-style): opens while typing /command or @file
  def mutable ac_open = #false
  def mutable ac_kind = #'slash            // #'slash | #'file | #'arg
  def mutable ac_items :: List = []        // [insert_text, label, description]
  def mutable ac_sel = 0
  def mutable ac_prefix = ""               // token being replaced

  when banner != ""
  | push("notify", banner)

  fun cur_text() :: String:
    to_string(input_lines[cur_line])

  fun set_cur(s :: String):
    input_lines := input_lines.set(cur_line, s)

  fun reset_input():
    input_lines := [""]
    cur_line := 0
    cur_col := 0

  fun fill_prompt(s :: String):
    input_lines := [s]
    cur_line := 0
    cur_col := s.length()
    focus := "prompt"
    dirty := #true

  fun insert(s :: String):
    let t = cur_text()
    set_cur(t.substring(0 .. cur_col) +& s +& t.substring(cur_col ..))
    cur_col := cur_col + s.length()
    dirty := #true

  fun kill_push(s :: String, ~append: append = #false):
    when s != ""
    | if append && kill_ring != []
      | kill_ring := kill_ring.set(0, to_string(kill_ring[0]) +& s)
      | kill_ring := [s] ++ kill_ring
        when kill_ring.length() > 32
        | kill_ring := (for List (i in 0 .. 32): kill_ring[i])
      last_was_kill := #true
      kill_idx := 0

  fun kill_line():
    let t = cur_text()
    cond
    | cur_col < t.length():
        let killed = t.substring(cur_col ..)
        set_cur(t.substring(0 .. cur_col))
        kill_push(killed, ~append: last_was_kill)
    | ~else: #void
    dirty := #true

  fun kill_word():
    let t = cur_text()
    when cur_col > 0
    | let i:
        recur go(j = cur_col):
          if j > 0 && t[j - 1] == Char" " | go(j - 1) | j
      let start:
        recur go(j = i):
          if j > 0 && t[j - 1] != Char" " | go(j - 1) | j
      let killed = t.substring(start .. cur_col)
      set_cur(t.substring(0 .. start) +& t.substring(cur_col ..))
      cur_col := start
      kill_push(killed, ~append: last_was_kill)
    dirty := #true

  fun yank():
    when kill_ring != []
    | kill_idx := 0
      yank_line := cur_line
      yank_start := cur_col
      let s = to_string(kill_ring[0])
      insert(s)
      yank_len := s.length()
      last_was_yank := #true

  fun yank_pop():
    when last_was_yank && kill_ring.length() > 1 && cur_line == yank_line
    | let t = cur_text()
      let end = yank_start + yank_len
      when yank_start >= 0 && end <= t.length()
      | kill_idx := (kill_idx + 1) mod kill_ring.length()
        let s = to_string(kill_ring[kill_idx])
        set_cur(t.substring(0 .. yank_start) +& s +& t.substring(end ..))
        yank_len := s.length()
        cur_col := yank_start + yank_len
        last_was_yank := #true
        dirty := #true

  fun insert_newline():
    let t = cur_text()
    let before = t.substring(0 .. cur_col)
    let after = t.substring(cur_col ..)
    input_lines := input_lines.set(cur_line, before).insert(cur_line + 1, after)
    cur_line := cur_line + 1
    cur_col := 0
    dirty := #true

  fun backspace():
    cond
    | cur_col > 0:
        let t = cur_text()
        set_cur(t.substring(0 .. cur_col - 1) +& t.substring(cur_col ..))
        cur_col := cur_col - 1
    | cur_line > 0:
        let prev = to_string(input_lines[cur_line - 1])
        let t = cur_text()
        input_lines := input_lines.set(cur_line - 1, prev +& t).delete(cur_line)
        cur_line := cur_line - 1
        cur_col := prev.length()
    | ~else: #void
    dirty := #true

  fun complete():
    // token before cursor: back to whitespace
    let t = cur_text()
    let start:
      recur go(i = cur_col):
        cond
        | i <= 0: 0
        | t[i - 1] == Char" ": i
        | ~else: go(i - 1)
    let token = t.substring(start .. cur_col)
    let is_at = token.starts_with("@")
    let raw = (if is_at | token.substring(1..) | token)
    let candidates:
      cond
      | is_at && !raw.contains("/"):
          fuzzy_files(raw)
      | ~else:
          let slash:
            for values(found = #false) (i in 0 .. raw.length()):
              if raw[i] == Char"/" | i | found
          let dir = (if slash is_a Int | raw.substring(0 .. slash + 1) | "")
          let base = (if slash is_a Int | raw.substring(slash + 1 ..) | raw)
          for List:
            each f in list_dir_safe(if dir == "" | "." | dir)
            skip_when !f.starts_with(base)
            dir +& f
    match candidates
    | []: push("notify", "(no completion for " +& token +& ")")
    | [only]:
        let full = (if is_at | "@" +& only | only)
        let suffix = (if filesystem.directory_exists(only) | "/" | " ")
        set_cur(t.substring(0 .. start) +& full +& suffix +& t.substring(cur_col ..))
        cur_col := start + full.length() + suffix.length()
    | many:
        let shown = (for List (i in 0 .. math.min(8, many.length())): many[i])
        push("notify", "candidates: " +& String.join(shown, "  ")
               +& (if many.length() > 8 | " \u2026" | ""))
        let cp = common_prefix(many)
        when cp.length() > raw.length()
        | let full = (if is_at | "@" +& cp | cp)
          set_cur(t.substring(0 .. start) +& full +& t.substring(cur_col ..))
          cur_col := start + full.length()
    dirty := #true

  fun close_ac():
    when ac_open
    | ac_open := #false
      dirty := #true

  fun open_ac(kind, prefix :: String, items :: List):
    ac_kind := kind
    ac_prefix := prefix
    ac_items := items
    ac_sel := 0
    ac_open := #true
    dirty := #true

  // recompute the popup from the text before the cursor
  fun update_ac():
    let t = cur_text()
    let before = t.substring(0 .. cur_col)
    cond
    | cur_line == 0 && before.starts_with("/") && !before.contains(" "):
        // slash command menu: prefix matches first, then substring matches
        let prefix = before.substring(1..)
        let pref_items:
          for List:
            each c in commands()
            let [name, desc] = c
            skip_when !name.starts_with(prefix)
            [name, name, desc]
        let sub_items:
          for List:
            each c in commands()
            let [name, desc] = c
            skip_when name.starts_with(prefix) || !name.contains(prefix)
            [name, name, desc]
        let items = pref_items ++ sub_items
        if items == [] | close_ac() | open_ac(#'slash, before, items)
    | cur_line == 0 && before.starts_with("/"):
        // argument completion for "/cmd <prefix>"
        let sp:
          for values(found = #false) (i in 0 .. before.length()):
            found || (before[i] == Char" " && i)
        let cmdname = before.substring(1 .. sp)
        let argprefix = before.substring(sp + 1 ..)
        match arg_complete(cmdname, argprefix)
        | l :: List:
            if l == [] | close_ac() | open_ac(#'arg, argprefix, l)
        | ~else: close_ac()
    | ~else:
        // @token fuzzy file search
        let start:
          recur go(i = cur_col):
            cond
            | i <= 0: 0
            | before[i - 1] == Char" ": i
            | ~else: go(i - 1)
        let token = before.substring(start ..)
        if token.starts_with("@") && token.length() >= 2
        | let cands = fuzzy_files(token.substring(1..))
          let items:
            for List (i in 0 .. math.min(20, cands.length())):
              let p = to_string(cands[i])
              ["@" +& p, p, ""]
          if items == [] | close_ac() | open_ac(#'file, token, items)
        | close_ac()

  fun apply_ac():
    when ac_open && ac_items != []
    | let [ins, _label, _desc] = ac_items[ac_sel]
      let ins = to_string(ins)
      let t = cur_text()
      match ac_kind
      | #'slash:
          set_cur("/" +& ins +& " " +& t.substring(cur_col ..))
          cur_col := ins.length() + 2
      | #'file:
          let start = cur_col - ac_prefix.length()
          let suffix = (if ins.ends_with("/") | "" | " ")
          set_cur(t.substring(0 .. start) +& ins +& suffix +& t.substring(cur_col ..))
          cur_col := start + ins.length() + suffix.length()
      | ~else:
          let start = cur_col - ac_prefix.length()
          set_cur(t.substring(0 .. start) +& ins +& t.substring(cur_col ..))
          cur_col := start + ins.length()
    close_ac()
    dirty := #true

  fun click_fn(id :: String):
    match clicks()
    | mm :: MutableMap: mm.get(id, #false)
    | m :: Map: m.get(id, #false)
    | ~else: #false

  fun wait_ask():
    ask_sema := rkt.#{make-semaphore}(0)
    ask_answer := "deny"
    ask_waiting := #true
    dirty := #true
    wake()
    rkt.#{semaphore-wait}(ask_sema)
    ask_answer

  fun answer_ask(decision :: String):
    when ask_waiting
    | ask_waiting := #false
      ask_answer := decision
      match ask_sema
      | #false: #void
      | sema: rkt.#{semaphore-post}(sema)
      dirty := #true
      wake()

  fun handle_ask_key(k :: String) :: Boolean:
    match pending_ask()
    | ask :: Map:
        cond
        | k == "1" || k == "y" || k == "Y" || k == "C-M":
            answer_ask("allow")
            #true
        | k == "2" || k == "n" || k == "N" || k == "<escape>" || k == "C-[":
            answer_ask("deny")
            #true
        | k == "C-C":
            answer_ask("deny")
            interrupt_turn()
            #true
        | ~else: #true
    | ~else: #false

  fun dispatch_hit(h :: Map, col :: Int):
    let id = to_string(h.get("id", ""))
    let foc = pager.focus_for_hit(id)
    when foc != ""
    | focus := foc
    cond
    | id == "ask_allow": answer_ask("allow")
    | id == "ask_deny": answer_ask("deny")
    | id == "question_opt":
        match h.get("data", #false)
        | i :: Int:
            let opts = q_options.add(pager.OTHER_OPTION)
            when i >= 0 && i < opts.length()
            | let choice = to_string(opts[i])
              if choice == pager.OTHER_OPTION
              | focus := "prompt"
                answer_question(pager.OTHER_OPTION)
              | answer_question(choice)
        | ~else: #void
    | id == "plan_approve":
        if plan_waiting
        | answer_plan("a")
        | block:
            close_overlay()
            handle_command("plan", "approve")
    | id == "plan_stay":
        if plan_waiting | answer_plan("s") | close_overlay()
    | id == "plan_quit":
        if plan_waiting
        | answer_plan("q")
        | block:
            close_overlay()
            handle_command("plan", "off")
    | id == "palette_pick":
        let items = pager.palette_filter(commands(), page_query)
        match h.get("data", #false)
        | i :: Int:
            when i >= 0 && i < items.length()
            | let name = to_string(if items[i] is_a List | items[i][0] | items[i])
              close_page()
              handle_command(name, "")
        | ~else: #void
    | id == "resume_pick":
        let ss = list_sessions()
        match h.get("data", #false)
        | i :: Int:
            when i >= 0 && i < ss.length()
            | let s = ss[i]
              let path:
                cond
                | s is_a Map: to_string(s.get("path", ""))
                | s is_a List: to_string(s[0])
                | ~else: to_string(s)
              close_page()
              when path != "" | on_resume(path)
        | ~else: #void
    | id == "chip_model":
        open_page("models")
    | id == "model_pick":
        let name = to_string(h.get("name", ""))
        match h.get("data", #false)
        | i :: Int:
            page_sel := i
            activate_page()
        | ~else:
            when name != ""
            | close_page()
              handle_command("model", name)
    | id == "theme_pick":
        match h.get("data", #false)
        | i :: Int:
            page_sel := i
            activate_page()
        | ~else: #void
    | id == "ext_skill":
        match h.get("data", #false)
        | i :: Int:
            page_sel := i
            activate_page()
        | ~else: #void
    | id == "ext_tabs":
        page_data := (if to_string(page_data || "mcp") == "skills" | "mcp" | "skills")
        page_sel := 0
        dirty := #true
    | id == "tasks_open":
        toggle_pane("tasks")
    | id == "todo_toggle":
        match pane_spec("todos")
        | spec :: Map:
            match spec.get("on_click", #false)
            | fn :: Function: fn(h.get("data", #false))
            | ~else: #void
        | ~else: #void
    | id == "task_open":
        match pane_spec("tasks")
        | spec :: Map:
            match spec.get("on_click", #false)
            | fn :: Function: fn(h.get("data", #false))
            | ~else: #void
        | ~else:
            open_page("dashboard")
    | id == "queue_row":
        match h.get("data", #false)
        | i :: Int:
            when i >= 0 && i < followups.length()
            | // click left = edit, rightish = cancel; default send
              cond
              | col > 50:
                  followups := for List (j in 0 .. followups.length()):
                                 skip_when j == i
                                 followups[j]
              | col > 40:
                  let text = to_string(followups[i])
                  followups := for List (j in 0 .. followups.length()):
                                 skip_when j == i
                                 followups[j]
                  start_turn(text)
              | ~else:
                  input_lines := [to_string(followups[i])]
                  followups := for List (j in 0 .. followups.length()):
                                 skip_when j == i
                                 followups[j]
                  cur_line := 0
                  cur_col := cur_text().length()
                  focus := "prompt"
              dirty := #true
        | ~else: #void
    | id == "dash_resume":
        open_page("resume")
    | id == "dash_open":
        handle_command("session", "")
    | id == "settings_row":
        match h.get("data", #false)
        | i :: Int:
            page_sel := i
            activate_page()
        | ~else: #void
    | id == "stop": interrupt_turn()
    | id == "entry":
        selected_block := h.get("data", #false)
        focus := "scrollback"
        dirty := #true
    | id == "scrollback":
        focus := "scrollback"
        dirty := #true
    | id == "tool_fold":
        match h.get("data", #false)
        | bid :: Int:
            expanded_tools := (if expanded_tools.has_key(bid)
                               | expanded_tools.remove(bid)
                               | expanded_tools ++ { bid: #true })
            dirty := #true
        | ~else:
            tools_expanded := !tools_expanded
            dirty := #true
    | id == "ac_pick":
        match h.get("data", #false)
        | i :: Int:
            when i >= 0 && i < ac_items.length()
            | ac_sel := i
              apply_ac()
        | ~else: #void
    | id == "editor":
        match h.get("data", #false)
        | line :: Int:
            when line >= 0 && line < input_lines.length()
            | cur_line := line
              cur_col := clamp(idx_at_col(cur_text(), math.max(0, col - 2)),
                               0, cur_text().length())
              dirty := #true
        | ~else: #void
    | ~else:
        match click_fn(id)
        | #false:
            when id == "footer"
            | let msg = cycle_model()
              when msg != "" | push("notify", msg)
        | fn: fn(h.get("data", {}))

  fun interrupt_turn():
    when turn_thread
    | rkt.#{break-thread}(turn_thread)
      rkt.#{thread-wait}(turn_thread)
      turn_thread := #false
      clear_activity()
      flush_partial()
      push("notify", "[turn interrupted]")
      // pi behavior: interrupted queue returns to the editor for re-editing
      when followups != [] && String.join(input_lines, "") == ""
      | input_lines := (for List (f in followups): to_string(f))
        cur_line := input_lines.length() - 1
        cur_col := cur_text().length()
        followups := []
        push("notify", "[queued follow-ups restored to editor]")

  // Ctrl-G: edit the current input in an external editor
  fun external_edit():
    let cmd = to_string(editor_cmd())
    cond
    | cmd == "":
        push("notify", "[no editor: set external_editor in /settings or $EDITOR]")
    | ~else:
        let tmp = to_string(rktfile.#{make-temporary-file}("rho-edit-~a.txt"))
        filesystem.write_string(tmp, String.join(input_lines, "\n"),
                                ~exists: #'truncate)
        term.#{term-suspend!}()
        try:
          rktsys.system(cmd +& " " +& tmp)
          ~catch _: #void
        term.#{term-resume!}()
        let content = filesystem.read_string(tmp)
        filesystem.delete(tmp)
        let ls:
          for List (l in content.split("\n", ~trim: #false)):
            to_string(l)
        // drop a trailing empty line from the editor's final newline
        let ls:
          if ls.length() > 1 && ls[ls.length() - 1] == ""
          | ls.delete(ls.length() - 1)
          | ls
        input_lines := (if ls == [] | [""] | ls)
        cur_line := input_lines.length() - 1
        cur_col := cur_text().length()
        dirty := #true

  // Ctrl-X: copy the last assistant message
  fun do_copy():
    let text = to_string(last_assistant())
    if text == ""
    | push("notify", "[nothing to copy]")
    | copy_text(text)
      push("notify", "[copied last assistant message ("
             +& text.length() +& " chars)]")

  // Alt-Enter: queue the current input as a follow-up (runs after this turn)
  fun queue_followup():
    let text = String.join(input_lines, "\n").trim()
    cond
    | text == "": #void
    | !turn_thread:
        // nothing running: behave like submit
        submit()
    | ~else:
        followups := followups.add(text)
        history := history.add(text)
        reset_input()
        active_pane := "queue"
        dirty := #true

  fun start_turn(input :: String):
    set_activity("thinking")
    turn_started := rkt.#{current-inexact-milliseconds}()
    let t = rkt.thread(fun ():
                         try:
                           handle_input(input)
                           ~catch:
                           | e :: Exn.Break: push("notify", "[interrupted]")
                           | e :: Exn.Fail: push("error", "error: " +& e.message))
    turn_thread := t

  fun submit():
    let text = String.join(input_lines, "\n").trim()
    reset_input()
    dirty := #true
    scroll := 0
    when text != ""
    | history := history.add(text)
      hist_idx := -1
      cond
      | turn_thread:
          cond
          | text.starts_with("/follow"):
              let msg = text.substring(7..).trim()
              if msg == ""
              | push("notify", "[usage: /follow <message>]")
              | followups := followups.add(msg)
                push("notify", "[follow-up queued]")
          | text.starts_with("/"):
              push("notify", "[commands can't run during a turn; plain text steers]")
          | ~else:
              rkt.#{thread-send}(turn_thread, text)
              push("steer", "\u21AA steering: " +& text)
      | text == "/quit" || text == "/exit":
          running := #false
      | text.starts_with("/follow"):
          let msg = text.substring(7..).trim()
          when msg != ""
          | push("user", "\u276F " +& msg)
            start_turn(msg)
      | text.starts_with("/"):
          push("user", "\u276F " +& text)
          let parts = text.substring(1..).split(" ")
          let name = (if parts == [] | "" | to_string(parts[0]))
          let args = (if parts.length() > 1 | String.join(parts.rest, " ") | "")
          let r = try:
                    handle_command(name, args)
                    ~catch e :: Exn.Fail:
                      push("error", "error: " +& e.message)
                      #void
          when r == #'quit
          | running := #false
      | text.starts_with("!"):
          push("user", "\u276F " +& text)
          let cmd = text
          rkt.thread(fun ():
                       let r = try:
                                 shell_exec(cmd)
                                 ~catch e :: Exn.Fail: "error: " +& e.message
                       push("shell", to_string(r)))
      | ~else:
          push("user", "\u276F " +& text)
          start_turn(text)

  fun handle_key(k :: String):
    if handle_ask_key(k)
    | #void
    | handle_key_rest(k)

  fun handle_key_rest(k :: String):
    cond
    | ac_open && k == "<up>":
        ac_sel := (if ac_sel == 0 | ac_items.length() - 1 | ac_sel - 1)
        dirty := #true
    | ac_open && k == "<down>":
        ac_sel := (if ac_sel >= ac_items.length() - 1 | 0 | ac_sel + 1)
        dirty := #true
    | ac_open && k == "C-I":
        apply_ac()
        update_ac()  // completing "/model " immediately shows its argument menu
    | ac_open && k == "C-M":
        // Enter picks the highlighted item. For a slash command with argument
        // completions (e.g. /model), open the argument menu so the user can
        // keep selecting; otherwise submit right away (pi behavior).
        let kind = ac_kind
        apply_ac()
        match kind
        | #'slash:
            update_ac()
            when !ac_open | submit()
        | #'arg: submit()
        | ~else: #void
    | ac_open && (k == "<escape>" || k == "C-["):
        close_ac()
    | ~else:
        handle_key_core(k)
        // editing keys re-filter the popup; anything else closes it
        if k.length() == 1 || k == "<backspace>" || k == "C-H"
             || k == "<delete>" || k == "C-U" || k == "C-K" || k == "C-W"
             || k == "C-Y" || k == "M-Y" || k == "M-y"
        | update_ac()
        | close_ac()

  fun handle_search_key(k :: String) :: Boolean:
    // returns #true if the key was consumed by search mode
    if !search_active
    | #false
    | cond
      | k == "<escape>" || k == "C-[":
          search_active := #false
          search_query := ""
          dirty := #true
          #true
      | k == "C-M":
          // perform search
          let q = search_query.foldcase()
          when q != ""
          | search_matches := (for List (i in 0 .. lines.length()):
                                 let [kind, raw_text] = lines[i]
                                 let shown = to_string(tool_line(kind, raw_text) || raw_text)
                                 let searchable:
                                   cond
                                   | kind == "think" && !thinking_shown: ""
                                   | kind == "tool_result" && !tools_expanded:
                                       to_string(shown.split("\n", ~trim: #false)[0])
                                   | ~else: shown
                                 skip_when !searchable.foldcase().contains(q)
                                 i)
            search_idx := 0
            when search_matches != []
            | search_target := search_matches[0]
              push("notify", "[" +& (search_idx + 1) +& "/" +& search_matches.length() +& " matches]")
          search_active := #false
          dirty := #true
          #true
      | k == "<backspace>" || k == "C-H" || k == "C-?":
          when search_query.length() > 0
          | search_query := search_query.substring(0 .. search_query.length() - 1)
          dirty := #true
          #true
      | k.length() == 1:
          search_query := search_query +& k
          dirty := #true
          #true
      | ~else: #true

  fun handle_key_core(k :: String):
    // search mode intercepts all keys until Enter / Esc / Backspace
    if handle_search_key(k)
    | #void
    | handle_key_main(k)

  fun pane_table():
    match panes_cb()
    | mm :: MutableMap: mm
    | m :: Map: m
    | ~else: {}

  fun pane_spec(id):
    let tab = pane_table()
    cond
    | tab is_a MutableMap: tab.get(id, #false)
    | tab is_a Map: tab.get(id, #false)
    | ~else: #false

  fun page_items() :: List:
    cond
    | page_kind == "dashboard":
        pager.dashboard_page_items(to_string(dashboard_snap()))
    | page_kind == "settings":
        pager.settings_page_items(settings_rows(), page_drafts)
    | page_kind == "models":
        pager.model_page_items(model_rows(), page_query, to_string(current_model()))
    | page_kind == "theme":
        pager.theme_page_items(theme_rows(), to_string(current_theme_name()))
    | page_kind == "help":
        pager.help_page_items(to_string(help_text()))
    | page_kind == "extensions":
        let snap = extensions_rows()
        let mcp = if snap is_a Map | snap.get("mcp", []) | []
        let sk = if snap is_a Map | snap.get("skills", []) | []
        pager.extensions_page_items(to_string(page_data || "mcp"), mcp, sk)
    | page_kind == "resume":
        pager.resume_page_items(list_sessions())
    | page_kind == "palette":
        pager.palette_page_items(commands(), page_query)
    | page_kind == "frame":
        pager.frame_page_items(to_string(page_data || "(empty)"))
    | ~else:
        match page_data
        | s :: String: pager.dashboard_page_items(s)
        | ~else: []

  fun page_title() :: String:
    cond
    | page_kind == "dashboard": "rho · Dashboard"
    | page_kind == "settings": "rho · Settings"
    | page_kind == "models":
        if page_query == ""
        | "rho · Models"
        | "rho · Models  [" +& page_query +& "]"
    | page_kind == "theme": "rho · Theme"
    | page_kind == "help": "rho · Shortcuts"
    | page_kind == "extensions": "rho · Extensions"
    | page_kind == "resume": "rho · Resume"
    | page_kind == "palette":
        if page_query == ""
        | "rho · Commands"
        | "rho · Commands  [" +& page_query +& "]"
    | page_kind == "frame": "rho · Sub-agent"
    | page_kind is_a String: "rho · " +& to_string(page_kind)
    | ~else: "rho"

  fun page_hints() :: String:
    cond
    | page_kind == "settings":
        "↑↓ select · ←→ flip · Enter edit/save · Esc close"
    | page_kind == "models":
        "type to filter · Enter switch · Esc close"
    | page_kind == "theme":
        "↑↓ select · Enter apply · Esc close"
    | page_kind == "help":
        "↑↓ scroll · Esc close"
    | page_kind == "extensions":
        "Tab switch · Enter open · r reload · s stop · Esc close"
    | page_kind == "dashboard":
        "↑↓ select · Enter open · Esc close"
    | page_kind == "palette":
        "type to filter · Enter run · Esc close"
    | page_kind == "resume":
        "↑↓ select · Enter open · Esc close"
    | ~else: "Esc close"

  fun selected_page_item():
    let items = page_items()
    if items == [] || page_sel < 0 || page_sel >= items.length()
    | #false
    | items[page_sel]

  fun activate_page():
    let item = selected_page_item()
    if !(item is_a Map)
    | #void
    | let id = to_string(item.get("id", ""))
      cond
      | id == "dash_resume":
          open_page("resume")
      | id == "dash_open":
          handle_command("session", "")
      | id == "palette_pick":
          let name = to_string(item.get("name", ""))
          close_page()
          when name != "" | handle_command(name, "")
      | id == "resume_pick":
          let ss = list_sessions()
          match item.get("data", #false)
          | i :: Int:
              when i >= 0 && i < ss.length()
              | let path:
                  let s = ss[i]
                  cond
                  | s is_a Map: to_string(s.get("path", ""))
                  | s is_a List: to_string(s[0])
                  | ~else: to_string(s)
                close_page()
                when path != "" | on_resume(path)
          | ~else: #void
      | id == "settings_row":
          let key = to_string(item.get("key", ""))
          let kind = item.get("kind", "string")
          let shown = to_string(item.get("value", ""))
          cond
          | key == "": #void
          | key == "theme":
              open_page("theme")
          | key == "default_model":
              open_page("models")
          | kind == "bool" || kind is_a List:
              handle_command("settings", key +& " " +& shown)
              page_drafts := page_drafts.remove(key)
              dirty := #true
          | ~else:
              fill_prompt("/settings " +& key +& " ")
              close_page()
      | id == "model_pick":
          let name = to_string(item.get("name", ""))
          close_page()
          when name != "" | handle_command("model", name)
      | id == "theme_pick":
          let name = to_string(item.get("name", ""))
          close_page()
          handle_command("theme", (if name == "" | "default" | name))
      | id == "ext_skill":
          let name = to_string(item.get("name", ""))
          when name != ""
          | close_page()
            handle_command("skill:" +& name, "")
      | ~else: #void

  fun flip_selected_setting(dir :: Int):
    let item = selected_page_item()
    if !(item is_a Map)
    | #void
    | let key = to_string(item.get("key", ""))
      let kind = item.get("kind", "string")
      when key != "" && (kind == "bool" || kind is_a List)
      | let cur = to_string(item.get("value", ""))
        page_drafts := page_drafts ++ { key: pager.next_setting_value(kind, cur, dir) }
        dirty := #true

  fun page_row_skip(id :: String) :: Boolean:
    id == "settings_header" || id == "ext_tabs"

  fun page_move(dir :: Int):
    let items = page_items()
    let n = items.length()
    recur go(i = page_sel + dir):
      cond
      | i < 0 || i >= n:
          dirty := #true
      | page_row_skip(to_string(items[i].get("id", ""))):
          go(i + dir)
      | ~else:
          page_sel := i
          dirty := #true

  fun handle_page_key(k :: String) :: Boolean:
    if page_kind == #false
    | #false
    | cond
      | k == "<escape>" || k == "C-[":
          close_page()
          #true
      | k == "<up>":
          page_move(-1)
          #true
      | k == "<down>":
          page_move(1)
          #true
      | k == "<left>":
          flip_selected_setting(-1)
          #true
      | k == "<right>":
          flip_selected_setting(1)
          #true
      | k == "C-M":
          activate_page()
          #true
      | page_kind == "extensions" && (k == "C-I" || k == "<tab>"):
          page_data := (if to_string(page_data || "mcp") == "skills" | "mcp" | "skills")
          page_sel := 0
          dirty := #true
          #true
      | page_kind == "extensions" && to_string(page_data || "mcp") != "skills"
          && (k == "r" || k == "R"):
          handle_command("mcp", "reload")
          dirty := #true
          #true
      | page_kind == "extensions" && to_string(page_data || "mcp") != "skills"
          && (k == "s" || k == "S"):
          handle_command("mcp", "stop")
          dirty := #true
          #true
      | (page_kind == "palette" || page_kind == "models")
          && (k == "<backspace>" || k == "C-H"):
          when page_query.length() > 0
          | page_query := page_query.substring(0 .. page_query.length() - 1)
            page_sel := 0
          dirty := #true
          #true
      | (page_kind == "palette" || page_kind == "models") && k.length() == 1:
          page_query := page_query +& k
          page_sel := 0
          dirty := #true
          #true
      | k == "C-C" || k == "C-D" || k == "C-L"
          || k == "C-\\" || k == "C-\\\\"
          || k == "C-."
          || k == "<f2>" || k == "F2" || k == "<F2>":
          #false
      | ~else: #true

  fun render_page(rows :: Int, cols :: Int):
    let items = page_items()
    let n = items.length()
    when page_sel >= n
    | page_sel := math.max(0, n - 1)
    when n > 0 && page_sel < n
         && page_row_skip(to_string(items[page_sel].get("id", "")))
    | page_move(1)
    let body_h = math.max(0, rows - 2)
    let frame = pager.page_frame(~title: page_title(),
                                 ~body: items,
                                 ~hints: page_hints(),
                                 ~rows: rows,
                                 ~cols: cols,
                                 ~sel: page_sel)
    last_hits := pager.page_hits(items, page_sel, cols, ~body_h: body_h)
    last_trans_y := -1
    last_trans_h := 0
    last_ed_y := rows
    term.#{term-draw!}(frame, #false)

  fun handle_overlay_key(k :: String) :: Boolean:
    cond
    | overlay_kind == #false: #false
    | k == "<escape>" || k == "C-[":
        close_overlay()
        #true
    | overlay_kind == "plan_pending":
        cond
        | k == "a" || k == "A":
            close_overlay()
            handle_command("plan", "approve")
            #true
        | k == "s" || k == "S":
            close_overlay()
            #true
        | k == "q" || k == "Q":
            close_overlay()
            handle_command("plan", "off")
            #true
        | ~else: #true
    | ~else: #true

  fun handle_question_key(k :: String) :: Boolean:
    if !q_waiting
    | #false
    | cond
      | k == "<escape>" || k == "C-[":
          answer_question("error: cancelled")
          #true
      | k == "z" || k == "Z":
          answer_question(pager.OTHER_OPTION)
          #true
      | ~else:
          match String.maybe_to_int(k)
          | n :: Int:
              when n >= 1 && n <= q_options.length()
              | answer_question(to_string(q_options[n - 1]))
              #true
          | ~else: #true

  fun handle_plan_key(k :: String) :: Boolean:
    if !plan_waiting
    | #false
    | cond
      | k == "a" || k == "A":
          answer_plan("a")
          #true
      | k == "s" || k == "S":
          answer_plan("s")
          #true
      | k == "q" || k == "Q" || k == "<escape>" || k == "C-[":
          answer_plan("q")
          #true
      | ~else: #true

  fun handle_scrollback_key(k :: String) :: Boolean:
    if focus != "scrollback"
    | #false
    | cond
      | k == "C-I":
          focus := "prompt"
          dirty := #true
          #true
      | k == "<up>":
          selected_block := (if selected_block is_a Int
                             | math.max(0, selected_block - 1)
                             | 0)
          dirty := #true
          #true
      | k == "<down>":
          selected_block := (if selected_block is_a Int
                             | selected_block + 1
                             | 0)
          dirty := #true
          #true
      | k == "y" || k == "Y":
          do_copy()
          #true
      | k == "C-M":
          cond
          | last_selected_kind == "user":
              on_fork()
              #true
          | last_selected_kind == "tool_result" && selected_block is_a Int:
              expanded_tools := (if expanded_tools.has_key(selected_block)
                                 | expanded_tools.remove(selected_block)
                                 | expanded_tools ++ { selected_block: #true })
              dirty := #true
              #true
          | ~else: #true
      | k.length() == 1:
          focus := "prompt"
          insert(k)
          #true
      | ~else: #false

  fun handle_key_main(k :: String):
    if handle_page_key(k) || handle_overlay_key(k) || handle_question_key(k)
       || handle_plan_key(k) || handle_scrollback_key(k)
    | #void
    | handle_key_chrome(k)

  fun handle_key_chrome(k :: String):
    let killish = k == "C-K" || k == "C-W" || k == "C-U"
                    || k == kb("kill_line", "C-K") || k == kb("kill_word", "C-W")
    let yankish = k == "C-Y" || k == "M-Y" || k == "M-y"
                    || k == kb("yank", "C-Y") || k == kb("yank_pop", "M-Y")
    when !killish
    | last_was_kill := #false
    when !yankish
    | last_was_yank := #false
    let shortcut:
      let table = shortcuts()
      if table is_a Map | table.get(k, #false) | #false
    cond
    | shortcut is_a Map:
        match shortcut.get("fn", #false)
        | fn :: Function:
            try:
              fn()
              ~catch e :: Exn.Fail:
                push("error", "shortcut " +& k +& ": " +& e.message)
            dirty := #true
        | ~else: #void
    | k == "C-S":
        search_active := #true
        search_query := ""
        dirty := #true
    | k == "C-N" && search_matches != []:
        search_idx := (search_idx + 1) mod search_matches.length()
        search_target := search_matches[search_idx]
        push("notify", "[" +& (search_idx + 1) +& "/" +& search_matches.length() +& " matches]")
        dirty := #true
    | k == "C-P" && search_matches != []:
        search_idx := (search_idx - 1) mod search_matches.length()
        search_target := search_matches[search_idx]
        push("notify", "[" +& (search_idx + 1) +& "/" +& search_matches.length() +& " matches]")
        dirty := #true
    | k == "C-M": submit()
    | k == "M-C-M" || k == "M-<return>" || k == kb("queue_followup", "M-C-M"):
        queue_followup()
    | k == "C-J": insert_newline()
    | k == "C-T":
        if pane_spec("todos")
        | toggle_pane("todos")
        | block:
            thinking_shown := !thinking_shown
            push("notify", (if thinking_shown
                            | "[thinking shown]"
                            | "[thinking hidden]"))
    | k == "C-G":
        if pane_spec("tasks")
        | toggle_pane("tasks")
        | external_edit()
    | k == kb("external_editor", "M-E"): external_edit()
    | k == kb("copy_last", "C-X"): do_copy()
    | k == kb("toggle_tool_output", "C-O"):
        tools_expanded := !tools_expanded
        push("notify", (if tools_expanded
                        | "[tool output expanded]"
                        | "[tool output collapsed]"))
    | k == kb("toggle_thinking", "C-E") || k == "C-E":
        thinking_shown := !thinking_shown
        push("notify", (if thinking_shown
                        | "[thinking shown]"
                        | "[thinking hidden]"))
    | k == "<f2>" || k == "F2" || k == "<F2>":
        if page_kind == "settings"
        | close_page()
        | open_page("settings")
    | k == "C-\\" || k == "C-\\\\":
        if page_kind == "dashboard"
        | close_page()
        | handle_command("dashboard", "")
    | k == "C-.":
        if page_kind == "help"
        | close_page()
        | open_page("help")
    | k == "?":
        if page_kind == "palette"
        | close_page()
        | open_page("palette")
    | k == "C-;":
        toggle_pane("queue")
    | k == "C-S-I" || k == "S-<tab>" || k == kb("cycle_thinking", "M-T"):
        let msg = to_string(cycle_thinking())
        when msg != "" | push("notify", msg)
    | k == "C-I": complete()
    | k == "<backspace>" || k == "C-H": backspace()
    | k == "<delete>":
        let t = cur_text()
        when cur_col < t.length()
        | set_cur(t.substring(0 .. cur_col) +& t.substring(cur_col + 1 ..))
          dirty := #true
    | k == "<left>":
        cur_col := clamp(cur_col - 1, 0, cur_text().length())
        dirty := #true
    | k == "<right>":
        cur_col := clamp(cur_col + 1, 0, cur_text().length())
        dirty := #true
    | k == "<home>" || k == "C-A":
        cur_col := 0
        dirty := #true
    | k == "<end>" || k == "C-E":
        cur_col := cur_text().length()
        dirty := #true
    | k == "<up>":
        cond
        | input_lines.length() > 1 && cur_line > 0:
            cur_line := cur_line - 1
            cur_col := math.min(cur_col, cur_text().length())
        | history != []:
            hist_idx := (if hist_idx == -1 | history.length() - 1 | math.max(0, hist_idx - 1))
            input_lines := [to_string(history[hist_idx])]
            cur_line := 0
            cur_col := cur_text().length()
        | ~else: #void
        dirty := #true
    | k == "<down>":
        cond
        | input_lines.length() > 1 && cur_line < input_lines.length() - 1:
            cur_line := cur_line + 1
            cur_col := math.min(cur_col, cur_text().length())
        | hist_idx != -1:
            if hist_idx < history.length() - 1
            | hist_idx := hist_idx + 1
              input_lines := [to_string(history[hist_idx])]
            | hist_idx := -1
              input_lines := [""]
            cur_line := 0
            cur_col := cur_text().length()
        | ~else: #void
        dirty := #true
    | k == "<page-up>":
        scroll := scroll + math.max(3, last_trans_h - 2)
        dirty := #true
    | k == "<page-down>":
        scroll := math.max(0, scroll - math.max(3, last_trans_h - 2))
        dirty := #true
    | k == "C-C":
        cond
        | turn_thread: interrupt_turn()
        | String.join(input_lines, "") != "": reset_input()
                                              dirty := #true
        | ~else: running := #false
    | k == "<escape>" || k == "C-[": interrupt_turn()
    | k == "C-P":
        let msg = cycle_model()
        when msg != "" | push("notify", msg)
    | k == "C-V" || k == "M-V" || k == "M-v":
        // Paste an image from the clipboard (pi-style).
        match read_clipboard_image()
        | img :: Map:
            pending_images := pending_images.add(img)
            insert("[image: " +& img["name"] +& "]")
            pending_image_count := pending_image_count + 1
            push("notify", "[pasted image " +& img["data"].length() +& " base64 chars]")
            dirty := #true
        | ~else:
            push("notify", "[no image in clipboard]")
    | k == "C-L": dirty := #true
    | k == "M-F" || k == "M-f":
        fullscreen_mode := !fullscreen_mode
        push("notify", (if fullscreen_mode
                        | "[fullscreen scroll on]"
                        | "[fullscreen scroll off]"))
        dirty := #true
    | k == "C-D":
        when String.join(input_lines, "") == ""
        | running := #false
    | k == "C-U":
        let t = cur_text()
        when t != ""
        | kill_push(t, ~append: last_was_kill)
        set_cur("")
        cur_col := 0
        dirty := #true
    | k == kb("kill_line", "C-K") || k == "C-K": kill_line()
    | k == kb("kill_word", "C-W") || k == "C-W": kill_word()
    | k == kb("yank", "C-Y") || k == "C-Y": yank()
    | k == kb("yank_pop", "M-Y") || k == "M-Y" || k == "M-y": yank_pop()
    | k.length() == 1: insert(k)
    | ~else: #void

  fun render():
    // Snapshot under the lock and clear dirty first: background threads may
    // push during the draw, and their dirty-mark must survive so the next
    // loop iteration repaints.
    let frame = take_frame()
    let lines = frame["lines"]
    let partial = frame["partial"]
    let partial_kind = frame["partial_kind"]
    let activity = frame["activity"]
    let widgets = frame["widgets"]
    let footer_extra = frame["footer_extra"]
    let header_extra = to_string(frame["header_extra"])
    let title_str = to_string(frame["title_str"])
    let spinner_frames_custom = frame["spinner_frames_custom"]
    let rows = term.#{term-rows}()
    let cols = term.#{term-cols}()
    let input_h_want = math.min(input_lines.length(), 8)
    let popup_h_want = (if ac_open && ac_items != [] | math.min(5, ac_items.length()) | 0)
    let queue_h_want = 0
    fun ext_pane_lines(id :: String) :: List:
      match pane_spec(id)
      | spec :: Map:
          match spec.get("lines", #false)
          | fn :: Function:
              try:
                fn()
                ~catch _: []
          | ~else: []
      | ~else: []
    let pane_lines:
      cond
      | active_pane == "queue": pager.queue_pane_lines(followups)
      | active_pane is_a String: ext_pane_lines(to_string(active_pane))
      | ~else: []
    let pane_h_want:
      if active_pane
      | math.min(8, math.max(1, pane_lines.length() + 1))
      | 0
    // extension widgets, one row per line (total capped at 4 rows)
    let widget_lines:
      for List:
        each key in widgets.keys().sort()
        each l in to_string(widgets[key]).split("\n")
        l
    let widget_h_want = math.min(widget_lines.length(), 4)
    // header rows (title / header_extra) shown above the transcript
    let header_rows:
      cond
      | title_str != "" && header_extra != "":
          [[tcolor("accent"), #false, "bold", " " +& title_str],
           [tcolor("muted"), #false, "dim", " " +& header_extra]]
      | title_str != "":
          [[tcolor("accent"), #false, "bold", " " +& title_str]]
      | header_extra != "":
          [[tcolor("muted"), #false, "dim", " " +& header_extra]]
      | ~else: []
    let header_h_want = header_rows.length()
    let search_h = (if search_active | 1 | 0)
    let ask = pending_ask()
    let overlay_rows:
      cond
      | ask is_a Map: ask_card_rows(ask, tcolor, cols)
      | q_waiting:
          pager.question_card_rows(q_prompt, q_options.add(pager.OTHER_OPTION),
                                   cols, tcolor)
      | plan_waiting:
          pager.plan_review_rows(plan_items_ui, cols, tcolor)
      | overlay_kind == "plan_pending":
          let items = if overlay_data is_a List | overlay_data | []
          pager.plan_review_rows(items, cols, tcolor)
      | ~else: []
    let ask_h = overlay_rows.length()
    let ask_rows = overlay_rows
    let editor_h_want = (if fullscreen_mode | 1 | input_h_want)
    let layout = fit_tui_layout(rows, editor_h_want, header_h_want,
                                widget_h_want, queue_h_want, popup_h_want,
                                search_h, ~ask_h: ask_h, ~pane_want: pane_h_want)
    let ed_h = layout["editor"]
    let header_h = layout["header"]
    let widget_h = layout["widget"]
    let queue_h = layout["queue"]
    let popup_h = layout["popup"]
    let pane_h = layout["pane"]
    let trans_h = layout["transcript"]
    let header_rows = list_prefix(header_rows, header_h)
    last_trans_h := trans_h
    last_trans_y := header_h
    // wrap only the tail of the transcript that can possibly be visible
    // (each raw line wraps to >= 1 row, so this many raw lines suffice)
    let all_lines = (if partial == "" | lines | lines.add([partial_kind, partial]))
    let blocks = pager.entry_blocks(all_lines)
    let need = trans_h + scroll + 4
    // A search target must be included before wrapped-row coordinates can be
    // calculated. Normal scrolling still wraps only the needed transcript tail.
    let tail_start:
      match search_target
      | target :: Int: math.max(0, target - 4)
      | ~else: math.max(0, all_lines.length() - need)
    // assistant lines get markdown styling; ``` fences are tracked while
    // walking the tail (a fence opened before the window is missed — rare)
    def mutable fence = #false
    def mutable wrapped_sources :: List = []
    def mutable wrapped_kinds :: List = []
    let wrapped:
      for List:
        each i in tail_start .. all_lines.length()
        let [kind, text] = all_lines[i]
        // hidden thinking: one marker row per run of think lines (Ctrl-T)
        skip_when kind == "think" && !thinking_shown
          && i > tail_start && all_lines[i - 1][0] == "think"
        let shown:
          if kind == "think" && !thinking_shown
          | "\u2234 thinking\u2026 (hidden, ctrl-t shows)"
          | to_string(tool_line(kind, text) || text)
        // multi-line entries (push_block): tool output folds to its first
        // line unless expanded with Ctrl-O
        each sub:
          if shown.contains("\n")
          | let parts = shown.split("\n", ~trim: #false)
            let blk = pager.block_at_index(blocks, i)
            let bid = if blk is_a Map | blk["id"] | i
            if kind == "tool_result" && !tools_expanded && !expanded_tools.has_key(bid)
            | [to_string(parts[0])
                 +& " \u2026(+" +& (parts.length() - 1) +& " lines, click/enter)"]
            | for List (p in parts): to_string(p)
          | [shown]
        let spans:
          cond
          | kind == "assistant":
              let was = fence
              let sub = apply_transformers(sub)
              when sub.trim().starts_with("```")
              | fence := !fence
              md_line_spans(sub, was, tcolor)
          | kind == "think": [[tcolor("think"), #false, "dim", sub]]
          | kind == "subagent":
              [[tcolor("subagent"), #false, "dim", "  \u2502 " +& sub]]
          | ~else: [[tcolor(kind), #false, #false, sub]]
        each row in wrap_spans(spans, cols)
        wrapped_sources := wrapped_sources.add(i)
        wrapped_kinds := wrapped_kinds.add(kind)
        row
    // Convert a raw transcript match to the bottom-relative wrapped-row
    // offset used by scrolling. Keep two rows of context above the match.
    match search_target
    | target :: Int:
        match list_find_index(wrapped_sources, target)
        | pos :: Int:
            let desired_first = math.max(0, pos - 2)
            scroll := math.max(0, wrapped.length() - trans_h - desired_first)
        | ~else: #void
        search_target := #false
    | ~else: #void
    let max_scroll:
      if tail_start > 0
      | scroll  // older lines exist beyond the wrapped tail; allow scrolling on
      | math.max(0, wrapped.length() - trans_h)
    let off = clamp(scroll, 0, max_scroll)
    scroll := off
    let first = math.max(0, wrapped.length() - trans_h - off)
    let trans_rows:
      let real:
        for List (i in first .. math.min(wrapped.length(), first + trans_h)):
          wrapped[i]
      let pad:
        for List (i in 0 .. trans_h - real.length()):
          [[#false, #false, #false, ""]]
      real ++ pad
    // remember what's on screen for mouse selection extraction
    visible_plain := (for List (row in trans_rows):
                        for values(acc = "") (sp in row):
                          acc +& to_string(sp[3]))
    // mouse selection: inverse-video highlight over the selected range
    let trans_rows:
      if sel_anchor && sel_focus && sel_dragged
      | let [r0, c0, r1, c1] = norm_sel()
        for List (r in 0 .. trans_rows.length()):
          if r < r0 || r > r1
          | trans_rows[r]
          | let t = to_string(visible_plain[r])
            let a = (if r == r0 | c0 | 0)
            let b = (if r == r1 | c1 + 1 | 999999)
            let i0 = math.min(idx_at_col(t, a), t.length())
            let i1 = math.min(idx_at_col(t, b), t.length())
            // empty rows inside the range keep a one-cell marker
            let sel = (if i0 == i1 && t == "" | " " | t.substring(i0 .. i1))
            for List:
              each sp in [[#false, #false, #false, t.substring(0 .. i0)],
                          [#false, #false, "invert", sel],
                          [#false, #false, #false, t.substring(i1 ..)]]
              skip_when sp[3] == ""
              sp
      | trans_rows
    // search match highlighting: invert the query substring in rows that
    // contain it (case-insensitive). Every branch must return one row (a
    // list of spans); wrapping a non-match in another list breaks term-draw!.
    let trans_rows:
      if search_matches == [] || search_query == ""
      | trans_rows
      | for List (r in 0 .. trans_rows.length()):
          highlight_search_row(trans_rows[r], search_query)
    last_selected_kind := (match selected_block
                           | id :: Int:
                               match pager.block_at_index(blocks, id)
                               | b :: Map: to_string(b["kind"])
                               | ~else: ""
                           | ~else: "")
    let trans_rows:
      for List (r in 0 .. trans_rows.length()):
        let src:
          if first + r < wrapped_sources.length()
          | wrapped_sources[first + r]
          | -1
        let blk = pager.block_at_index(blocks, src)
        let selected = blk is_a Map && selected_block == blk["id"]
        let hovered = hover_hit is_a Map && hover_hit.get("row", -1) == header_h + r
        let row = trans_rows[r]
        let row:
          if selected
          | for List (sp in row):
              [sp[0], tcolor("footer_bg"), (if sp[2] | sp[2] | #false), sp[3]]
          | row
        if hovered | pager.apply_hover_row(row, #true) | row
    // separator; shows position while scrolled back
    let total_visible = wrapped.length()
    let sep_text:
      cond
      | fullscreen_mode && total_visible > trans_h:
          // fullscreen: show [first-visible/total] scroll position
          let pos = math.min(off, total_visible - trans_h)
          let tag = "\u2500\u2500 [" +& (pos + 1) +& "/" +& total_visible
                    +& "] \u2193 " +& off +& " (PgDn/wheel) "
          tag +& String.make(math.max(0, cols - display_width(tag)), Char"\u2500")
      | off > 0:
          let tag = "\u2500\u2500 \u2193 " +& off +& " (PgDn/wheel to return) "
          tag +& String.make(math.max(0, cols - display_width(tag)), Char"\u2500")
      | ~else:
          String.make(cols, Char"\u2500")
    let sep = [[tcolor("sep"), #false, #false, sep_text]]
    // editor window containing the cursor
    let win_start = clamp(cur_line - ed_h + 1, 0, math.max(0, input_lines.length() - ed_h))
    let input_rows:
      for List (i in win_start .. math.min(input_lines.length(), win_start + ed_h)):
        let prompt = (if i == 0 | "\u276F " | "\u2502 ")
        [[tcolor("prompt"), #false, "bold", prompt]]
          ++ editor_line_spans(to_string(input_lines[i]), i == 0, tcolor)
    // extension widgets above the queue/status area
    let widget_rows:
      for List (i in 0 .. widget_h):
        let l = to_string(widget_lines[i])
        let l = (if display_width(l) > cols | l.substring(0 .. cols) | l)
        [[tcolor("notify"), #false, #false, " " +& l]]
    // queued follow-ups (Alt-Enter) shown above the status line
    let queue_rows:
      if queue_h == 0
      | []
      | let shown_start = followups.length() - queue_h
        for List (i in shown_start .. followups.length()):
          let f = String.join(to_string(followups[i]).split("\n"), " ")
          let f = (if f.length() > cols - 12 | f.substring(0 .. cols - 12) +& "\u2026" | f)
          [[tcolor("steer"), #false, "dim",
            " \u29D6 queued " +& (i + 1) +& "/" +& followups.length() +& ": " +& f]]
    let pane_rows:
      if pane_h == 0
      | []
      | let title = " " +& to_string(active_pane) +& "  (Ctrl-T todos \u00B7 Ctrl-G tasks \u00B7 Ctrl-; queue)"
        let title_row = [[tcolor("prompt"), #false, "bold",
                          (if title.length() <= cols | title | title.substring(0 .. cols))]]
        let body:
          for List (i in 0 .. math.max(0, pane_h - 1)):
            if i >= pane_lines.length()
            | [[#false, #false, #false, ""]]
            | let line = to_string(pane_lines[i].get("text", ""))
              let line = (if line.length() <= cols | line | line.substring(0 .. cols))
              [[tcolor("steer"), #false, #false, line]]
        [title_row] ++ body
    // status line (pi-style): its own row between transcript and editor;
    // blank when idle so the layout doesn't jump. Footer below stays intact.
    let live_n = tasks.live().length()
    let still = tasks.status_text(~queued: followups.length())
    let status_row:
      cond
      | turn_thread:
          spin_i := spin_i + 1
          let frames = (if spinner_frames_custom | spinner_frames_custom | spinner_frames)
          let frame = frames[spin_i mod frames.length()]
          let secs = math.exact(math.floor((rkt.#{current-inexact-milliseconds}() - turn_started) / 1000))
          let msg = (if activity | to_string(activity) | "working") +& "..."
          [[tcolor("prompt"), #false, "bold", " " +& frame +& " "],
           [tcolor("tool_result"), #false, #false,
            msg +& " " +& secs +& "s (esc to interrupt \u00B7 type to steer)"]]
      | still != "":
          [[tcolor("prompt"), #false, #false, " " +& still]]
      | ~else:
          [[#false, #false, #false, ""]]
    // search prompt row (present only while typing a query). Keeping an
    // idle placeholder here would draw one row more than search_h budgets,
    // clipping the footer and placing the cursor on the separator.
    let search_rows = search_prompt_rows(search_active, search_query, tcolor)
    // autocomplete popup below the editor (pi-style select list)
    let popup_rows:
      if popup_h == 0
      | []
      | let win = clamp(ac_sel - popup_h + 1, 0, math.max(0, ac_items.length() - popup_h))
        for List (i in win .. win + popup_h):
          let [_ins, label, desc] = ac_items[i]
          let label = to_string(label)
          let lab = label +& String.make(math.max(1, 18 - label.length()), Char" ")
          if i == ac_sel
          | [[tcolor("footer_fg"), tcolor("footer_bg"), "bold", " \u276F " +& lab],
             [tcolor("footer_fg"), tcolor("footer_bg"), #false, to_string(desc)]]
          | [[tcolor("prompt"), #false, #false, "   " +& lab],
             [tcolor("tool_result"), #false, #false, to_string(desc)]]
    // shortcuts bar + footer chips
    let hints = pager.shortcuts_bar(focus, turn_thread && #true, last_selected_kind)
    let chip_src = footer() +& (if footer_extra == "" | "" | " \u2502 " +& footer_extra)
    let chips = pager.split_chips(chip_src)
    let ftext = hints +& "  \u00B7  " +& String.join(chips, " \u2502 ")
    let fpad:
      let padding = math.max(0, cols - display_width(ftext))
      ftext.substring(0 .. math.min(ftext.length(), cols)) +& String.make(padding, Char" ")
    let foot = [[tcolor("footer_fg"), tcolor("footer_bg"), #false, fpad]]
    let cursor_row = clamp(header_h + trans_h + widget_h + pane_h + queue_h + ask_h
                             + search_h + 2 + (cur_line - win_start),
                           0, math.max(0, rows - 1))
    let cursor_col = clamp(2 + display_width(cur_text().substring(0 .. cur_col)),
                           0, cols - 1)
    let y_trans = header_h
    let y_widget = y_trans + trans_h
    let y_pane = y_widget + widget_h
    let y_queue = y_pane + pane_h
    let y_status = y_queue + queue_h
    let y_ask = y_status + 1
    let y_search = y_ask + ask_h
    let y_sep = y_search + search_h
    let y_ed = y_sep + 1
    let y_pop = y_ed + ed_h
    let y_foot = y_pop + popup_h
    last_ed_y := y_ed
    last_pane_y := y_pane
    let hits:
      let trans_hits:
        for List (i in first .. math.min(wrapped.length(), first + trans_h)):
          let src = wrapped_sources[i]
          let blk = pager.block_at_index(blocks, src)
          let bid = if blk is_a Map | blk["id"] | src
          let y = y_trans + (i - first)
          let base = [make_hit(y, 0, cols, "entry", bid)]
          if to_string(wrapped_kinds[i]) == "tool_result"
          | base.add(make_hit(y, 0, cols, "tool_fold", bid))
          | base
      let trans_hits:
        for List:
          each group in trans_hits
          each h in group
          h
      let status_hits:
        cond
        | turn_thread: [make_hit(y_status, 0, cols, "stop", #false)]
        | still != "": [make_hit(y_status, 0, cols, "tasks_open", #false)]
        | ~else: []
      let ed_hits:
        for List (i in win_start .. math.min(input_lines.length(), win_start + ed_h)):
          make_hit(y_ed + (i - win_start), 0, cols, "editor", i)
      let pop_hits:
        if popup_h == 0
        | []
        | let win = clamp(ac_sel - popup_h + 1, 0, math.max(0, ac_items.length() - popup_h))
          for List (i in win .. win + popup_h):
            make_hit(y_pop + (i - win), 0, cols, "ac_pick", i)
      let ask_hits:
        cond
        | ask is_a Map: ask_card_hits(y_ask)
        | q_waiting:
            pager.question_card_hits(y_ask, q_options.add(pager.OTHER_OPTION))
        | plan_waiting || overlay_kind == "plan_pending":
            pager.plan_review_hits(y_ask)
        | ~else: []
      let pane_hits:
        for List (i in 0 .. math.min(pane_lines.length(), math.max(0, pane_h - 1))):
          make_hit(y_pane + 1 + i, 0, cols,
                   to_string(pane_lines[i].get("id", "pane")),
                   pane_lines[i].get("data", i))
      let chip_x = display_width(hints) + 4
      let chip_hs = pager.chip_hits(y_foot, chips, cols, ~x0: chip_x)
      [make_hit(y_trans, 0, cols, "scrollback", #false)]
        ++ trans_hits ++ status_hits ++ ask_hits ++ ed_hits ++ pop_hits ++ pane_hits
        ++ chip_hs
    last_hits := hits
    let foot = (if hover_hit is_a Map && hover_hit.get("row", -1) == y_foot
                | pager.apply_hover_row(foot, #true)
                | foot)
    if page_kind
    | render_page(rows, cols)
    | term.#{term-draw!}(header_rows ++ trans_rows ++ widget_rows ++ pane_rows ++ [status_row] ++ ask_rows ++ search_rows ++ [sep]
                           ++ input_rows ++ popup_rows ++ [foot],
                         (if focus == "prompt"
                          | [cursor_row, cursor_col]
                          | #false))

  // optional render-loop profiling: RHO_TUI_DEBUG=/path/to/log
  match rkt.getenv("RHO_TUI_DEBUG")
  | s :: ReadableString:
      debug_port := rkt.#{open-output-file}(to_string(s), ~exists: #'truncate)
  | ~else: #void

  // main loop
  bind_ask(wait_ask)
  term.#{term-start!}()
  try:
    recur loop():
      when running
      | // reap finished turn
        when turn_thread && rkt.#{thread-dead?}(turn_thread)
        | turn_thread := #false
          clear_activity()
          flush_partial()
          dirty := #true
          match followups
          | []: #void
          | [next, & rest]:
              followups := rest
              push("user", "\u276F " +& next +& "  (follow-up)")
              start_turn(next)
        // while a turn runs, repaint every tick (streams text, spins spinner)
        when turn_thread
        | dirty := #true
        when dirty
        | let t0 = rkt.#{current-inexact-milliseconds}()
          render()
          let t1 = rkt.#{current-inexact-milliseconds}()
          dlog("render " +& math.exact(math.round(t1 - t0)) +& "ms at " +& math.exact(math.round(t1)))
        // periodically re-check the terminal size via stty (works even when
        // the terminal ignores CSI size queries)
        let now = rkt.#{current-inexact-milliseconds}()
        when now - last_size_poll > 2000
        | last_size_poll := now
          when term.#{term-poll-size!}()
          | dirty := #true
          // hot-reload theme: re-read the theme file and update if it changed
          let new_t = theme_loader()
          when new_t is_a Map
          | let new_json = json.to_string(new_t)
            when new_json != last_theme_json
            | last_theme_json := new_json
              current_theme := default_theme ++ new_t
              dirty := #true
        let e = term.#{term-wait-event}((if turn_thread | 0.05 | 0.5), wake_sema)
        fun dispatch_key(k :: String):
          dlog("key " +& k)
          try:
            handle_key(k)
            dlog("key done " +& k)
            ~catch ex :: Exn.Fail:
              push("error", "ui error: " +& ex.message)
        fun handle_event(e):
          match e
          | #'timeout: #void
          | #'wake: #void
          | #'skip: #void
          | #'eof: running := #false
          | [#'resize, _, _]: dirty := #true
          | [#'wheel, d]:
              if page_kind
              | page_sel := math.max(0, page_sel + (if d > 0 | -1 | 1))
                dirty := #true
              | block:
                  scroll := math.max(0, scroll + d)
                  dirty := #true
          | [#'mouse, mtype, btn, mrow, mcol]:
              let mt = to_string(mtype)
              let r = mrow - 1
              let c = mcol - 1
              cond
              | mt == "motion":
                  let h = hit_at(last_hits, r, c)
                  let prev = hover_hit
                  let same:
                    cond
                    | prev is_a Map && h is_a Map:
                        prev.get("id", "") == h.get("id", "")
                          && prev.get("row", -1) == h.get("row", -1)
                    | prev == #false && h == #false: #true
                    | ~else: #false
                  when !same
                  | hover_hit := h
                    dirty := #true
              | mt == "press" && btn == 1:
                  cond
                  | page_kind: #void
                  | r >= last_trans_y && r < last_trans_y + last_trans_h:
                      let rr = r - last_trans_y
                      sel_anchor := [rr, c]
                      sel_focus := [rr, c]
                      sel_dragged := #false
                      dirty := #true
                  | ~else:
                      clear_selection()
                      when r >= last_ed_y
                      | focus := "prompt"
                        dirty := #true
              | mt == "drag" && sel_anchor:
                  sel_focus := [clamp(r - last_trans_y, 0, last_trans_h - 1), math.max(0, c)]
                  sel_dragged := #true
                  dirty := #true
              | mt == "release":
                  cond
                  | sel_anchor && sel_dragged:
                      let text = selection_text()
                      when text.trim() != ""
                      | copy_text(text)
                        push("notify", "[copied " +& text.length() +& " chars]")
                      clear_selection()
                  | ~else:
                      clear_selection()
                      match hit_at(last_hits, r, c)
                      | h :: Map: dispatch_hit(h, c)
                      | ~else: #void
              | ~else: #void
          | [#'key, k]:
              let k = to_string(k)
              // the ansi lexer has no ESC-prefix meta: detect Alt-Enter as
              // ESC immediately followed by Enter
              if k == "<escape>" || k == "C-["
              | let e2 = term.#{term-wait-event}(0.03, #false)
                match e2
                | [#'key, k2]:
                    if to_string(k2) == "C-M"
                    | queue_followup()
                    | dispatch_key(k)
                      handle_event(e2)
                | ~else:
                    dispatch_key(k)
                    handle_event(e2)
              | dispatch_key(k)
          | ~else: #void
        handle_event(e)
        loop()
    ~catch e :: Exn.Break:
      answer_ask("deny")
      when turn_thread
      | rkt.#{break-thread}(turn_thread)
  let was_asking = ask_waiting
  answer_ask("deny")
  when was_asking && turn_thread
  | rkt.#{break-thread}(turn_thread)
    rkt.#{thread-wait}(turn_thread)
  term.#{term-stop!}()
