#lang rhombus

// The agent loop: stream model output, execute tool calls, repeat.

import:
  json
  lib("racket/base.rkt") as rkt
  "../ai/openai.rhm"
  "../ai/anthropic.rhm"
  "../ai/gemini.rhm"
  "../ai/codex.rhm" as codex
  "../ai/modelsdev.rhm" as modelsdev
  "../ai/provider_error.rhm" as perr
  "../ai/types.rhm" open
  "oauth.rhm" as oauth

export:
  run_turn
  call_provider
  stop_reason
  MAX_STOP_CONTINUATIONS
  request_ask
  wants_ask
  step_limit
  step_limit_message
  MAX_STEPS
  MAX_STEPS_CAP

// tool_call may force a prompt with {"ask": #true}. Otherwise the
// permission extension (or any host) may install state["should_ask"].
fun wants_ask(registry, name :: String, verdict) :: Boolean:
  cond
  | verdict is_a Map && verdict.get("ask", #false): #true
  | ~else:
      match registry.state.get("should_ask", #false)
      | fn :: Function: fn(name, verdict)
      | ~else: #false

fun request_ask(registry, data :: Map) :: String:
  registry.state["pending_ask"] := data
  registry.emit("ask", data)
  let raw = try:
              match registry.state.get("ask_reply", #false)
              | fn :: Function: to_string(fn())
              | ~else: "allow"
              ~catch _: "deny"
  registry.state["pending_ask"] := #false
  let d = raw.foldcase().trim()
  if d == "allow" || d == "y" || d == "yes" | "allow" | "deny"

fun execute_tool(registry, name :: String, args :: Map) :: String:
  let tool = registry.find_tool(name)
  cond
  | !tool: "error: unknown tool: " +& name
  | ~else:
      try:
        to_string(tool.fn(args))
        ~catch e :: Exn.Fail:
          "error: " +& e.message

def MAX_STEPS = 200
def MAX_STEPS_CAP = 2000
def MAX_STOP_CONTINUATIONS = 8

fun step_limit(config) :: Int:
  let raw = config.settings.get("max_steps", MAX_STEPS)
  let n:
    cond
    | raw is_a Int: raw
    | ~else:
        match String.maybe_to_int(to_string(raw).trim())
        | i :: Int: i
        | ~else: MAX_STEPS
  cond
  | n < 1: MAX_STEPS
  | n > MAX_STEPS_CAP: MAX_STEPS_CAP
  | ~else: n

fun step_limit_message(limit :: Int) :: String:
  "reached " +& limit +& " steps; send a message to continue, or /steps N"

fun announce_step_limit(n :: Int, limit :: Int, registry, session, on_text):
  let msg = step_limit_message(limit)
  on_text("\n[" +& msg +& "]\n")
  registry.emit("turn_limit", { "step": n, "limit": limit })
  session.append_message(assistant_message("[" +& msg +& "]", []))
  #void

// agent_end handlers may return {"block": #true, "reason": "..."} to keep
// the agent working (Grok-style Stop hook). Cap so a failing verify cannot
// loop forever.
fun stop_reason(verdict, continuations :: Int):
  cond
  | continuations >= MAX_STOP_CONTINUATIONS: #false
  | verdict is_a Map && verdict.get("block", #false):
      let r = to_string(verdict.get("reason", "stop hook blocked"))
      if r == "" | "stop hook blocked" | r
  | ~else: #false

fun call_provider(config, messages, tools, on_text,
                  ~on_thinking: on_thinking = fun (s): #void,
                  ~headers: headers :: Map = {}):
  // auto-retry with exponential backoff (settings: auto_retry / max_retries)
  let retries:
    if config.settings.get("auto_retry", #true) == #false
    | 0
    | config.settings.get("max_retries", 3)
  recur attempt(n = 0):
    try:
      do_call_provider(config, messages, tools, on_text, on_thinking, headers)
      ~catch e :: Exn.Fail:
        let transient = perr.is_transient(e)
        // billing_not_active is a 4xx that arrives as a provider error — never retry
        let transient = transient && !e.message.contains("billing_not_active")
        if !(transient && n < retries)
        | throw(e)
        | block:
            let ra = perr.retry_after(e)
            let delay:
              match ra
              | s :: Int: math.min(60, s)
              | ~else: math.min(8, rkt.expt(2, n))
            rkt.sleep(delay)
            attempt(n + 1)

fun do_call_provider(config, messages, tools, on_text, on_thinking, headers :: Map):
  oauth.ensure_fresh(config)
  let headers = headers ++ oauth.provider_headers(config)
  let transport = to_string(config.settings.get("transport", "auto"))
  match config.kind()
  | "anthropic":
      anthropic.stream_chat(~base_url: config.base_url(),
                            ~api_key: config.api_key(),
                            ~model: config.model,
                            ~messages: messages,
                            ~tools: tools,
                            ~on_text: on_text,
                            ~on_thinking: on_thinking,
                            ~thinking: config.thinking,
                            ~extra_headers: headers,
                            ~transport: transport)
  | "gemini":
      gemini.stream_chat(~base_url: config.base_url(),
                         ~api_key: config.api_key(),
                         ~model: config.model,
                         ~messages: messages,
                         ~tools: tools,
                         ~on_text: on_text,
                         ~on_thinking: on_thinking,
                         ~thinking: config.thinking,
                         ~extra_headers: headers,
                         ~transport: transport)
  | ~else:
      if oauth.is_chatgpt_oauth(config)
      | codex.stream_responses(~base_url: oauth.chatgpt_codex_url,
                               ~api_key: config.api_key(),
                               ~model: modelsdev.codex_model_id(config.model),
                               ~messages: messages,
                               ~tools: tools,
                               ~on_text: on_text,
                               ~on_thinking: on_thinking,
                               ~thinking: config.thinking,
                               ~extra_headers: headers)
      | openai.stream_chat(~base_url: config.base_url(),
                           ~api_key: config.api_key(),
                           ~model: config.model,
                           ~messages: messages,
                           ~tools: tools,
                           ~on_text: on_text,
                           ~on_thinking: on_thinking,
                           ~thinking: config.thinking,
                           ~extra_headers: headers,
                           ~transport: transport)

// Drain steering messages (sent to the current thread's mailbox by the REPL
// while a turn runs) into the session. Returns #true if any arrived.
// steering_mode "one-at-a-time" (registry.state) delivers one per round.
fun drain_steering(session, registry, on_steer):
  let one_at_a_time = registry.state.get("steering_mode", "all") == "one-at-a-time"
  recur go(any = #false):
    match rkt.#{thread-try-receive}()
    | #false: any
    | v:
        let s = to_string(v)
        session.append_message(user_message(s))
        registry.emit("user_message", { "content": s, "steering": #true })
        on_steer(s)
        if one_at_a_time | #true | go(#true)

// Executes one full user turn. UI callbacks:
//   on_text(delta)                     streaming assistant text
//   on_thinking(delta)                 streaming chain-of-thought text
//   on_tool(name, args_map)            before a tool runs
//   on_tool_result(name, result_str)   after a tool ran
//   on_steer(msg)                      a queued steering message was injected
//
// Events emitted: input (may rewrite {"text"}), agent_start/agent_end/
// agent_settled (whole turn), turn_start/turn_end (each model round),
// before_request (may return {"messages": [...]} to inject transient
// context), context (may rewrite the full outgoing {"messages"}),
// before_provider_request (may return {"headers": {...}}), message_start/
// message_update/message_end (streaming), tool_call (may block),
// tool_execution_start/tool_execution_end, tool_result, user_message.
fun run_turn(~config: config,
             ~registry: registry,
             ~session: session,
             ~system_prompt: system_prompt :: String,
             ~input: input :: String,
             ~on_text: on_text = fun (s): #void,
             ~on_thinking: on_thinking = fun (s): #void,
             ~on_tool: on_tool = fun (name, args): #void,
             ~on_tool_result: on_tool_result = fun (name, r): #void,
             ~on_steer: on_steer = fun (s): #void,
             ~images: images :: List = [],
             ~from_stop: from_stop = #false):
  when !from_stop
  | registry.state["stop_continuations"] := 0
  // "input" may rewrite the user's text before it enters the session
  let input:
    match registry.emit("input", { "text": input })
    | m :: Map:
        match m.get("text", #false)
        | s :: String: s
        | ~else: input
    | ~else: input
  session.append_message(if images == []
                         | user_message(input)
                         | user_message(input) ++ { "images": images })
  registry.emit("user_message", { "content": input })
  registry.emit("before_agent_start", { "input": input })
  registry.emit("agent_start", { "input": input })
  recur step(n = 0):
    let limit = step_limit(config)
    registry.emit("turn_start", { "step": n })
    let injected:
      match registry.emit("before_request", { "step": n })
      | m :: Map:
          let ms = m.get("messages", [])
          if ms is_a List | ms | []
      | ~else: []
    let messages = [system_message(system_prompt)] ++ injected ++ session.messages()
    // "context" may rewrite the outgoing message list wholesale
    let messages:
      match registry.emit("context", { "messages": messages })
      | m :: Map:
          match m.get("messages", #false)
          | ms :: List: ms
          | ~else: messages
      | ~else: messages
    // "before_provider_request" may contribute extra HTTP headers
    let extra_headers:
      match registry.emit("before_provider_request",
                          { "model": config.model, "step": n })
      | m :: Map:
          let h = m.get("headers", {})
          if h is_a Map | h | {}
      | ~else: {}
    registry.emit("message_start", { "step": n })
    let assistant = call_provider(config, messages, registry.tools_wire(),
                                  fun (s):
                                    registry.emit("message_update", { "delta": s })
                                    on_text(s),
                                  ~on_thinking:
                                    fun (s):
                                      registry.emit("thinking_update", { "delta": s })
                                      on_thinking(s),
                                  ~headers: extra_headers)
    let assistant = openai.sanitize_assistant(assistant)
    registry.emit("after_provider_response", { "message": assistant, "model": config.model })
    registry.emit("message_end", { "message": assistant })
    session.append_message(assistant)
    let tool_calls = tool_calls_of(assistant)
    for (tc in tool_calls):
      let name = tc["name"]
      let parsed = try:
                     json.from_string(to_string(tc.get("arguments", "")))
                     ~catch _: #false
      let args:
        cond
        | parsed is_a Map: parsed
        | parsed is_a String && parsed != "": { "command": parsed }
        | ~else: {}
      on_tool(name, args)
      let verdict = registry.emit("tool_call", { "toolName": name, "input": args })
      registry.emit("tool_execution_start", { "toolName": name, "input": args })
      let result:
        cond
        | verdict is_a Map && verdict.get("block", #false):
            "blocked: " +& verdict.get("reason", "blocked by extension")
        | wants_ask(registry, name, verdict):
            let reason = (if verdict is_a Map | to_string(verdict.get("reason", "")) | "")
            let decision = request_ask(registry,
                                       { "toolName": name,
                                         "input": args,
                                         "reason": reason })
            if decision == "deny"
            | "blocked: user denied " +& name
            | execute_tool(registry, name, args)
        | ~else:
            execute_tool(registry, name, args)
      registry.emit("tool_execution_end", { "toolName": name, "result": result })
      registry.emit("tool_result", { "toolName": name, "result": result })
      on_tool_result(name, result)
      session.append_message(tool_message(tc["id"], result))
    // images staged by tools (read_file on an image) become a user message
    // with attachments so both provider protocols can carry them
    match registry.state.get("pending_images", [])
    | [] : #void
    | imgs :: List:
        registry.state["pending_images"] := []
        let names:
          String.join((for List (im in imgs): to_string(im.get("name", "image"))), ", ")
        session.append_message(user_message("[attached image(s): " +& names +& "]")
                                 ++ { "images": imgs })
    registry.emit("turn_end", { "step": n,
                                "content": assistant.get("content", ""),
                                "tool_count": tool_calls.length() })
    let steered = drain_steering(session, registry, on_steer)
    when tool_calls != [] || steered
    | if n + 1 >= limit
      | announce_step_limit(n + 1, limit, registry, session, on_text)
      | step(n + 1)
  let n = registry.state.get("stop_continuations", 0)
  let n = if n is_a Int | n | 0
  let verdict = registry.emit("agent_end",
                              { "continuations": n,
                                "stop_hook_active": n > 0 })
  registry.emit("agent_settled", {})
  match stop_reason(verdict, n)
  | reason :: String:
      registry.state["stop_continuations"] := n + 1
      run_turn(~config: config,
               ~registry: registry,
               ~session: session,
               ~system_prompt: system_prompt,
               ~input: reason,
               ~on_text: on_text,
               ~on_thinking: on_thinking,
               ~on_tool: on_tool,
               ~on_tool_result: on_tool_result,
               ~on_steer: on_steer,
               ~from_stop: #true)
  | ~else:
      // drain extension-queued follow-ups (send_message ~deliver_as: "followUp")
      match registry.state.get("followup_queue", [])
      | []: #void
      | [first, & rest]:
          registry.state["followup_queue"] := rest
          run_turn(~config: config,
                   ~registry: registry,
                   ~session: session,
                   ~system_prompt: system_prompt,
                   ~input: first,
                   ~on_text: on_text,
                   ~on_thinking: on_thinking,
                   ~on_tool: on_tool,
                   ~on_tool_result: on_tool_result,
                   ~on_steer: on_steer)
  #void
