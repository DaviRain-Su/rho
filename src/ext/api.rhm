#lang rhombus

// ExtensionAPI: the `rho` object handed to each extension's init(rho).

import:
  lib("racket/base.rkt") as rkt

export:
  PiAPI

def main_thread = rkt.#{current-thread}()

// Reads one line of user input. On the main thread stdin is free (command
// handlers run between prompts); on a turn thread the REPL forwards typed
// lines to our mailbox, so we take the next one from there.
fun read_reply() :: String:
  if rkt.#{current-thread}() == main_thread
  | match rkt.#{read-line}()
    | s :: ReadableString: to_string(s).trim()
    | ~else: ""
  | to_string(rkt.#{thread-receive}()).trim()

class UI(get_out):
  method input(prompt :: String) :: String:
    let out = get_out()
    out.write_string("\u001B[36m? " +& prompt +& "\u001B[0m ")
    out.flush()
    read_reply()

  method confirm(prompt :: String) :: Boolean:
    let ans = input(prompt +& " [y/N]")
    ans.starts_with("y") || ans.starts_with("Y")

  // Returns the chosen element of options, or #false.
  method select(prompt :: String, options :: List):
    let out = get_out()
    out.write_string("\u001B[36m? " +& prompt +& "\u001B[0m\n")
    for (i in 0 .. options.length()):
      out.write_string("  " +& (i + 1) +& ". " +& options[i] +& "\n")
    out.flush()
    let ans = input("choose (number)")
    match String.maybe_to_int(ans)
    | n :: Int:
        if n >= 1 && n <= options.length() | options[n - 1] | #false
    | ~else: #false

class PiAPI(registry, get_out, get_session, extra_flags :: List,
            ui_hooks :: MutableMap = MutableMap(),
            get_config = fun (): #false):

  method current_config():
    get_config()

  method has_ui() :: Boolean:
    get_out() != #false

  method set_bash_spawn_hook(fn):
    registry.state["bash_spawn_hook"] := fn

  method register_tool(~name: name :: String,
                       ~description: description :: String,
                       ~schema: schema :: Map,
                       ~fn: fn):
    registry.register_tool(~name: name, ~description: description,
                           ~schema: schema, ~fn: fn)

  method register_command(~name: name :: String,
                          ~description: description :: String,
                          ~handler: handler):
    registry.register_command(~name: name, ~description: description,
                              ~handler: handler)

  method on(event :: String, fn):
    registry.on(event, fn)

  // Mutable key-value store owned by the kernel; survives /reload.
  property state:
    registry.state

  property ui :: UI:
    UI(get_out)

  property session:
    get_session()

  // Append a custom entry to the session tree (persisted, ignored by the
  // model context).
  method append_entry(data):
    get_session().append("custom", data)

  // Append a custom message that DOES enter the model context (as a user
  // message with the given content).
  method append_custom_message(content :: String):
    get_session().append("custom_message", { "content": content })

  // Read an extension CLI flag. Unrecognized "--name" / "--name=value"
  // arguments are collected at startup; returns value string, #true for a
  // bare flag, or #false when absent.
  method flag(name :: String):
    let bare = "--" +& name
    let prefix = bare +& "="
    for values(found = #false) (a in extra_flags):
      cond
      | found: found
      | a == bare: #true
      | a.starts_with(prefix): a.substring(prefix.length() ..)
      | ~else: #false

  // pi-compatible alias: declare + read in one call.
  method register_flag(~name: name :: String,
                       ~description: _description :: String = ""):
    flag(name)

  // Custom transcript rendering for a tool (used by the TUI).
  // fn(phase, name, data) -> maybe(String); phase is "call" or "result".
  method register_renderer(~tool: tool :: String, ~fn: fn):
    let m:
      match registry.state.get("tool_renderers", #false)
      | mm :: MutableMap: mm
      | ~else:
          let mm = MutableMap()
          registry.state["tool_renderers"] := mm
          mm
    m[tool] := fn

  // Custom rendering for transcript entries by kind (assistant, tool,
  // notify, ...). fn(kind, text) -> maybe(String); first non-#false wins.
  method register_message_renderer(~fn: fn):
    registry.state["message_renderers"]
      := registry.state.get("message_renderers", []).add(fn)

  // pi alias
  method register_entry_renderer(~fn: fn):
    register_message_renderer(~fn: fn)

  // Register a custom provider profile into the live config, e.g.
  // {"kind": "openai", "base_url": ..., "api_key_env": ..., "default_model": ...}
  method register_provider(~name: name :: String, ~profile: profile :: Map):
    match get_config()
    | #false: #void
    | cfg: cfg.register_provider(name, profile)

  // ---- TUI hooks (no-ops outside the TUI) ----
  method set_status(s):
    match ui_hooks.get("set_status", #false)
    | #false: #void
    | h: h(s)

  method set_widget(id :: String, text):
    match ui_hooks.get("set_widget", #false)
    | #false: #void
    | h: h(id, text)

  method set_footer(s :: String):
    match ui_hooks.get("set_footer", #false)
    | #false: #void
    | h: h(s)

  method notify(msg :: String):
    match get_out()
    | #false: #void
    | out:
        out.write_string("\u001B[36m[rho]\u001B[0m " +& msg +& "\n")
        out.flush()

  // Set the current model in the live config.
  method set_model(model :: String):
    match get_config()
    | #false: #void
    | cfg: cfg.model := model

  // Return the current thinking level as a string ("off", "low", ...).
  method get_thinking_level() :: String:
    match get_config()
    | #false: "off"
    | cfg:
        if cfg.thinking | to_string(cfg.thinking) | "off"

  // Set the thinking level; "off" clears it.
  method set_thinking_level(level :: String):
    match get_config()
    | #false: #void
    | cfg:
        if level == "off"
        | cfg.thinking := #false
        | cfg.thinking := level

  // Names of currently visible (filter-passing) tools.
  method get_active_tools() :: List:
    for List (t in registry.tool_list()):
      t.name

  // All registered tool names, sorted.
  method get_all_tools() :: List:
    registry.tools.keys().sort()

  // Restrict the tool filter to the given names.
  method set_active_tools(names :: List):
    registry.set_tool_filter(~allow: names)

  // Register a keyboard shortcut for the TUI to pick up.
  method register_shortcut(~key: key :: String,
                           ~description: description :: String = "",
                           ~fn: fn):
    let m:
      match registry.state.get("shortcuts", #false)
      | mm :: MutableMap: mm
      | ~else:
          let mm = MutableMap()
          registry.state["shortcuts"] := mm
          mm
    m[key] := { "description": description, "fn": fn }

  // Register a TUI click handler. The TUI looks up hits by id
  // ("footer", or any id an extension's renderer advertised).
  method register_click(~id: id :: String, ~fn: fn):
    let m:
      match registry.state.get("clicks", #false)
      | mm :: MutableMap: mm
      | ~else:
          let mm = MutableMap()
          registry.state["clicks"] := mm
          mm
    m[id] := fn

  // Register a markdown transformer; TUI applies them in order.
  method register_markdown_transformer(~fn: fn):
    let xs = registry.state.get("markdown_transformers", [])
    registry.state["markdown_transformers"] := xs.add(fn)

  // Inject a custom message into the session.
  method send_message(content :: String,
                      ~deliver_as: deliver_as :: String = "next_turn"):
    cond
    | deliver_as == "steer":
        rkt.#{thread-send}(rkt.#{current-thread}(), content)
    | deliver_as == "followUp":
        let q = registry.state.get("followup_queue", [])
        registry.state["followup_queue"] := q.add(content)
    | ~else:
        get_session().append("custom_message", { "content": content })

  // Inject a user message into the session.
  method send_user_message(content :: String,
                           ~deliver_as: deliver_as :: String = "next_turn"):
    cond
    | deliver_as == "steer":
        rkt.#{thread-send}(rkt.#{current-thread}(), content)
    | deliver_as == "followUp":
        let q = registry.state.get("followup_queue", [])
        registry.state["followup_queue"] := q.add(content)
    | ~else:
        get_session().append_message({ "role": "user", "content": content })

  // Shared event bus (the registry itself) for inter-extension events.
  property events:
    registry

  // Set a label/bookmark on a session entry.
  method set_label(entry_id :: Int, label :: String):
    let s = get_session()
    s.set_label(label, ~target: entry_id)

  // Set the session display name.
  method set_session_name(name :: String):
    get_session().set_name(name)

  // Get the session display name.
  method get_session_name() :: String:
    get_session().name
