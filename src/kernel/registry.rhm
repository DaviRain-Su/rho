#lang rhombus

// Central registry: tools, commands, event handlers, extension state.
// Entries are tagged with a source ("builtin" or extension path) so that
// extension-contributed entries can be wiped and rebuilt on /reload.
// Maps are mutex-guarded: the turn thread looks up tools while /reload
// and the TUI read the same registry.

import:
  "sync.rkt" as sync

export:
  Tool
  Command
  Registry
  make_registry

class Tool(name :: String,
           description :: String,
           schema :: Map,
           fn,
           source :: String):
  method wire() :: Map:
    // shape consumed by provider clients
    { "name": name, "description": description, "schema": schema }

class Command(name :: String,
              description :: String,
              handler,
              source :: String)

class Registry(tools :: MutableMap,
               commands :: MutableMap,
               handlers :: MutableMap,
               state :: MutableMap,
               mutable current_source :: String,
               mutable allow_tools,
               mutable deny_tools :: List,
               mu):

  method locked(fn):
    sync.#{with-lock}(mu, fn)

  method set_tool_filter(~allow: allow = #false, ~deny: deny :: List = []):
    fun apply_filter():
      allow_tools := allow
      deny_tools := deny
      #void
    locked(apply_filter)

  method tool_visible(name :: String) :: Boolean:
    cond
    | deny_tools.contains(name): #false
    | allow_tools is_a List: allow_tools.contains(name)
    | ~else: #true

  method register_tool(~name: name :: String,
                       ~description: description :: String,
                       ~schema: schema :: Map,
                       ~fn: fn):
    locked(fun (): tools[name] := Tool(name, description, schema, fn, current_source))

  method register_command(~name: name :: String,
                          ~description: description :: String,
                          ~handler: handler):
    locked(fun (): commands[name] := Command(name, description, handler, current_source))

  method on(event :: String, fn):
    locked(fun (): handlers[event] := handlers.get(event, []).add([current_source, fn]))

  // Runs all handlers for event; returns first Map result that is not #false
  // (used for tool_call interception: {"block": #true, "reason": ...}).
  // Copy the handler list under the lock, then call out so a handler that
  // registers tools cannot deadlock.
  method emit(event :: String, data :: Map):
    let hs = locked(fun (): handlers.get(event, []))
    for values(result = #false) (entry in hs):
      let [_, fn] = entry
      let r = try:
                fn(data)
                ~catch e :: Exn.Fail:
                  println("[rho] handler error for " +& event +& ": " +& e.message)
                  #false
      result || (r is_a Map && r)

  method find_tool(name :: String) :: maybe(Tool):
    locked(fun (): tool_visible(name) && tools.get(name, #false))

  method tool_list() :: List:
    fun list_tools() :: List:
      for List (name in tools.keys().sort()):
        skip_when !tool_visible(name)
        tools[name]
    locked(list_tools)

  method tools_wire() :: List:
    for List (t in tool_list()):
      t.wire()

  method command_list() :: List:
    fun list_cmds() :: List:
      for List (name in commands.keys().sort()):
        commands[name]
    locked(list_cmds)

  method find_command(name :: String) :: maybe(Command):
    locked(fun (): commands.get(name, #false))

  method snapshot_unlocked() :: Map:
    let ts:
      for List (name in tools.keys()):
        skip_when (tools[name] :: Tool).source == "builtin"
        [name, tools[name]]
    let cs:
      for List (name in commands.keys()):
        skip_when (commands[name] :: Command).source == "builtin"
        [name, commands[name]]
    let hs:
      for List (event in handlers.keys()):
        let ext:
          for List (entry in handlers[event]):
            skip_when entry[0] == "builtin"
            entry
        skip_when ext == []
        [event, ext]
    let renderers:
      match state.get("tool_renderers", #false)
      | mm :: MutableMap:
          for List (k in mm.keys()):
            [k, mm[k]]
      | ~else: []
    { "tools": ts,
      "commands": cs,
      "handlers": hs,
      "tool_renderers": renderers,
      "message_renderers": state.get("message_renderers", []) }

  method snapshot_extensions() :: Map:
    locked(fun (): snapshot_unlocked())

  method restore_extensions(snap :: Map):
    locked(fun (): restore_unlocked(snap))

  method restore_unlocked(snap :: Map):
    for (pair in snap.get("tools", [])):
      tools[pair[0]] := pair[1]
    for (pair in snap.get("commands", [])):
      commands[pair[0]] := pair[1]
    for (pair in snap.get("handlers", [])):
      let event = pair[0]
      handlers[event] := handlers.get(event, []) ++ pair[1]
    state["message_renderers"] := snap.get("message_renderers", [])
    let rows = snap.get("tool_renderers", [])
    when rows is_a List && rows != []
    | let mm = MutableMap()
      for (pair in rows):
        mm[pair[0]] := pair[1]
      state["tool_renderers"] := mm
    #void

  method clear_extensions():
    locked(fun (): clear_unlocked())

  method clear_unlocked():
    let doomed_tools:
      for List (name in tools.keys()):
        skip_when (tools[name] :: Tool).source == "builtin"
        name
    for (name in doomed_tools):
      tools.remove(name)
    let doomed_cmds:
      for List (name in commands.keys()):
        skip_when (commands[name] :: Command).source == "builtin"
        name
    for (name in doomed_cmds):
      commands.remove(name)
    let events:
      for List (event in handlers.keys()):
        event
    for (event in events):
      handlers[event] := (for List (entry in handlers[event]):
                            skip_when entry[0] != "builtin"
                            entry)
    // renderers are only ever extension-contributed: rebuild from scratch
    state["message_renderers"] := []
    match state.get("tool_renderers", #false)
    | mm :: MutableMap:
        let ks:
          for List (k in mm.keys()):
            k
        for (k in ks):
          mm.remove(k)
    | ~else: #void

fun make_registry() :: Registry:
  Registry(MutableMap(), MutableMap(), MutableMap(), MutableMap(), "builtin",
           #false, [], sync.#{make-lock}())
