#lang rhombus

// rho: a Pi-style hot-reloadable coding agent in Rhombus.
//
// Usage: rho [options] [message ...]
//   -p, --print                 run one turn, print the result, exit (headless)
//   --mode <text|json>          output mode for headless runs (json = JSONL events)
//   --provider <name>           provider profile from config
//   -m, --model <name>          model name
//   --resume <file>             resume a session file
//   --tools <a,b>               only enable these tools
//   --exclude-tools <a,b>       disable these tools
//   --no-tools                  disable all tools
//   --system-prompt <text>      replace the default system prompt
//   --append-system-prompt <t>  append to the system prompt
//   --no-context-files          skip AGENTS.md / CLAUDE.md discovery
//   --no-extensions             skip loading extensions
//   --api-key <key>             override the provider API key
//   --session-dir <dir>         session file directory
//   -e, --extension <path>      load an extra extension file/dir (repeatable)
//   --skill <path>              load an extra skill (repeatable, survives --no-skills)
//   --prompt-template <path>    load an extra template (repeatable)
//   --no-skills / --no-prompt-templates
//   -a, --approve / -na, --no-approve   one-shot project trust override
//   --export <in> [out]         export a session file to HTML and exit
//   subcommands: rho install|remove|update|list
//   @file arguments inline the file's content into the first message.
//   In print mode, piped stdin is merged into the first message.

import:
  lib("racket/base.rkt") as rkt
  lib("racket/port.rkt") as rktport
  json
  "kernel/config.rhm" open
  "kernel/registry.rhm" open
  "kernel/session.rhm" open
  "kernel/loop.rhm" open
  "kernel/context.rhm" as context
  "kernel/compaction.rhm" as compaction
  "kernel/skills.rhm" as skills
  "kernel/prompts.rhm" as prompts
  "kernel/packages.rhm" as packages
  "kernel/settings.rhm" as settings
  "kernel/trust.rhm" as trust
  "ai/models.rhm" as models
  "ai/modelsdev.rhm" as modelsdev
  rhombus/envvar
  "tools/core.rhm" open
  "ext/api.rhm" open
  "ext/loader.rhm" as loader
  "ui/repl.rhm" open
  "ui/tui.rhm" as tui

def mutable out = Port.Output.current()

// ---- command line ----
fun split_list(v :: String) :: List:
  for List (s in v.split(",")):
    skip_when s.trim() == ""
    s.trim()

fun parse_args() :: Map:
  let args = [& rkt.#{vector->list}(rkt.#{current-command-line-arguments}())]
  recur parse(rest = (for List (a in args): to_string(a)), acc :: Map = { "message": [] }):
    match rest
    | []: acc
    | ["-p", & more]: parse(more, acc ++ { "print": #true })
    | ["--print", & more]: parse(more, acc ++ { "print": #true })
    | ["--mode", v, & more]: parse(more, acc ++ { "mode": v })
    | ["--provider", v, & more]: parse(more, acc ++ { "provider": v })
    | ["-m", v, & more]: parse(more, acc ++ { "model": v })
    | ["--model", v, & more]: parse(more, acc ++ { "model": v })
    | ["--resume", v, & more]: parse(more, acc ++ { "resume": v })
    | ["--session", v, & more]: parse(more, acc ++ { "resume": v })
    | ["-c", & more]: parse(more, acc ++ { "continue": #true })
    | ["-r", & more]: parse(more, acc ++ { "pick": #true })
    | ["--fork", & more]: parse(more, acc ++ { "fork": #true })
    | ["--no-session", & more]: parse(more, acc ++ { "no_session": #true })
    | ["--name", v, & more]: parse(more, acc ++ { "name": v })
    | ["--thinking", v, & more]: parse(more, acc ++ { "thinking": v })
    | ["--list-models", & more]: parse(more, acc ++ { "list_models": #true })
    | ["--theme", v, & more]: parse(more, acc ++ { "theme": v })
    | ["--tui-mode", v, & more]: parse(more, acc ++ { "tui_mode": v })
    | ["--tools", v, & more]: parse(more, acc ++ { "tools": split_list(v) })
    | ["--exclude-tools", v, & more]: parse(more, acc ++ { "exclude_tools": split_list(v) })
    | ["--no-tools", & more]: parse(more, acc ++ { "no_tools": #true })
    | ["--system-prompt", v, & more]: parse(more, acc ++ { "system_prompt": v })
    | ["--append-system-prompt", v, & more]: parse(more, acc ++ { "append_system_prompt": v })
    | ["--no-context-files", & more]: parse(more, acc ++ { "no_context": #true })
    | ["--session-dir", v, & more]: parse(more, acc ++ { "session_dir": v })
    | ["--api-key", v, & more]: parse(more, acc ++ { "api_key": v })
    | ["-e", v, & more]: parse(more, acc ++ { "extensions": acc.get("extensions", []).add(v) })
    | ["--extension", v, & more]: parse(more, acc ++ { "extensions": acc.get("extensions", []).add(v) })
    | ["--skill", v, & more]: parse(more, acc ++ { "skills": acc.get("skills", []).add(v) })
    | ["--prompt-template", v, & more]:
        parse(more, acc ++ { "prompt_templates": acc.get("prompt_templates", []).add(v) })
    | ["--no-skills", & more]: parse(more, acc ++ { "no_skills": #true })
    | ["--no-prompt-templates", & more]: parse(more, acc ++ { "no_prompts": #true })
    | ["-a", & more]: parse(more, acc ++ { "approve": #true })
    | ["--approve", & more]: parse(more, acc ++ { "approve": #true })
    | ["-na", & more]: parse(more, acc ++ { "no_approve": #true })
    | ["--no-approve", & more]: parse(more, acc ++ { "no_approve": #true })
    | ["--export", v, & more]:
        match more
        | [o, & rest2]:
            if !o.starts_with("-")
            | parse(rest2, acc ++ { "export": v, "export_out": o })
            | parse(more, acc ++ { "export": v })
        | ~else: parse(more, acc ++ { "export": v })
    | ["--no-extensions", & more]: parse(more, acc ++ { "no_extensions": #true })
    | [a, & more]:
        cond
        | a.length() > 0 && a.substring(0..1) == "@" && filesystem.file_exists(a.substring(1..)):
            let path = a.substring(1..)
            let inlined = "\n\n``` " +& path +& "\n" +& filesystem.read_string(path) +& "\n```"
            parse(more, acc ++ { "message": acc["message"].add(inlined) })
        | a.starts_with("--"):
            // unknown long flags are kept for extensions (rho.flag("name"))
            parse(more, acc ++ { "extra": acc.get("extra", []).add(a) })
        | a.length() > 0 && a.substring(0..1) == "-":
            println("warning: ignoring argument " +& a)
            parse(more, acc)
        | ~else:
            parse(more, acc ++ { "message": acc["message"].add(a) })

def opts = parse_args()
def rpc_mode = opts.get("mode", "text") == "rpc"
def headless = opts.get("print", #false) || opts.get("mode", "text") == "json" || rpc_mode
def json_mode = opts.get("mode", "text") == "json"
def mutable project_trusted = #false
def config = load_config(~provider: opts.get("provider", #false),
                         ~model: opts.get("model", #false),
                         ~thinking: opts.get("thinking", #false))
def registry = make_registry()
install_core_tools(registry)

fun cwd() :: String:
  let s = to_string(rkt.#{current-directory}())
  if s.length() > 1 && s.substring(s.length() - 1 ..) == "/"
  | s.substring(0 .. s.length() - 1)
  | s

// ---- settings (pi-style): global + project files, project needs trust ----
fun apply_settings():
  config.settings := config.settings ++ settings.all()
  // defaults for anything the CLI didn't pin down
  when !opts.get("provider", #false)
  | match settings.get("default_provider", #false)
    | p :: String:
        when config.providers.get(p, #false)
        | config.provider := p
          when !opts.get("model", #false) && settings.get("default_model", #false) == #false
          | config.model := config.profile().get("default_model", config.model)
    | ~else: #void
  when !opts.get("model", #false)
  | match settings.get("default_model", #false)
    | m :: String: config.model := m
    | ~else: #void
  when !opts.get("thinking", #false) && config.thinking == #false
  | match settings.get("default_thinking", #false)
    | t :: String: config.thinking := t
    | ~else: #void
  match opts.get("session_dir", settings.get("session_dir", #false))
  | d :: String: set_sessions_dir(d)
  | ~else: #void

settings.reload(~include_project: trust.trust_status(cwd()) == #'trusted)
apply_settings()

match opts.get("api_key", #false)
| k :: String: set_api_key_override(k)
| ~else: #void

fun read_stdin_line() :: String:
  match rkt.#{read-line}()
  | s :: ReadableString: to_string(s).trim()
  | ~else: ""

// -r: interactive session picker before anything else starts
fun pick_session() :: maybe(String):
  let sessions = list_sessions(cwd())
  cond
  | sessions == []:
      println("no previous sessions here")
      #false
  | ~else:
      for (i in 0 .. sessions.length()):
        let s = sessions[i]
        println((i + 1) +& ". "
                  +& (if s["name"] == "" | "" | "[" +& s["name"] +& "] ")
                  +& s["preview"]
                  +& "  (" +& s["path"] +& ")")
      print("resume which? (number, empty = new) ")
      let ans = read_stdin_line()
      match String.maybe_to_int(ans)
      | n :: Int:
          if n >= 1 && n <= sessions.length()
          | sessions[n - 1]["path"]
          | #false
      | ~else: #false

def mutable session:
  start_session(~cwd: cwd(),
                ~resume: (if opts.get("pick", #false)
                          | pick_session()
                          | opts.get("resume", #false)),
                ~continue_latest: opts.get("continue", #false),
                ~fork: opts.get("fork", #false),
                ~no_session: opts.get("no_session", #false),
                ~name: opts.get("name", #false))
def api = PiAPI(registry, fun (): out, fun (): session, opts.get("extra", []))

fun context_section() :: String:
  if opts.get("no_context", #false)
  | ""
  | let files = context.gather_context_files(~cwd: cwd())
    if files == []
    | ""
    | let parts:
        for List (entry in files):
          let [path, content] = entry
          "### " +& path +& "\n\n" +& content
      "\n\n## Project context\n\n" +& String.join(parts, "\n\n")

fun default_system_prompt() :: String:
  "You are rho, a coding agent written in Rhombus, running in a terminal.\n"
    +& "Working directory: " +& cwd() +& "\n"
    +& "Use the available tools to read, write, and edit files and to run shell commands.\n"
    +& "You can extend yourself: write a Rhombus extension module exporting `init(rho)` into "
    +& project_extensions_dir() +& "/ or " +& global_extensions_dir() +& "/, "
    +& "then call the reload_extensions tool to activate it immediately.\n"
    +& "Extension template (Rhombus is indentation-sensitive; follow it exactly):\n"
    +& "```\n"
    +& "#lang rhombus\n"
    +& "export: init\n"
    +& "fun init(rho):\n"
    +& "  rho.register_tool(\n"
    +& "    ~name: \"my_tool\",\n"
    +& "    ~description: \"what it does\",\n"
    +& "    ~schema: { \"type\": \"object\",\n"
    +& "               \"properties\": { \"x\": { \"type\": \"string\" } },\n"
    +& "               \"required\": [\"x\"] },\n"
    +& "    ~fn: fun (args):\n"
    +& "           \"result: \" +& args.get(\"x\", \"\"))\n"
    +& "```\n"
    +& "Also available: rho.register_command(~name, ~description, ~handler), "
    +& "rho.on(event, fn) for events (tool_call may return {\"block\": #true, \"reason\": ...}), "
    +& "rho.state (a mutable map that survives reloads), rho.notify(msg).\n"
    +& "Shorthand: `import: lib(\"rho/src/ext/tool.rhm\") open` provides a `tool` macro:\n"
    +& "  tool rho greet(name :: String, times :: Int = 1) ~desc \"Greet\":\n"
    +& "    \"Hello \" +& name\n"
    +& "which derives the JSON schema from the annotations (defaults become optional).\n"
    +& "Be concise. Prefer tools over guessing."

// --skill / --prompt-template survive --no-skills / --no-prompt-templates
fun discover_skills() :: List:
  skills.discover(~cwd: cwd(),
                  ~extra: packages.package_skill_dirs(),
                  ~include_project: project_trusted,
                  ~direct: opts.get("skills", []),
                  ~standard: !opts.get("no_skills", #false))

fun discover_prompts() :: List:
  prompts.discover(~cwd: cwd(),
                   ~extra: packages.package_prompt_dirs(),
                   ~include_project: project_trusted,
                   ~direct: opts.get("prompt_templates", []),
                   ~standard: !opts.get("no_prompts", #false))

fun system_prompt() :: String:
  context.resolve_system_prompt(~default_prompt: default_system_prompt(),
                                ~override_text: opts.get("system_prompt", #false),
                                ~append_text: opts.get("append_system_prompt", #false),
                                ~cwd: cwd())
    +& context_section()
    +& skills.xml_section(discover_skills())

// ---- tool filters ----
// pi defaults: read/bash/edit/write on; grep/find/ls opt-in via --tools
def optin_tools :: List = ["grep", "find", "ls"]

fun apply_tool_filters():
  cond
  | opts.get("no_tools", #false):
      registry.set_tool_filter(~allow: [])
  | ~else:
      let allow = opts.get("tools", #false)
      let enabled = settings.get("default_tools", [])
      let default_deny:
        cond
        | allow is_a List: []      // explicit allowlist: user decides
        | ~else:
            for List (t in optin_tools):
              skip_when enabled is_a List && enabled.contains(t)
              t
      registry.set_tool_filter(~allow: allow,
                               ~deny: opts.get("exclude_tools", []) ++ default_deny)

// ---- built-in commands ----
fun show_help(_args):
  out.write_string("commands:\n")
  for (c in registry.command_list()):
    out.write_string("  /" +& c.name +& "  \u2014 " +& c.description +& "\n")
  out.write_string("tools:\n")
  for (t in registry.tool_list()):
    out.write_string("  " +& t.name +& " [" +& t.source +& "]\n")

fun do_reload(notify = #true):
  settings.reload(~include_project: project_trusted)
  apply_settings()
  let [ok, failed] = loader.load_extensions(registry, api,
                                            ~notify: fun (s): api.notify(s),
                                            ~extra_dirs:
                                              packages.package_extension_dirs()
                                                ++ opts.get("extensions", []),
                                            ~include_project: project_trusted)
  when notify
  | api.notify("extensions: " +& ok +& " loaded, " +& failed +& " failed")

// ---- /settings: list, show, set (persisted to ~/.rho/settings.json) ----
fun settings_value_str(key :: String) :: String:
  match settings.get(key, #false)
  | #false: "(unset)"
  | #true: "true"
  | l :: List: String.join((for List (x in l): to_string(x)), ",")
  | v: to_string(v)

// returns [#'ok, value] or [#'err, message]
fun parse_setting(key :: String, raw :: String) :: List:
  let spec = settings.known_keys.get(key, #false)
  let kind = (if spec is_a List | spec[1] | "string")
  cond
  | kind == "int":
      match String.maybe_to_int(raw)
      | n :: Int: [#'ok, n]
      | ~else: [#'err, key +& " expects a number"]
  | kind == "bool":
      cond
      | ["true", "on", "yes", "1"].contains(raw.foldcase()): [#'ok, #true]
      | ["false", "off", "no", "0"].contains(raw.foldcase()): [#'ok, #false]
      | ~else: [#'err, key +& " expects true/false"]
  | kind == "list":
      [#'ok,
       for List (s in raw.split(",")):
         skip_when s.trim() == ""
         s.trim()]
  | kind is_a List:
      if kind.contains(raw)
      | [#'ok, raw]
      | [#'err, key +& " expects one of " +& String.join(kind, "|")]
  | ~else: [#'ok, raw]

registry.register_command(
  ~name: "settings",
  ~description: "show or change settings: /settings [key [value]]",
  ~handler: fun (args):
              let parts = args.trim().split(" ")
              cond
              | args.trim() == "":
                  for (key in settings.known_keys.keys().sort()):
                    let [desc, _] = settings.known_keys[key]
                    out.write_string("  " +& key +& " = " +& settings_value_str(key)
                                       +& "  \u2014 " +& desc +& "\n")
              | parts.length() == 1:
                  let key = to_string(parts[0])
                  match settings.known_keys.get(key, #false)
                  | [desc, _]:
                      api.notify(key +& " = " +& settings_value_str(key) +& "  \u2014 " +& desc)
                  | ~else: api.notify("unknown setting: " +& key)
              | ~else:
                  let key = to_string(parts[0])
                  let raw = String.join(parts.rest, " ").trim()
                  cond
                  | settings.known_keys.get(key, #false) == #false:
                      api.notify("unknown setting: " +& key)
                  | ~else:
                      match parse_setting(key, raw)
                      | [#'err, msg]: api.notify("error: " +& msg)
                      | [#'ok, v]:
                          settings.set_global(key, v)
                          apply_settings()
                          apply_tool_filters()
                          api.notify(key +& " = " +& settings_value_str(key)))

registry.register_command(
  ~name: "help", ~description: "list commands and tools",
  ~handler: show_help)
registry.register_command(
  ~name: "reload", ~description: "hot-reload extensions (picks up changed files)",
  ~handler: fun (_args): do_reload())
// ---- model availability (pi-ai style: models.dev catalog + env API keys) ----

// rho provider name -> models.dev catalog id for its model list
def modelsdev_alias :: Map:
  { "kimi": "moonshotai", "kimi-anthropic": "moonshotai" }

fun env_ok(env_name :: String) :: Boolean:
  env_name == ""
    || (block:
          let v = envvar.getenv(env_name)
          v is_a String && v != "")

// [provider_name, models_map] for every provider usable right now:
// configured rho providers with their key set, plus models.dev providers
// (supported protocol + env key present) not shadowed by a configured one.
fun available_provider_groups() :: List:
  let cat = modelsdev.catalog()
  let configured:
    for List:
      each pname in config.providers.keys().sort()
      let prof = config.providers[pname]
      skip_when !env_ok(to_string(prof.get("api_key_env", "")))
      let src = modelsdev_alias.get(pname, pname)
      let mdls:
        let p = cat.get(src, #false)
        let ms = (if p is_a Map | p.get("models", {}) | {})
        if ms is_a Map && ms.keys().length() > 0
        | ms
        | { to_string(prof.get("default_model", "")): {} }
      [to_string(pname), mdls]
  let dev_only:
    for List:
      each entry in modelsdev.available_providers()
      let [id, _prof, mdls] = entry
      skip_when config.providers.get(id, #false)
      skip_when mdls.keys().length() == 0
      [id, mdls]
  configured ++ dev_only

fun model_desc(m) :: String:
  cond
  | m is_a Map && m.keys().length() > 0:
      let cost = m.get("cost", {})
      let cost = (if cost is_a Map | cost | {})
      let limit = m.get("limit", {})
      let limit = (if limit is_a Map | limit | {})
      "ctx " +& limit.get("context", "?")
        +& " \u00B7 $" +& cost.get("input", 0) +& "/$" +& cost.get("output", 0)
        +& (if m.get("reasoning", #false) == #true | " \u00B7 thinking" | "")
  | ~else: ""

// ["provider/model", description] pairs for menus and --list-models
fun available_model_entries() :: List:
  for List:
    each group in available_provider_groups()
    let [pname, mdls] = group
    each mid in mdls.keys().sort()
    skip_when to_string(mid) == ""
    [pname +& "/" +& mid, model_desc(mdls.get(mid, #false))]

// Switch model, optionally crossing providers ("provider/model").
// Unknown models.dev providers with a supported protocol are registered
// into the live config on the fly.
fun set_model(arg :: String) :: String:
  let slash:
    for values(found = #false) (i in 0 .. arg.length()):
      found || (arg[i] == Char"/" && i)
  cond
  | slash is_a Int:
      let p = arg.substring(0 .. slash)
      let m = arg.substring(slash + 1 ..)
      cond
      | config.providers.get(p, #false):
          config.provider := p
          config.model := m
          "provider=" +& p +& " model=" +& m
      | ~else:
          let entry = modelsdev.catalog().get(p, #false)
          let prof = (if entry is_a Map | modelsdev.provider_profile(entry) | #false)
          cond
          | prof is_a Map:
              config.register_provider(p, prof)
              config.provider := p
              config.model := m
              "provider=" +& p +& " model=" +& m
          | ~else:
              // the model id itself contains "/" (e.g. openrouter ids)
              config.model := arg
              "model set to " +& arg
  | ~else:
      config.model := arg
      "model set to " +& arg

registry.register_command(
  ~name: "model", ~description: "switch model: /model [provider/model | name]",
  ~handler: fun (args):
              if args == ""
              | api.notify("provider=" +& config.provider +& " model=" +& config.model)
              | api.notify(set_model(args.trim())))
registry.register_command(
  ~name: "provider", ~description: "switch provider: /provider [name]",
  ~handler: fun (args):
              cond
              | args == "":
                  let avail:
                    for List (g in available_provider_groups()): g[0]
                  api.notify("provider=" +& config.provider
                               +& " (available: " +& String.join(avail, ", ") +& ")")
              | config.providers.has_key(args):
                  config.provider := args
                  config.model := config.profile().get("default_model", config.model)
                  api.notify("switched to " +& args +& " model=" +& config.model)
              | ~else:
                  match modelsdev.catalog().get(args, #false)
                  | entry :: Map:
                      match modelsdev.provider_profile(entry)
                      | prof :: Map:
                          config.register_provider(args, prof)
                          config.provider := args
                          config.model := ""
                          api.notify("switched to " +& args +& "; pick a model with /model")
                      | ~else: api.notify("provider " +& args +& " uses an unsupported protocol")
                  | ~else: api.notify("unknown provider: " +& args))
// ---- usage accounting ----
fun usage_totals() :: Map:
  for values(acc :: Map = { "input": 0, "output": 0, "cache_read": 0, "cost": 0.0 }) (m in session.messages()):
    skip_when m.get("role", "") != "assistant"
    let u = m.get("usage", {})
    skip_when !(u is_a Map) || u == {}
    { "input": acc["input"] + u.get("input", 0),
      "output": acc["output"] + u.get("output", 0),
      "cache_read": acc["cache_read"] + u.get("cache_read", 0),
      "cost": acc["cost"] + models.cost_of(config.model, u) }

fun round2(x) :: String:
  let cents = math.round(x * 10000)
  to_string(cents / 10000.0)

fun usage_line() :: String:
  let t = usage_totals()
  let info = models.model_info(config.model)
  "tokens: in=" +& t["input"] +& " out=" +& t["output"]
    +& " cached=" +& t["cache_read"]
    +& " cost=$" +& round2(t["cost"])
    +& " ctx-window=" +& info["context_window"]

fun list_models():
  match available_model_entries()
  | []:
      println("no models available: set an API key (e.g. KIMI_API_KEY,")
      println("ANTHROPIC_API_KEY, OPENAI_API_KEY ...) and rerun; the model")
      println("catalog (models.dev) downloads in the background on first run")
  | entries:
      for (entry in entries):
        let [full, desc] = entry
        println(full +& (if desc == "" | "" | "  " +& desc))

registry.register_command(
  ~name: "session", ~description: "show session file, entry count, token usage",
  ~handler: fun (_args):
              api.notify((if session.path is_a String | session.path | "(no session file)")
                           +& " (" +& session.entries.length() +& " entries)"
                           +& (if session.name == "" | "" | " name=" +& session.name))
              api.notify(usage_line()))
registry.register_command(
  ~name: "clear", ~description: "start a new branch from the root (history kept in tree)",
  ~handler: fun (_args):
              session.clear()
              api.notify("history cleared (old branch kept; see /tree)"))

// ---- session tree commands ----
fun snippet(s :: String) :: String:
  let one = String.join(s.split("\n"), " ")
  if one.length() > 56 | one.substring(0..56) +& "\u2026" | one

fun entry_label(e :: Map) :: String:
  match e["kind"]
  | "message":
      let m = e["data"]
      let role = m.get("role", "?")
      cond
      | role == "assistant" && m.get("tool_calls", []) != []:
          let names = (for List (tc in m["tool_calls"]): tc["name"])
          "assistant \u2699 " +& String.join(names, ",") +& " " +& snippet(m.get("content", ""))
      | ~else: role +& ": " +& snippet(m.get("content", ""))
  | "compaction": "[compaction] " +& snippet(e["data"].get("summary", ""))
  | "meta": "[meta " +& e["data"].get("event", "") +& "]"
  | k: "[" +& k +& "]"

fun show_tree(_args):
  let active:
    for values(s :: Set = Set()) (e in session.path_entries()):
      s ++ { e["id"] }
  for (e in session.entries):
    let depth:
      recur count(id = e.get("parent", #'null), n = 0):
        match session.entry(if id is_a Int | id | -1)
        | p :: Map: count(p.get("parent", #'null), n + 1)
        | ~else: n
    let marker = (if active.contains(e["id"]) | "*" | " ")
    out.write_string(marker +& " " +& e["id"] +& " "
                       +& String.make(depth * 2, Char" ")
                       +& entry_label(e) +& "\n")
  out.write_string("use /tree <id> to move the active leaf\n")

registry.register_command(
  ~name: "tree", ~description: "show session tree; /tree <id> jumps to an entry",
  ~handler: fun (args):
              match String.maybe_to_int(args.trim())
              | n :: Int:
                  session.set_leaf(n)
                  api.notify("leaf moved to " +& n)
              | ~else: show_tree(args))

registry.register_command(
  ~name: "fork", ~description: "branch from a previous user message: /fork [id]",
  ~handler: fun (args):
              let target:
                match String.maybe_to_int(args.trim())
                | n :: Int: session.entry(n)
                | ~else:
                    // last user message on the active path
                    for values(found = #false) (e in session.path_entries()):
                      if e["kind"] == "message" && e["data"].get("role", "") == "user"
                      | e
                      | found
              cond
              | !target: api.notify("no user message to fork from")
              | ~else:
                  let parent = target.get("parent", #'null)
                  session.set_leaf(if parent is_a Int | parent | #false)
                  when target["kind"] == "message"
                  | add_history(target["data"].get("content", ""))
                  api.notify("forked before entry " +& target["id"]
                               +& "; press \u2191 to edit the original message"))

registry.register_command(
  ~name: "new", ~description: "start a fresh session file",
  ~handler: fun (_args):
              session := start_session(~cwd: cwd())
              api.notify("new session: " +& session.path))

registry.register_command(
  ~name: "name", ~description: "name this session: /name <name>",
  ~handler: fun (args):
              if args.trim() == ""
              | api.notify("name: " +& (if session.name == "" | "(none)" | session.name))
              | session.set_name(args.trim())
                api.notify("session named " +& args.trim()))

registry.register_command(
  ~name: "clone", ~description: "copy this session to a new file and switch to it",
  ~handler: fun (_args):
              cond
              | !(session.path is_a String): api.notify("no session file to clone")
              | ~else:
                  session := start_session(~cwd: cwd(), ~resume: session.path, ~fork: #true)
                  api.notify("cloned into " +& session.path))

registry.register_command(
  ~name: "resume", ~description: "pick a previous session in this directory",
  ~handler: fun (_args):
              match pick_session()
              | path :: String:
                  session := start_session(~cwd: cwd(), ~resume: path)
                  api.notify("resumed " +& path)
              | ~else: api.notify("unchanged"))

fun export_html(target :: String):
  let parts:
    for List (e in session.path_entries()):
      skip_when e["kind"] != "message"
      let m = e["data"]
      let role = m.get("role", "?")
      let body = html_escape(m.get("content", ""))
      let tools:
        for List (tc in m.get("tool_calls", [])):
          "<div class=tool>\u2699 " +& html_escape(tc["name"]) +& " "
            +& html_escape(tc["arguments"]) +& "</div>"
      "<div class=" +& role +& "><b>" +& role +& "</b><pre>" +& body +& "</pre>"
        +& String.join(tools, "") +& "</div>"
  let doc:
    "<!doctype html><meta charset=utf-8><title>rho session</title>"
      +& "<style>body{font-family:sans-serif;max-width:52em;margin:2em auto}"
      +& "pre{white-space:pre-wrap}div{margin:1em 0;padding:.5em 1em;border-radius:8px}"
      +& ".user{background:#eef}.assistant{background:#f7f7f7}.tool{color:#666;font-size:90%}"
      +& ".system{background:#ffe}</style>"
      +& String.join(parts, "\n")
  filesystem.write_string(target, doc, ~exists: #'truncate)

// --export <in> [out]: convert a session file to HTML and exit
fun run_export_mode():
  let src = to_string(opts["export"])
  cond
  | !filesystem.file_exists(src):
      println("error: session file not found: " +& src)
  | ~else:
      session := start_session(~cwd: cwd(), ~resume: src)
      let target:
        match opts.get("export_out", #false)
        | o :: String: o
        | ~else:
            (if src.ends_with(".jsonl") | src.substring(0 .. src.length() - 6) | src)
              +& ".html"
      export_html(target)
      println("exported " +& target)

fun html_escape(s :: String) :: String:
  let s = String.join(s.split("&"), "&amp;")
  let s = String.join(s.split("<"), "&lt;")
  String.join(s.split(">"), "&gt;")

registry.register_command(
  ~name: "export", ~description: "export session: /export [file.html|file.jsonl]",
  ~handler: fun (args):
              let target = (if args.trim() == "" | "session-export.html" | args.trim())
              cond
              | target.ends_with(".jsonl"):
                  cond
                  | session.path is_a String:
                      filesystem.write_string(target, filesystem.read_string(session.path),
                                              ~exists: #'truncate)
                      api.notify("exported " +& target)
                  | ~else: api.notify("no session file")
              | ~else:
                  export_html(target)
                  api.notify("exported " +& target))

registry.register_command(
  ~name: "import", ~description: "import a session file: /import <file.jsonl>",
  ~handler: fun (args):
              let src = args.trim()
              cond
              | !filesystem.file_exists(src): api.notify("no such file: " +& src)
              | ~else:
                  let dir = session_dir_for(cwd())
                  when !filesystem.directory_exists(dir)
                  | filesystem.make_directory(dir, ~parents: #true)
                  let dest = dir +& "/imported-" +& rkt.#{current-seconds}() +& ".jsonl"
                  filesystem.write_string(dest, filesystem.read_string(src),
                                          ~exists: #'truncate)
                  session := start_session(~cwd: cwd(), ~resume: dest)
                  api.notify("imported into " +& dest))
registry.register_command(
  ~name: "share", ~description: "upload the session as a GitHub gist (needs gh CLI)",
  ~handler: fun (_args):
              cond
              | !(session.path is_a String): api.notify("no session file to share")
              | ~else:
                  let tool = registry.tools.get("bash", #false)
                  let cmd = "gh gist create '" +& session.path +& "' --desc 'rho session' 2>&1 || echo 'gh CLI unavailable or failed'"
                  if tool
                  | api.notify(to_string(tool.fn({ "command": cmd })))
                  | api.notify("bash tool unavailable"))
registry.register_command(
  ~name: "packages", ~description: "list installed packages (rho install/remove to manage)",
  ~handler: fun (_args):
              match packages.installed()
              | []: api.notify("no packages installed (rho install <git-url|owner/repo>)")
              | ps:
                  for (p in ps):
                    out.write_string("  " +& p +& " (" +& packages.packages_dir() +& "/" +& p +& ")\n"))
registry.register_command(
  ~name: "compact", ~description: "summarize old turns to shrink context: /compact [instructions]",
  ~handler: fun (args):
              api.notify("compacting\u2026")
              api.notify(compaction.compact(~session: session, ~config: config,
                                            ~instructions: args.trim())))
registry.register_command(
  ~name: "quit", ~description: "exit",
  ~handler: fun (_args): #'quit)

// ---- credentials: /login /logout (~/.rho/auth.json, chmod 600) ----
registry.register_command(
  ~name: "login",
  ~description: "store an API key: /login <provider> [key] (key prompted if omitted)",
  ~handler: fun (args):
              let parts = args.trim().split(" ")
              cond
              | args.trim() == "":
                  match auth_list()
                  | []: api.notify("no stored credentials; /login <provider> [key]")
                  | ps: api.notify("stored credentials: " +& String.join(ps, ", "))
              | ~else:
                  let prov = to_string(parts[0])
                  let key:
                    if parts.length() > 1
                    | String.join(parts.rest, " ").trim()
                    | api.ui.input("API key for " +& prov +& ":")
                  if key == ""
                  | api.notify("cancelled (empty key)")
                  | auth_set(prov, key)
                    api.notify("saved key for " +& prov +& " in ~/.rho/auth.json"))

registry.register_command(
  ~name: "logout",
  ~description: "remove a stored API key: /logout <provider>",
  ~handler: fun (args):
              let prov = args.trim()
              cond
              | prov == "": api.notify("usage: /logout <provider>")
              | auth_remove(prov): api.notify("removed key for " +& prov)
              | ~else: api.notify("no stored key for " +& prov))

fun auto_compact():
  when compaction.needs_compaction(session, config)
  | api.notify("context is near the window limit; compacting\u2026")
    api.notify(compaction.compact(~session: session, ~config: config))

// Also expose reload as a tool so the agent can activate its own extensions.
registry.register_tool(
  ~name: "reload_extensions",
  ~description: "Hot-reload agent extensions from the extension directories. Call after writing or editing an extension file to activate it.",
  ~schema: { "type": "object", "properties": {}, "required": [] },
  ~fn: fun (_args):
         let [ok, failed] = loader.load_extensions(registry, api,
                                                   ~notify: fun (s): api.notify(s),
                                                   ~extra_dirs: packages.package_extension_dirs(),
                                                   ~include_project: project_trusted)
         "extensions reloaded: " +& ok +& " ok, " +& failed +& " failed")

// ---- skills & prompt templates ----
registry.register_command(
  ~name: "skills", ~description: "list discovered skills",
  ~handler: fun (_args):
              let found = discover_skills()
              if found == []
              | api.notify("no skills found (put SKILL.md dirs in .rho/skills or ~/.rho/skills)")
              | for (s in found):
                  out.write_string("  " +& s["name"] +& " \u2014 " +& s["description"]
                                     +& " (" +& s["path"] +& ")\n"))
registry.register_command(
  ~name: "prompts", ~description: "list prompt templates (run one with /<name>)",
  ~handler: fun (_args):
              let found = discover_prompts()
              if found == []
              | api.notify("no templates found (put .md files in .rho/prompts or ~/.rho/prompts)")
              | for (t in found):
                  out.write_string("  /" +& t["name"]
                                     +& (if t["argument_hint"] == "" | "" | " " +& t["argument_hint"])
                                     +& " \u2014 " +& t["description"] +& "\n"))

// ---- wire up ----
fun handle_command(name :: String, args :: String):
  match registry.find_command(name)
  | c :: Command: c.handler(args)
  | ~else:
      cond
      | name.starts_with("skill:"):
          let sname = name.substring(6..)
          match skills.find_skill(sname, ~cwd: cwd(),
                                  ~extra: packages.package_skill_dirs(),
                                  ~include_project: project_trusted)
          | s :: Map:
              let content = filesystem.read_string(s["path"])
              handle_input("Load and follow this skill now.\n\n<skill source=\""
                             +& s["path"] +& "\">\n" +& content +& "\n</skill>"
                             +& (if args.trim() == "" | "" | "\n\nTask: " +& args))
          | ~else: api.notify("unknown skill: " +& sname +& " (see /skills)")
      | ~else:
          match prompts.find_template(name, ~cwd: cwd(),
                                      ~extra: packages.package_prompt_dirs(),
                                      ~include_project: project_trusted)
          | t :: Map: handle_input(prompts.expand(t, args))
          | ~else: api.notify("unknown command: /" +& name +& " (try /help)")

fun handle_input(input :: String):
  run_turn(~config: config,
           ~registry: registry,
           ~session: session,
           ~system_prompt: system_prompt(),
           ~input: input,
           ~on_text: fun (s):
                       out.write_string(s)
                       out.flush(),
           ~on_tool: fun (name, args):
                       out.write_string("\n" +& color("2", "\u25CF " +& name +& " "
                                                        +& summarize(args)) +& "\n")
                       out.flush(),
           ~on_tool_result: fun (name, r):
                              out.write_string(color("2", "  \u21B3 " +& first_line(r)) +& "\n")
                              out.flush(),
           ~on_steer: fun (s):
                        out.write_string(color("33", "\u21AA steering: " +& s) +& "\n")
                        out.flush())
  out.write_string("\n")
  auto_compact()

fun summarize(args :: Map) :: String:
  let s = to_string(args)
  if s.length() > 80 | s.substring(0..80) +& "\u2026" | s

fun first_line(s :: String) :: String:
  let lines = s.split("\n")
  cond
  | lines == []: ""
  | lines.length() == 1: to_string(lines[0])
  | ~else: to_string(lines[0]) +& " \u2026"

def banner:
  if settings.get("quiet_startup", #false) == #true
  | ""
  | color("1;35", "rho") +& " \u2014 hot-reloadable Rhombus coding agent\n"
      +& "provider=" +& config.provider +& " model=" +& config.model
      +& " ctx-window=" +& models.model_info(config.model)["context_window"] +& "\n"
      +& "session=" +& (if session.path is_a String | session.path | "(none)")
      +& (if session.entries.length() > 1
          | " (" +& session.entries.length() +& " entries resumed)"
          | "")
      +& "\n"
      +& "type /help for commands\n\n"

// ---- headless mode ----
fun emit_json(m :: Map):
  out.write_string(json.to_string(m) +& "\n")
  out.flush()

fun stdin_text() :: String:
  let stdin = rkt.#{current-input-port}()
  if rkt.#{terminal-port?}(stdin)
  | ""
  | to_string(rktport.#{port->string}(stdin))

fun headless_prompt() :: String:
  let msg = String.join(opts["message"], " ")
  let piped = stdin_text()
  cond
  | piped == "": msg
  | msg == "": piped
  | ~else: msg +& "\n\n" +& piped

fun run_headless():
  let input = headless_prompt()
  when input.trim() == ""
  | println("error: no prompt (pass a message argument or pipe stdin)")
    rkt.exit(1)
  when json_mode
  | emit_json({ "type": "session_start",
                "session": (if session.path is_a String | session.path | ""),
                "provider": config.provider, "model": config.model })
  run_turn(~config: config,
           ~registry: registry,
           ~session: session,
           ~system_prompt: system_prompt(),
           ~input: input,
           ~on_text:
             if json_mode
             | fun (s): emit_json({ "type": "text", "text": s })
             | fun (s):
                 out.write_string(s)
                 out.flush(),
           ~on_tool:
             if json_mode
             | fun (name, args): emit_json({ "type": "tool_call", "name": name, "args": args })
             | fun (name, args): #void,
           ~on_tool_result:
             if json_mode
             | fun (name, r): emit_json({ "type": "tool_result", "name": name, "result": r })
             | fun (name, r): #void)
  if json_mode
  | emit_json({ "type": "done",
                "session": (if session.path is_a String | session.path | "") })
  | out.write_string("\n")

// ---- TUI mode ----
fun load_theme() :: Map:
  match opts.get("theme", config.settings.get("theme", #false))
  | name :: String:
      let path = config_dir() +& "/themes/" +& name +& ".json"
      if filesystem.file_exists(path)
      | let parsed = try:
                       json.from_string(filesystem.read_string(path))
                       ~catch _: {}
        if parsed is_a Map | parsed | {}
      | (block:
           println("warning: theme not found: " +& path)
           {})
  | ~else: {}

fun renderer_for(name :: String):
  match registry.state.get("tool_renderers", #false)
  | m :: MutableMap: m.get(name, #false)
  | ~else: #false

fun render_tool(phase :: String, name :: String, data) :: maybe(String):
  let fn = renderer_for(name)
  if fn
  | try:
      let r = fn(phase, name, data)
      if r is_a String | r | #false
      ~catch _: #false
  | #false

fun tui_footer() :: String:
  let t = usage_totals()
  " " +& cwd() +& "  \u2502 " +& config.provider +& "/" +& config.model
    +& "  \u2502 tok " +& t["input"] +& "/" +& t["output"]
    +& " $" +& round2(t["cost"])
    +& (if session.name == "" | "" | "  \u2502 " +& session.name)

def provider_ring = ["kimi", "kimi-anthropic", "openai", "anthropic", "openrouter", "ollama"]

fun cycle_model() :: String:
  let avail:
    for List (p in provider_ring):
      skip_when !config.providers.has_key(p)
      p
  let idx:
    for values(found = 0) (i in 0 .. avail.length()):
      if avail[i] == config.provider | i | found
  let next = avail[(idx + 1) mod avail.length()]
  config.provider := next
  config.model := config.providers[next].get("default_model", config.model)
  "model: " +& config.provider +& "/" +& config.model

fun tui_shell(text :: String) :: String:
  let double = text.starts_with("!!")
  let cmd = text.substring(if double | 2 | 1 ..).trim()
  let tool = registry.tools.get("bash", #false)
  cond
  | cmd == "": "(empty command)"
  | !tool: "(bash tool unavailable)"
  | ~else:
      let result = to_string(tool.fn({ "command": cmd }))
      when double
      | session.append_message({ "role": "user",
                                 "content": "I ran `" +& cmd +& "` and got:\n" +& result })
      result

fun handle_input_tui(input :: String):
  run_turn(~config: config,
           ~registry: registry,
           ~session: session,
           ~system_prompt: system_prompt(),
           ~input: input,
           ~on_text: fun (s):
                       tui.set_activity("responding")
                       tui.push_delta(s),
           ~on_tool: fun (name, args):
                       tui.set_activity("tool: " +& name)
                       tui.push("tool",
                                render_tool("call", name, args)
                                  || "\u25CF " +& name +& " " +& summarize(args)),
           ~on_tool_result: fun (name, r):
                              tui.set_activity("thinking")
                              tui.push("tool_result",
                                       render_tool("result", name, r)
                                         || "  \u21B3 " +& first_line(r)))
  auto_compact()

registry.register_command(
  ~name: "hotkeys", ~description: "list TUI keyboard shortcuts",
  ~handler: fun (_args):
              out.write_string("Enter submit \u00B7 Ctrl-J newline \u00B7 Tab complete path (@token fuzzy)\n"
                                 +& "Up/Down history or cursor \u00B7 PgUp/PgDn or mouse wheel scroll (Shift+drag to select text)\n"
                                 +& "Ctrl-C interrupt/clear/quit\n"
                                 +& "Esc interrupt turn \u00B7 Ctrl-P cycle provider \u00B7 Ctrl-L redraw \u00B7 Ctrl-D quit\n"
                                 +& "!cmd run shell \u00B7 !!cmd run shell + add to context \u00B7 /follow queue follow-up\n"))

// command menu entries: registered commands + prompt templates + quit/exit
fun tui_commands() :: List:
  (for List (c in registry.command_list()): [c.name, c.description])
    ++ (for List (t in discover_prompts()):
          [t["name"], "(prompt) " +& t["description"]])
    ++ [["quit", "exit rho"], ["exit", "exit rho"]]

// argument completions for /model and /provider (available = API key set)
fun tui_arg_complete(cmd :: String, prefix :: String):
  cond
  | cmd == "model":
      let lp = prefix.foldcase()
      for List:
        each entry in available_model_entries()
        let [full, desc] = entry
        skip_when !full.foldcase().contains(lp)
        [full, full, desc]
  | cmd == "provider":
      let lp = prefix.foldcase()
      for List:
        each group in available_provider_groups()
        let [pname, mdls] = group
        skip_when !pname.foldcase().contains(lp)
        [pname, pname, mdls.keys().length() +& " models"]
  | cmd == "settings":
      let parts = prefix.split(" ")
      cond
      | parts.length() <= 1:
          let lp = prefix.foldcase()
          for List:
            each key in settings.known_keys.keys().sort()
            skip_when !key.foldcase().contains(lp)
            let [desc, _] = settings.known_keys[key]
            [to_string(key), to_string(key), to_string(desc)]
      | ~else:
          let key = to_string(parts[0])
          let vp = to_string(parts[parts.length() - 1]).foldcase()
          let spec = settings.known_keys.get(key, #false)
          let choices:
            match (if spec is_a List | spec[1] | #false)
            | l :: List: l
            | "bool": ["true", "false"]
            | ~else: []
          for List:
            each c in choices
            skip_when !to_string(c).foldcase().starts_with(vp)
            [key +& " " +& c, to_string(c), ""]
  | ~else: #false

fun run_tui_mode():
  // live bash output: show the latest line on the TUI status row
  set_stream_handler(fun (line):
                       let l = to_string(line)
                       let shown = (if l.length() > 60 | l.substring(0 .. 60) +& "\u2026" | l)
                       tui.set_activity("bash: " +& shown))
  // route notify/command prints into the TUI transcript
  let (pin, pout) = rkt.#{make-pipe}()
  out := pout
  rkt.thread(fun ():
               recur go():
                 match rkt.#{read-line}(pin, #'any)
                 | s :: ReadableString:
                     tui.push("notify", to_string(s))
                     go()
                 | ~else: #void)
  tui.run_tui(~theme: load_theme(),
              ~banner: banner +& "TUI: type / for the command menu, /hotkeys for keys\n",
              ~handle_command: handle_command,
              ~handle_input: handle_input_tui,
              ~footer: tui_footer,
              ~cycle_model: cycle_model,
              ~shell_exec: tui_shell,
              ~commands: tui_commands,
              ~arg_complete: tui_arg_complete)

fun stdin_is_tty():
  rkt.#{terminal-port?}(rkt.#{current-input-port}())

// ---- project trust ----
fun ensure_trust() :: Boolean:
  cond
  | opts.get("approve", #false): #true       // -a: one-shot trust, not saved
  | opts.get("no_approve", #false): #false   // -na: one-shot distrust
  | !filesystem.directory_exists(cwd() +& "/.rho"): #true
  | ~else:
      match trust.trust_status(cwd())
      | #'trusted: #true
      | #'untrusted: #false
      | ~else:
          cond
          | headless || !stdin_is_tty():
              config.settings.get("default_project_trust", "ignore") == "trust"
          | ~else:
              out.write_string("This project has a .rho/ directory (extensions, skills, prompts).\n"
                                 +& "Trust it? Its code will run inside the agent. [y/N] ")
              out.flush()
              let ans = read_stdin_line()
              let yes = ans.starts_with("y") || ans.starts_with("Y")
              trust.set_trust(cwd(), yes)
              api.notify(if yes | "project trusted (saved)" | "project ignored (saved)")
              yes

fun init_trust():
  project_trusted := ensure_trust()
  // a just-approved project unlocks its .rho/settings.json
  when project_trusted
  | settings.reload(~include_project: #true)
    apply_settings()

// ---- RPC mode: JSON lines over stdin/stdout ----
fun run_rpc():
  def mutable turn_t = #false
  fun turn_running():
    turn_t && !rkt.#{thread-dead?}(turn_t)
  emit_json({ "type": "ready",
              "session": (if session.path is_a String | session.path | ""),
              "provider": config.provider, "model": config.model })
  recur loop():
    match rkt.#{read-line}(rkt.#{current-input-port}(), #'any)
    | s :: ReadableString:
        let req = try:
                    json.from_string(to_string(s))
                    ~catch _: {}
        let req = (if req is_a Map | req | {})
        match req.get("type", "")
        | "prompt":
            cond
            | turn_running():
                emit_json({ "type": "error", "message": "turn already running (use steer)" })
            | ~else:
                let msg = to_string(req.get("message", ""))
                let t:
                  rkt.thread(fun ():
                               try:
                                 run_turn(~config: config,
                                          ~registry: registry,
                                          ~session: session,
                                          ~system_prompt: system_prompt(),
                                          ~input: msg,
                                          ~on_text: fun (x): emit_json({ "type": "text", "text": x }),
                                          ~on_tool: fun (name, args):
                                                      emit_json({ "type": "tool_call", "name": name, "args": args }),
                                          ~on_tool_result: fun (name, r):
                                                             emit_json({ "type": "tool_result", "name": name, "result": r }),
                                          ~on_steer: fun (x): emit_json({ "type": "steering_applied", "message": x }))
                                 emit_json({ "type": "done" })
                                 ~catch:
                                 | e :: Exn.Break: emit_json({ "type": "aborted" })
                                 | e :: Exn.Fail: emit_json({ "type": "error", "message": e.message }))
                turn_t := t
            loop()
        | "steer":
            if turn_running()
            | rkt.#{thread-send}(turn_t, to_string(req.get("message", "")))
              emit_json({ "type": "steering_queued" })
            | emit_json({ "type": "error", "message": "no turn running" })
            loop()
        | "abort":
            when turn_running()
            | rkt.#{break-thread}(turn_t)
              rkt.#{thread-wait}(turn_t)
            emit_json({ "type": "aborted" })
            loop()
        | "quit":
            when turn_running()
            | rkt.#{break-thread}(turn_t)
              rkt.#{thread-wait}(turn_t)
            emit_json({ "type": "bye" })
        | t:
            emit_json({ "type": "error", "message": "unknown request type: " +& t })
            loop()
    | ~else:
        when turn_running()
        | rkt.#{thread-wait}(turn_t)

// ---- package subcommands: rho install <spec> / rho remove <name> / rho list ----
fun try_subcommand() :: Boolean:
  match opts["message"]
  | ["install", spec]:
      println(packages.install(to_string(spec)))
      #true
  | ["remove", name]:
      println(packages.remove(to_string(name)))
      #true
  | ["update"]:
      match packages.installed()
      | []: println("no packages installed")
      | ps:
          for (p in ps):
            println(packages.update(to_string(p)))
      #true
  | ["update", name]:
      println(packages.update(to_string(name)))
      #true
  | ["list"]:
      match packages.installed()
      | []: println("no packages installed")
      | ps:
          for (p in ps):
            println(p +& "  (" +& packages.packages_dir() +& "/" +& p +& ")")
      #true
  | ~else: #false

module main:
  modelsdev.refresh_async()
  cond
  | opts.get("export", #false) is_a String:
      run_export_mode()
  | opts.get("list_models", #false):
      // first run: wait for the catalog download so the list is complete
      when modelsdev.catalog() == {}
      | for values(done = #false) (_i in 0 .. 100):
          done || (block:
                     rkt.sleep(0.1)
                     modelsdev.catalog() != {})
        #void
      list_models()
  | try_subcommand():
      #void
  | ~else:
      init_trust()
      apply_tool_filters()
      when !opts.get("no_extensions", #false)
      | do_reload(#false)
      let tui_mode = opts.get("tui_mode", config.settings.get("tui_mode", "tui"))
      cond
      | rpc_mode: run_rpc()
      | headless: run_headless()
      | tui_mode == "tui" && stdin_is_tty():
          run_tui_mode()
      | ~else:
          run_repl(~banner: banner,
                   ~handle_command: handle_command,
                   ~handle_input: handle_input)
