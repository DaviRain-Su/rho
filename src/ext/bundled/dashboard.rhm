#lang rhombus

// Status strip + /dashboard. Pi's status-line / custom-footer pattern.

import:
  lib("racket/base.rkt") as rkt
  "../../kernel/loop.rhm" as loop
  "../../ext/mcp.rhm" as mcp

export:
  init

fun cfg_mode(rho) :: String:
  match rho.current_config()
  | #false: "allow"
  | cfg: loop.permission_mode(cfg)

fun cfg_model(rho) :: String:
  match rho.current_config()
  | #false: "?"
  | cfg: to_string(cfg.provider) +& "/" +& to_string(cfg.model)

fun msg_count(rho) :: Int:
  match rho.session
  | #false: 0
  | s: s.messages().length()

fun mcp_count() :: Int:
  mcp.status().length()

fun cfg_steps(rho) :: String:
  match rho.current_config()
  | #false: to_string(loop.MAX_STEPS)
  | cfg: to_string(loop.step_limit(cfg))

fun cfg_cwd() :: String:
  let s = to_string(rkt.#{current-directory}())
  if s.length() > 1 && s.substring(s.length() - 1 ..) == "/"
  | s.substring(0 .. s.length() - 1)
  | s

fun sess_name(rho) :: String:
  match rho.session
  | #false: "(none)"
  | s:
      let n = to_string(s.name)
      if n == "" | "(none)" | n

fun sess_path(rho) :: String:
  match rho.session
  | #false: "(no session file)"
  | s:
      if s.path is_a String | to_string(s.path) | "(no session file)"

fun token_line(rho) :: String:
  match rho.session
  | #false: "in=0 out=0"
  | s:
      let t = for values(acc = [0, 0]) (m in s.messages()):
                skip_when to_string(m.get("role", "")) != "assistant"
                let u = m.get("usage", {})
                skip_when !(u is_a Map)
                [acc[0] + u.get("input", 0), acc[1] + u.get("output", 0)]
      "in=" +& t[0] +& " out=" +& t[1]

fun snapshot(rho) :: String:
  "model: " +& cfg_model(rho)
    +& "\npermission: " +& cfg_mode(rho)
    +& "\ncwd: " +& cfg_cwd()
    +& "\ntools: " +& rho.get_all_tools().length()
    +& "\nmcp: " +& mcp_count()
    +& "\nsteps: " +& cfg_steps(rho)
    +& "\ntokens: " +& token_line(rho)
    +& "\nmessages: " +& msg_count(rho)
    +& "\nsession: " +& sess_name(rho)
    +& "\npath: " +& sess_path(rho)

fun strip(rho) :: String:
  cfg_model(rho)
    +& " \u00B7 " +& cfg_mode(rho)
    +& " \u00B7 " +& msg_count(rho) +& " msgs"
    +& " \u00B7 " +& rho.get_all_tools().length() +& " tools"
    +& (if mcp_count() == 0 | "" | " \u00B7 mcp " +& mcp_count())

fun refresh(rho):
  rho.set_widget("dashboard", strip(rho))

fun init(rho):
  rho.register_command(
    ~name: "dashboard",
    ~description: "show session status (model, permissions, tools, MCP)",
    ~handler: fun (_args):
                let snap = snapshot(rho)
                rho.state["dashboard_snap"] := snap
                when !rho.open_page("dashboard")
                | rho.notify(snap)
                refresh(rho))
  rho.on("agent_start", fun (_e): refresh(rho))
  rho.on("agent_end", fun (_e): refresh(rho))
  rho.on("turn_end", fun (_e): refresh(rho))
  refresh(rho)
