#lang rhombus

// Nested agent runs: isolated session, copied tools, no further nesting.

import:
  "loop.rhm" open
  "registry.rhm" open
  "session.rhm" open

export:
  run_subagent
  child_tool_names
  MAX_DEPTH

def MAX_DEPTH = 1

fun child_tool_names(parent, allow) :: List:
  let names:
    for List (t in parent.tool_list()):
      skip_when t.name == "agent"
      t.name
  if allow is_a List && allow != []
  | for List (n in names):
      skip_when !allow.contains(n)
      n
  | names

fun last_assistant(session) :: String:
  for values(found = "") (m in session.messages()):
    let c = to_string(m.get("content", ""))
    if m.get("role", "") == "assistant" && c != "" | c | found

fun run_subagent(~config: config,
                 ~parent: parent,
                 ~prompt: prompt :: String,
                 ~system_prompt: system_prompt :: String,
                 ~label: label :: String = "subagent",
                 ~tools: tools = #false,
                 ~on_text: on_text = fun (s): #void,
                 ~on_thinking: on_thinking = fun (s): #void,
                 ~on_tool: on_tool = fun (name, args): #void,
                 ~on_tool_result: on_tool_result = fun (name, r): #void) :: String:
  let depth = parent.state.get("agent_depth", 0)
  let limit = parent.state.get("max_agent_depth", MAX_DEPTH)
  when depth >= limit
  | error("sub-agent depth limit reached (" +& limit +& ")")
  let child = make_registry()
  for (name in parent.tools.keys()):
    skip_when name == "agent"
    child.tools[name] := parent.tools[name]
  child.set_tool_filter(~allow: child_tool_names(parent, tools))
  child.state["agent_depth"] := depth + 1
  child.state["max_agent_depth"] := limit
  let child_session = start_session(~cwd: ".", ~no_session: #true)
  let child_sys = system_prompt
    +& "\n\nYou are a sub-agent (" +& label +& "). Complete the assigned task "
    +& "and return a concise final answer. Do not ask the user questions; decide and act. "
    +& "You cannot spawn further sub-agents."
  parent.emit("subagent_start", { "label": label, "prompt": prompt })
  run_turn(~config: config,
           ~registry: child,
           ~session: child_session,
           ~system_prompt: child_sys,
           ~input: prompt,
           ~on_text: fun (s):
                       parent.emit("subagent_text", { "label": label, "delta": s })
                       on_text(s),
           ~on_thinking: fun (s):
                           parent.emit("subagent_thinking", { "label": label, "delta": s })
                           on_thinking(s),
           ~on_tool: fun (name, args):
                       parent.emit("subagent_tool",
                                   { "label": label, "toolName": name, "input": args })
                       on_tool(name, args),
           ~on_tool_result: fun (name, r):
                              parent.emit("subagent_tool_result",
                                          { "label": label, "toolName": name, "result": r })
                              on_tool_result(name, r))
  let text = last_assistant(child_session)
  parent.emit("subagent_end", { "label": label, "result": text })
  if text == "" | "(sub-agent finished with no text)" | text
