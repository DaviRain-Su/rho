#lang rhombus

// Configuration: provider profiles + current selection.
// Config file: ~/.rho/config.json (optional). Env vars supply API keys.

import:
  json
  rhombus/envvar
  lib("racket/base.rkt") as rkt

export:
  Config
  load_config
  config_dir
  sessions_dir
  set_sessions_dir
  global_extensions_dir
  project_extensions_dir
  set_api_key_override
  auth_list
  auth_set
  auth_remove

fun home() :: String:
  envvar.getenv("HOME") || "/tmp"

fun config_dir() :: String:
  home() +& "/.rho"

// overridable via --session-dir or the session_dir setting
def mutable sessions_dir_override = #false

fun set_sessions_dir(d :: String):
  sessions_dir_override := d

fun sessions_dir() :: String:
  if sessions_dir_override is_a String
  | sessions_dir_override
  | config_dir() +& "/sessions"

fun global_extensions_dir() :: String:
  config_dir() +& "/extensions"

fun project_extensions_dir() :: String:
  ".rho/extensions"

// ---- credential store: ~/.rho/auth.json (0600) ----
// resolution order: --api-key override > auth.json entry > env var

def mutable api_key_override = #false

fun set_api_key_override(k :: String):
  api_key_override := k

fun auth_path() :: String:
  config_dir() +& "/auth.json"

fun read_auth() :: Map:
  if filesystem.file_exists(auth_path())
  | let parsed = try:
                   json.from_string(filesystem.read_string(auth_path()))
                   ~catch _: {}
    if parsed is_a Map | parsed | {}
  | {}

fun write_auth(m :: Map):
  when !filesystem.directory_exists(config_dir())
  | filesystem.make_directory(config_dir(), ~parents: #true)
  filesystem.write_string(auth_path(), json.to_string(m), ~exists: #'truncate)
  try:
    rkt.#{file-or-directory-permissions}(Path(auth_path()), 0o600)
    ~catch _: #void

fun auth_list() :: List:
  read_auth().keys().sort()

fun auth_set(provider :: String, key :: String):
  write_auth(read_auth() ++ { provider: key })

fun auth_remove(provider :: String) :: Boolean:
  let m = read_auth()
  if m.has_key(provider)
  | write_auth(m.remove(provider))
    #true
  | #false

class Config(mutable provider :: String,
             mutable model :: String,
             mutable providers :: Map,
             mutable thinking,
             mutable settings :: Map):
  method profile() :: Map:
    providers.get(provider, {})
  method register_provider(name :: String, prof :: Map):
    providers := providers ++ { name: prof }
  method base_url() :: String:
    profile().get("base_url", "")
  method api_key() :: String:
    cond
    | api_key_override is_a String: api_key_override
    | ~else:
        match read_auth().get(provider, #false)
        | k :: String: k
        | ~else:
            let env_name = profile().get("api_key_env", "")
            if env_name == ""
            | ""
            | envvar.getenv(env_name) || ""
  method kind() :: String:
    // "openai" (chat completions) or "anthropic" (messages API)
    profile().get("kind", "openai")

def default_providers :: Map:
  {
    "kimi": {
      "kind": "openai",
      "base_url": "https://api.kimi.com/coding/v1",
      "api_key_env": "KIMI_API_KEY",
      "default_model": "kimi-k2-turbo-preview"
    },
    "kimi-anthropic": {
      "kind": "anthropic",
      "base_url": "https://api.kimi.com/coding",
      "api_key_env": "KIMI_API_KEY",
      "default_model": "kimi-k2-turbo-preview"
    },
    "openai": {
      "kind": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-5.2"
    },
    "openrouter": {
      "kind": "openai",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "default_model": "anthropic/claude-sonnet-4.5"
    },
    "ollama": {
      "kind": "openai",
      "base_url": "http://localhost:11434/v1",
      "api_key_env": "",
      "default_model": "qwen3:8b"
    },
    "anthropic": {
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "default_model": "claude-sonnet-4-5"
    }
  }

fun read_config_file() :: Map:
  let path = config_dir() +& "/config.json"
  if filesystem.file_exists(path)
  | try:
      json.from_string(filesystem.read_string(path))
      ~catch _:
        {}
  | {}

fun load_config(~provider: provider_arg :: maybe(String) = #false,
                ~model: model_arg :: maybe(String) = #false,
                ~thinking: thinking :: maybe(String) = #false) :: Config:
  let file_cfg = read_config_file()
  let providers:
    let extra = file_cfg.get("providers", {})
    // file config entries override / extend defaults
    for values(m = default_providers) ((k, v) in extra):
      m ++ { k: v }
  let provider = provider_arg || file_cfg.get("provider", "kimi")
  let prof = providers.get(provider, {})
  let model = model_arg || file_cfg.get("model", prof.get("default_model", ""))
  let settings = file_cfg.get("settings", {})
  Config(provider, model, providers, thinking,
         if settings is_a Map | settings | {})
