#lang rhombus

// rho: a Pi-style hot-reloadable coding agent in Rhombus.
//
// Usage: rho [options] [message ...]
//   -p, --print                 run one turn, print the result, exit (headless)
//   --mode <text|json>          output mode for headless runs (json = JSONL events)
//   --provider <name>           provider profile from config
//   -m, --model <name>          model name
//   --resume <file>             resume a session file
//   --tools <a,b>               only enable these tools
//   --exclude-tools <a,b>       disable these tools
//   --no-tools                  disable all tools
//   --no-builtin-tools / -nbt   disable built-in tools (keep extension tools)
//   --system-prompt <text>      replace the default system prompt
//   --append-system-prompt <t>  append to the system prompt
//   --no-context-files          skip AGENTS.md / CLAUDE.md discovery
//   --no-extensions             skip loading extensions
//   --api-key <key>             override the provider API key
//   --session-dir <dir>         session file directory
//   -e, --extension <path>      load an extra extension file/dir (repeatable)
//   --skill <path>              load an extra skill (repeatable, survives --no-skills)
//   --prompt-template <path>    load an extra template (repeatable)
//   --no-skills / --no-prompt-templates
//   -a, --approve / -na, --no-approve   one-shot project trust override
//   --export <in> [out]         export a session file to HTML and exit
//   subcommands: rho install|remove|update|list
//   @file arguments inline the file's content into the first message;
//   @image.png/.jpg/.gif/.webp attach the file as a base64 image.
//   In print mode, piped stdin is merged into the first message.

import:
  lib("racket/base.rkt") as rkt
  lib("racket/port.rkt") as rktport
  json
  "kernel/config.rhm" open
  "kernel/registry.rhm" open
  "kernel/session.rhm" open
  "kernel/loop.rhm" open
  "kernel/context.rhm" as context
  "kernel/compaction.rhm" as compaction
  "kernel/skills.rhm" as skills
  "kernel/prompts.rhm" as prompts
  "kernel/packages.rhm" as packages
  "kernel/settings.rhm" as settings
  "kernel/trust.rhm" as trust
  "kernel/oauth.rhm" as oauth
  "kernel/subagent.rhm" as subagent
  "kernel/crypto.rkt" as crypto
  "ai/models.rhm" as models
  "ai/modelsdev.rhm" as modelsdev
  "ai/codex.rhm" as codex
  rhombus/envvar open
  "tools/core.rhm" open
  "ext/api.rhm" open
  "ext/loader.rhm" as loader
  "ext/mcp.rhm" as mcp
  "ui/repl.rhm" open
  "ui/tui.rhm" as tui

def mutable out = Port.Output.current()

// ---- command line ----
fun split_list(v :: String) :: List:
  for List (s in v.split(",")):
    skip_when s.trim() == ""
    s.trim()

fun parse_args() :: Map:
  let args = [& rkt.#{vector->list}(rkt.#{current-command-line-arguments}())]
  recur parse(rest = (for List (a in args): to_string(a)), acc :: Map = { "message": [] }):
    match rest
    | []: acc
    | ["-p", & more]: parse(more, acc ++ { "print": #true })
    | ["--print", & more]: parse(more, acc ++ { "print": #true })
    | ["--mode", v, & more]: parse(more, acc ++ { "mode": v })
    | ["--provider", v, & more]: parse(more, acc ++ { "provider": v })
    | ["-m", v, & more]: parse(more, acc ++ { "model": v })
    | ["--model", v, & more]: parse(more, acc ++ { "model": v })
    | ["--resume", v, & more]: parse(more, acc ++ { "resume": v })
    | ["--session", v, & more]: parse(more, acc ++ { "resume": v })
    | ["-c", & more]: parse(more, acc ++ { "continue": #true })
    | ["-r", & more]: parse(more, acc ++ { "pick": #true })
    | ["--fork", & more]: parse(more, acc ++ { "fork": #true })
    | ["--no-session", & more]: parse(more, acc ++ { "no_session": #true })
    | ["--name", v, & more]: parse(more, acc ++ { "name": v })
    | ["--thinking", v, & more]: parse(more, acc ++ { "thinking": v })
    | ["--list-models", & more]: parse(more, acc ++ { "list_models": #true })
    | ["--theme", v, & more]: parse(more, acc ++ { "theme": v })
    | ["--tui-mode", v, & more]: parse(more, acc ++ { "tui_mode": v })
    | ["--models", v, & more]: parse(more, acc ++ { "models": split_list(v) })
    | ["--tools", v, & more]: parse(more, acc ++ { "tools": split_list(v) })
    | ["--exclude-tools", v, & more]: parse(more, acc ++ { "exclude_tools": split_list(v) })
    | ["--no-tools", & more]: parse(more, acc ++ { "no_tools": #true })
    | ["--no-builtin-tools", & more]: parse(more, acc ++ { "no_builtin_tools": #true })
    | ["-nbt", & more]: parse(more, acc ++ { "no_builtin_tools": #true })
    | ["--system-prompt", v, & more]: parse(more, acc ++ { "system_prompt": v })
    | ["--append-system-prompt", v, & more]: parse(more, acc ++ { "append_system_prompt": v })
    | ["--no-context-files", & more]: parse(more, acc ++ { "no_context": #true })
    | ["--session-dir", v, & more]: parse(more, acc ++ { "session_dir": v })
    | ["--api-key", v, & more]: parse(more, acc ++ { "api_key": v })
    | ["-e", v, & more]: parse(more, acc ++ { "extensions": acc.get("extensions", []).add(v) })
    | ["--extension", v, & more]: parse(more, acc ++ { "extensions": acc.get("extensions", []).add(v) })
    | ["--skill", v, & more]: parse(more, acc ++ { "skills": acc.get("skills", []).add(v) })
    | ["--prompt-template", v, & more]:
        parse(more, acc ++ { "prompt_templates": acc.get("prompt_templates", []).add(v) })
    | ["--no-skills", & more]: parse(more, acc ++ { "no_skills": #true })
    | ["--no-prompt-templates", & more]: parse(more, acc ++ { "no_prompts": #true })
    | ["-a", & more]: parse(more, acc ++ { "approve": #true })
    | ["--approve", & more]: parse(more, acc ++ { "approve": #true })
    | ["-na", & more]: parse(more, acc ++ { "no_approve": #true })
    | ["--no-approve", & more]: parse(more, acc ++ { "no_approve": #true })
    | ["--export", v, & more]:
        match more
        | [o, & rest2]:
            if !o.starts_with("-")
            | parse(rest2, acc ++ { "export": v, "export_out": o })
            | parse(more, acc ++ { "export": v })
        | ~else: parse(more, acc ++ { "export": v })
    | ["--no-extensions", & more]: parse(more, acc ++ { "no_extensions": #true })
    | ["--offline", & more]: parse(more, acc ++ { "offline": #true })
    | [a, & more]:
        cond
        | a.length() > 0 && a.substring(0..1) == "@" && filesystem.file_exists(a.substring(1..)):
            let path = a.substring(1..)
            if image_media_type(path) is_a String
            | // @image.png: attach as a base64 image on the first message
              parse(more, acc ++ { "cli_images": acc.get("cli_images", []).add(path) })
            | let inlined = "\n\n``` " +& path +& "\n" +& filesystem.read_string(path) +& "\n```"
              parse(more, acc ++ { "message": acc["message"].add(inlined) })
        | a.starts_with("--"):
            // unknown long flags are kept for extensions (rho.flag("name"))
            parse(more, acc ++ { "extra": acc.get("extra", []).add(a) })
        | a.length() > 0 && a.substring(0..1) == "-":
            println("warning: ignoring argument " +& a)
            parse(more, acc)
        | ~else:
            parse(more, acc ++ { "message": acc["message"].add(a) })

def opts = parse_args()
def rpc_mode = opts.get("mode", "text") == "rpc"
def headless = opts.get("print", #false) || opts.get("mode", "text") == "json" || rpc_mode
def json_mode = opts.get("mode", "text") == "json"
def mutable project_trusted = #false
def config = load_config(~provider: opts.get("provider", #false),
                         ~model: opts.get("model", #false),
                         ~thinking: opts.get("thinking", #false))
def registry = make_registry()
install_core_tools(registry)

fun cwd() :: String:
  let s = to_string(rkt.#{current-directory}())
  if s.length() > 1 && s.substring(s.length() - 1 ..) == "/"
  | s.substring(0 .. s.length() - 1)
  | s

// ---- settings (pi-style): global + project files, project needs trust ----
fun apply_settings():
  config.settings := config.settings ++ settings.all()
  // defaults for anything the CLI didn't pin down
  when !opts.get("provider", #false)
  | match settings.get("default_provider", #false)
    | p :: String:
        when config.providers.get(p, #false)
        | config.provider := p
          when !opts.get("model", #false) && settings.get("default_model", #false) == #false
          | config.model := config.profile().get("default_model", config.model)
    | ~else: #void
  when !opts.get("model", #false)
  | match settings.get("default_model", #false)
    | m :: String: config.model := m
    | ~else: #void
  when !opts.get("thinking", #false) && config.thinking == #false
  | match settings.get("default_thinking", #false)
    | t :: String: config.thinking := t
    | ~else: #void
  match opts.get("session_dir", settings.get("session_dir", #false))
  | d :: String: set_sessions_dir(d)
  | ~else: #void
  registry.state["steering_mode"] := settings.get("steering_mode", "all")
  registry.state["followup_mode"] := settings.get("followup_mode", "all")
  registry.state["max_agent_depth"] := settings.get("max_agent_depth", subagent.MAX_DEPTH)

settings.reload(~include_project: trust.trust_status(cwd()) == #'trusted)
apply_settings()

match opts.get("api_key", #false)
| k :: String: set_api_key_override(k)
| ~else: #void

fun read_stdin_line() :: String:
  match rkt.#{read-line}()
  | s :: ReadableString: to_string(s).trim()
  | ~else: ""

// -r: interactive session picker before anything else starts
fun pick_session() :: maybe(String):
  let sessions = list_sessions(cwd())
  cond
  | sessions == []:
      println("no previous sessions here")
      #false
  | ~else:
      for (i in 0 .. sessions.length()):
        let s = sessions[i]
        println((i + 1) +& ". "
                  +& (if s["name"] == "" | "" | "[" +& s["name"] +& "] ")
                  +& s["preview"]
                  +& "  (" +& s["path"] +& ")")
      print("resume which? (number, empty = new) ")
      let ans = read_stdin_line()
      match String.maybe_to_int(ans)
      | n :: Int:
          if n >= 1 && n <= sessions.length()
          | sessions[n - 1]["path"]
          | #false
      | ~else: #false

def mutable session:
  start_session(~cwd: cwd(),
                ~resume: (if opts.get("pick", #false)
                          | pick_session()
                          | opts.get("resume", #false)),
                ~continue_latest: opts.get("continue", #false),
                ~fork: opts.get("fork", #false),
                ~no_session: opts.get("no_session", #false),
                ~name: opts.get("name", #false))
def ui_hooks = MutableMap()
def api = PiAPI(registry, fun (): out, fun (): session, opts.get("extra", []),
                ui_hooks, fun (): config)

fun context_section() :: String:
  if opts.get("no_context", #false)
  | ""
  | let files = context.gather_context_files(~cwd: cwd())
    if files == []
    | ""
    | let parts:
        for List (entry in files):
          let [path, content] = entry
          "### " +& path +& "\n\n" +& content
      "\n\n## Project context\n\n" +& String.join(parts, "\n\n")

fun default_system_prompt() :: String:
  "You are rho, a coding agent written in Rhombus, running in a terminal.\n"
    +& "Working directory: " +& cwd() +& "\n"
    +& "Use the available tools to read, write, and edit files and to run shell commands.\n"
    +& "You can extend yourself: write a Rhombus extension module exporting `init(rho)` into "
    +& project_extensions_dir() +& "/ or " +& global_extensions_dir() +& "/, "
    +& "then call the reload_extensions tool to activate it immediately.\n"
    +& "Extension template (Rhombus is indentation-sensitive; follow it exactly):\n"
    +& "```\n"
    +& "#lang rhombus\n"
    +& "export: init\n"
    +& "fun init(rho):\n"
    +& "  rho.register_tool(\n"
    +& "    ~name: \"my_tool\",\n"
    +& "    ~description: \"what it does\",\n"
    +& "    ~schema: { \"type\": \"object\",\n"
    +& "               \"properties\": { \"x\": { \"type\": \"string\" } },\n"
    +& "               \"required\": [\"x\"] },\n"
    +& "    ~fn: fun (args):\n"
    +& "           \"result: \" +& args.get(\"x\", \"\"))\n"
    +& "```\n"
    +& "Also available: rho.register_command(~name, ~description, ~handler), "
    +& "rho.on(event, fn) for events (tool_call may return {\"block\": #true, \"reason\": ...}), "
    +& "rho.state (a mutable map that survives reloads), rho.notify(msg).\n"
    +& "Shorthand: `import: lib(\"rho/src/ext/tool.rhm\") open` provides a `tool` macro:\n"
    +& "  tool rho greet(name :: String, times :: Int = 1) ~desc \"Greet\":\n"
    +& "    \"Hello \" +& name\n"
    +& "which derives the JSON schema from the annotations (defaults become optional).\n"
    +& "For isolated or parallelizable work, call the `agent` tool to run a nested "
    +& "sub-agent with its own session; it returns a final text answer.\n"
    +& "Be concise. Prefer tools over guessing."

// --skill / --prompt-template survive --no-skills / --no-prompt-templates
fun discover_skills() :: List:
  skills.discover(~cwd: cwd(),
                  ~extra: packages.package_skill_dirs(),
                  ~include_project: project_trusted,
                  ~direct: opts.get("skills", []),
                  ~standard: !opts.get("no_skills", #false))

fun discover_prompts() :: List:
  prompts.discover(~cwd: cwd(),
                   ~extra: packages.package_prompt_dirs(),
                   ~include_project: project_trusted,
                   ~direct: opts.get("prompt_templates", []),
                   ~standard: !opts.get("no_prompts", #false))

fun system_prompt() :: String:
  context.resolve_system_prompt(~default_prompt: default_system_prompt(),
                                ~override_text: opts.get("system_prompt", #false),
                                ~append_text: opts.get("append_system_prompt", #false),
                                ~cwd: cwd())
    +& context_section()
    +& skills.xml_section(discover_skills())

registry.state["build_system_prompt"] := system_prompt

// ---- tool filters ----
// pi defaults: read/bash/edit/write on; grep/find/ls opt-in via --tools
def optin_tools :: List = ["grep", "find", "ls"]

fun apply_tool_filters():
  cond
  | opts.get("no_tools", #false):
      registry.set_tool_filter(~allow: [])
  | opts.get("no_builtin_tools", #false):
      let builtin_tools = ["read_file", "write_file", "edit_file",
                           "bash", "grep", "find", "ls",
                           "reload_extensions"]
      let allow = opts.get("tools", #false)
      registry.set_tool_filter(~allow: allow,
                               ~deny: builtin_tools ++ opts.get("exclude_tools", []))
  | ~else:
      let allow = opts.get("tools", #false)
      let enabled = settings.get("default_tools", [])
      let default_deny:
        cond
        | allow is_a List: []      // explicit allowlist: user decides
        | ~else:
            for List (t in optin_tools):
              skip_when enabled is_a List && enabled.contains(t)
              t
      registry.set_tool_filter(~allow: allow,
                               ~deny: opts.get("exclude_tools", []) ++ default_deny)

// ---- built-in commands ----
fun show_help(_args):
  out.write_string("commands:\n")
  for (c in registry.command_list()):
    out.write_string("  /" +& c.name +& "  \u2014 " +& c.description +& "\n")
  out.write_string("tools:\n")
  for (t in registry.tool_list()):
    out.write_string("  " +& t.name +& " [" +& t.source +& "]\n")

fun do_reload(notify = #true):
  settings.reload(~include_project: project_trusted)
  apply_settings()
  let [ok, failed] = loader.load_extensions(registry, api,
                                            ~notify: fun (s): api.notify(s),
                                            ~extra_dirs:
                                              packages.package_extension_dirs()
                                                ++ opts.get("extensions", []),
                                            ~include_project: project_trusted)
  mcp.reload(registry,
             ~notify: fun (s): api.notify(s),
             ~include_project: project_trusted)
  when notify
  | api.notify("extensions: " +& ok +& " loaded, " +& failed +& " failed")

// ---- /settings: list, show, set (persisted to ~/.rho/settings.json) ----
fun settings_value_str(key :: String) :: String:
  match settings.get(key, #false)
  | #false: "(unset)"
  | #true: "true"
  | l :: List: String.join((for List (x in l): to_string(x)), ",")
  | v: to_string(v)

// returns [#'ok, value] or [#'err, message]
fun parse_setting(key :: String, raw :: String) :: List:
  let spec = settings.known_keys.get(key, #false)
  let kind = (if spec is_a List | spec[1] | "string")
  cond
  | kind == "int":
      match String.maybe_to_int(raw)
      | n :: Int: [#'ok, n]
      | ~else: [#'err, key +& " expects a number"]
  | kind == "bool":
      cond
      | ["true", "on", "yes", "1"].contains(raw.foldcase()): [#'ok, #true]
      | ["false", "off", "no", "0"].contains(raw.foldcase()): [#'ok, #false]
      | ~else: [#'err, key +& " expects true/false"]
  | kind == "list":
      [#'ok,
       for List (s in raw.split(",")):
         skip_when s.trim() == ""
         s.trim()]
  | kind is_a List:
      if kind.contains(raw)
      | [#'ok, raw]
      | [#'err, key +& " expects one of " +& String.join(kind, "|")]
  | ~else: [#'ok, raw]

registry.register_command(
  ~name: "settings",
  ~description: "show or change settings: /settings [key [value]]",
  ~handler: fun (args):
              let parts = args.trim().split(" ")
              cond
              | args.trim() == "":
                  for (key in settings.known_keys.keys().sort()):
                    let [desc, _] = settings.known_keys[key]
                    out.write_string("  " +& key +& " = " +& settings_value_str(key)
                                       +& "  \u2014 " +& desc +& "\n")
              | parts.length() == 1:
                  let key = to_string(parts[0])
                  match settings.known_keys.get(key, #false)
                  | [desc, _]:
                      api.notify(key +& " = " +& settings_value_str(key) +& "  \u2014 " +& desc)
                  | ~else: api.notify("unknown setting: " +& key)
              | ~else:
                  let key = to_string(parts[0])
                  let raw = String.join(parts.rest, " ").trim()
                  cond
                  | settings.known_keys.get(key, #false) == #false:
                      api.notify("unknown setting: " +& key)
                  | ~else:
                      match parse_setting(key, raw)
                      | [#'err, msg]: api.notify("error: " +& msg)
                      | [#'ok, v]:
                          settings.set_global(key, v)
                          apply_settings()
                          apply_tool_filters()
                          api.notify(key +& " = " +& settings_value_str(key)))

fun set_permission_mode(mode :: String):
  settings.set_global("permission_mode", mode)
  apply_settings()
  api.notify("permission_mode = " +& mode)

fun permission_cmd(args :: String):
  let a = args.trim().foldcase()
  cond
  | a == "":
      api.notify("permission_mode = " +& permission_mode(config)
                   +& "  (allow = run tools, ask = prompt for write/bash)")
  | a == "allow" || a == "ask":
      set_permission_mode(a)
  | ~else:
      api.notify("usage: /permission [allow|ask]")

registry.register_command(
  ~name: "permission",
  ~description: "tool permission prompt: /permission [allow|ask]",
  ~handler: permission_cmd)
registry.register_command(
  ~name: "allow",
  ~description: "run tools without prompting (alias of /permission allow)",
  ~handler: fun (_args): set_permission_mode("allow"))
registry.register_command(
  ~name: "ask",
  ~description: "prompt before write/bash tools (alias of /permission ask)",
  ~handler: fun (_args): set_permission_mode("ask"))

fun steps_cmd(args :: String):
  let a = args.trim()
  cond
  | a == "":
      api.notify("max_steps = " +& step_limit(config)
                   +& "  (default " +& MAX_STEPS +& ", cap " +& MAX_STEPS_CAP +& ")")
  | ~else:
      match String.maybe_to_int(a)
      | n :: Int:
          cond
          | n < 1 || n > MAX_STEPS_CAP:
              api.notify("max_steps expects 1.." +& MAX_STEPS_CAP)
          | ~else:
              settings.set_global("max_steps", n)
              apply_settings()
              api.notify("max_steps = " +& n)
      | ~else:
          api.notify("usage: /steps [n]")

registry.register_command(
  ~name: "steps",
  ~description: "agent step limit: /steps [n] (default 200)",
  ~handler: steps_cmd)

fun mcp_cmd(args :: String):
  let a = args.trim().foldcase()
  cond
  | a == "reload":
      mcp.reload(registry,
                 ~notify: fun (s): api.notify(s),
                 ~include_project: project_trusted)
      api.notify("mcp reloaded")
  | a == "stop":
      mcp.disconnect_all()
      api.notify("mcp stopped")
  | a == "" || a == "list":
      match mcp.status()
      | []: api.notify("no MCP servers (add ~/.rho/mcp.json)")
      | rows:
          for (row in rows):
            api.notify("  " +& row[0] +& "  " +& row[1] +& " tools")
  | ~else:
      api.notify("usage: /mcp [list|reload|stop]")

registry.register_command(
  ~name: "mcp",
  ~description: "MCP servers: /mcp [list|reload|stop]",
  ~handler: mcp_cmd)

registry.register_command(
  ~name: "help", ~description: "list commands and tools",
  ~handler: show_help)
registry.register_command(
  ~name: "reload", ~description: "hot-reload extensions (picks up changed files)",
  ~handler: fun (_args): do_reload())
// ---- model availability (models.dev catalog + env key or /login auth) ----

// rho provider name -> models.dev catalog id for its model list
def modelsdev_alias :: Map:
  { "kimi": "kimi-for-coding", "kimi-anthropic": "kimi-for-coding" }

fun filter_listed(pname :: String, mdls :: Map) :: Map:
  for values(m = {}) ((mid, info) in mdls):
    if modelsdev.listed_model(pname, to_string(mid)) | m ++ { mid: info } | m

// [provider_name, models_map] for every provider usable right now.
// Built-ins with credentials, minus protocol aliases (kimi-anthropic).
// Catalog extras only when the env uniquely identifies them, or a shared
// env has an explicit preferred product (OPENCODE_API_KEY → opencode-go).
fun available_provider_groups() :: List:
  let cat = modelsdev.catalog()
  let configured:
    for List:
      each pname in config.providers.keys().sort()
      let prof = config.providers[pname]
      let pname = to_string(pname)
      skip_when modelsdev.hidden_builtin(pname) && config.provider != pname
      skip_when !credentials_ok(pname, to_string(prof.get("api_key_env", "")))
      let src = modelsdev_alias.get(pname, pname)
      let p = cat.get(src, #false)
      let ms = (if p is_a Map | p.get("models", {}) | {})
      let mdls = filter_listed(
                   pname,
                   modelsdev.merge_model_maps(
                     modelsdev.merge_model_maps(
                       if ms is_a Map | ms | {},
                       modelsdev.fallback_models(pname)),
                     if pname == "openai-codex" | codex.live_models() | {}))
      let mdls:
        if mdls.keys().length() > 0
        | mdls
        | { to_string(prof.get("default_model", "")): {} }
      [pname, mdls]
  let dev_only:
    for List:
      each entry in modelsdev.available_providers()
      let [id, _prof, mdls] = entry
      skip_when config.providers.get(id, #false)
      skip_when modelsdev.catalog_suppressed(id)
      skip_when mdls.keys().length() == 0
      [id, mdls]
  configured ++ dev_only

fun model_desc(m) :: String:
  cond
  | m is_a Map && m.keys().length() > 0:
      let cost = m.get("cost", {})
      let cost = (if cost is_a Map | cost | {})
      let limit = m.get("limit", {})
      let limit = (if limit is_a Map | limit | {})
      "ctx " +& limit.get("context", "?")
        +& " \u00B7 $" +& cost.get("input", 0) +& "/$" +& cost.get("output", 0)
        +& (if m.get("reasoning", #false) == #true | " \u00B7 thinking" | "")
  | ~else: ""

// ["provider/model", description] pairs for menus and --list-models
fun available_model_entries() :: List:
  for List:
    each group in available_provider_groups()
    let [pname, mdls] = group
    each mid in mdls.keys().sort()
    skip_when to_string(mid) == ""
    [pname +& "/" +& mid, model_desc(mdls.get(mid, #false))]

fun model_supports_thinking() :: Boolean:
  models.model_info(config.model)["thinking"] == #true

// pi behavior: switching to a model without reasoning support drops the
// thinking level; supported models keep the current level
fun clamp_thinking() :: String:
  cond
  | config.thinking && !model_supports_thinking():
      config.thinking := #false
      "  (thinking off: not supported)"
  | config.thinking: "  (thinking: " +& config.thinking +& ")"
  | ~else: ""

// Switch model, optionally crossing providers ("provider/model").
// Unknown models.dev providers with a supported protocol are registered
// into the live config on the fly.
fun apply_set_model(arg :: String) :: String:
  let slash:
    for values(found = #false) (i in 0 .. arg.length()):
      found || (arg[i] == Char"/" && i)
  cond
  | slash is_a Int:
      let p = arg.substring(0 .. slash)
      let m = arg.substring(slash + 1 ..)
      let chatgpt = has_chatgpt_auth()
      let p = (if chatgpt && (p == "openai" || p == "openai-codex")
               | "openai-codex"
               | p)
      let m = (if p == "openai-codex" | modelsdev.codex_model_id(m) | m)
      cond
      | config.providers.get(p, #false):
          config.provider := p
          config.model := m
          "provider=" +& p +& " model=" +& m
      | ~else:
          let entry = modelsdev.catalog().get(p, #false)
          let prof = (if entry is_a Map | modelsdev.provider_profile(entry) | #false)
          cond
          | prof is_a Map:
              config.register_provider(p, prof)
              config.provider := p
              config.model := m
              "provider=" +& p +& " model=" +& m
          | ~else:
              // the model id itself contains "/" (e.g. openrouter ids)
              config.model := arg
              "model set to " +& arg
  | ~else:
      if has_chatgpt_auth() && (config.provider == "openai" || config.provider == "openai-codex"
                                 || arg.starts_with("gpt-5"))
      | config.provider := "openai-codex"
        config.model := modelsdev.codex_model_id(arg)
        "provider=openai-codex model=" +& config.model
      | block:
          config.model := arg
          "model set to " +& arg

// Ctrl-P may land on a smaller window without compacting; the next turn
// summarizes with this outgoing model first.
def mutable pending_fit = #false

fun compact_on_switch() :: Boolean:
  config.settings.get("compact_on_model_switch", #true) != #false

fun better_fit_source(old_p :: String, old_m :: String):
  match pending_fit
  | src :: Map:
      if compaction.model_window(to_string(src.get("model", "")))
           > compaction.model_window(old_m)
      | src
      | { "provider": old_p, "model": old_m }
  | ~else: { "provider": old_p, "model": old_m }

fun finish_model_switch(old_p :: String, old_m :: String, old_t, msg :: String,
                        ~compact: do_compact = #true) :: String:
  let new_p = config.provider
  let new_m = to_string(config.model)
  let overflow = compaction.overflows_model(session, config, new_m)
  let needed = compact_on_switch()
    && compaction.should_compact_for_switch(session, config, old_m, new_m)
  cond
  | needed && do_compact:
      let src = better_fit_source(old_p, old_m)
      config.provider := to_string(src["provider"])
      config.model := to_string(src["model"])
      config.thinking := old_t
      api.notify("context exceeds " +& new_m +& " window; compacting with "
                   +& config.model +& " first\u2026")
      let r = try:
                compaction.compact_to_fit(~session: session, ~config: config,
                                          ~target_model: new_m)
                ~catch e :: Exn.Fail:
                  "compaction failed: " +& e.message
      let still = compaction.overflows_model(session, config, new_m)
      cond
      | r.starts_with("compaction failed")
          || (still && (r == "nothing to compact" || r == "already fits")):
          pending_fit := #false
          r +& "; stayed on " +& config.provider +& "/" +& config.model
            +& " (target " +& new_p +& "/" +& new_m +& " window too small)"
            +& clamp_thinking()
      | ~else:
          config.provider := new_p
          config.model := new_m
          pending_fit := #false
          r +& "; " +& msg +& clamp_thinking()
  | overflow && compact_on_switch() && !do_compact:
      pending_fit := better_fit_source(old_p, old_m)
      msg +& clamp_thinking()
  | ~else:
      when !overflow
      | pending_fit := #false
      msg +& clamp_thinking()

fun guarded_apply(~compact: do_compact = #true, apply) :: String:
  let old_p = config.provider
  let old_m = to_string(config.model)
  let old_t = config.thinking
  let msg = apply()
  let result = finish_model_switch(old_p, old_m, old_t, msg, ~compact: do_compact)
  registry.emit("model_select", { "provider": config.provider, "model": config.model })
  result

fun set_model(arg :: String, ~compact: do_compact = #true) :: String:
  guarded_apply(~compact: do_compact, fun (): apply_set_model(arg))

fun drain_pending_fit() :: String:
  match pending_fit
  | #false: ""
  | src :: Map:
      pending_fit := #false
      let target = to_string(config.model)
      if !compaction.overflows_model(session, config, target)
      | ""
      | let cur_p = config.provider
        let cur_m = target
        let cur_t = config.thinking
        config.provider := to_string(src.get("provider", cur_p))
        config.model := to_string(src.get("model", cur_m))
        let r = try:
                  compaction.compact_to_fit(~session: session, ~config: config,
                                            ~target_model: cur_m)
                  ~catch e :: Exn.Fail:
                    "compaction failed: " +& e.message
        config.provider := cur_p
        config.model := cur_m
        config.thinking := cur_t
        if r.starts_with("compaction failed")
        | r +& " (still on " +& cur_p +& "/" +& cur_m +& ")"
        | r

registry.register_command(
  ~name: "model", ~description: "switch model: /model [provider/model | name] (compacts first when the target window is smaller)",
  ~handler: fun (args):
              if args == ""
              | api.notify("provider=" +& config.provider +& " model=" +& config.model)
              | api.notify(set_model(args.trim())))
registry.register_command(
  ~name: "provider", ~description: "switch provider: /provider [name]",
  ~handler: fun (args):
              cond
              | args == "":
                  let avail:
                    for List (g in available_provider_groups()): g[0]
                  api.notify("provider=" +& config.provider
                               +& " (available: " +& String.join(avail, ", ") +& ")")
              | args == "openai" && has_chatgpt_auth()
                  && !credentials_ok("openai", "OPENAI_API_KEY"):
                  api.notify(guarded_apply(fun ():
                                             config.provider := "openai-codex"
                                             config.model := "gpt-5.6-sol"
                                             "switched to openai-codex model=gpt-5.6-sol (ChatGPT subscription)"))
              | config.providers.has_key(args):
                  api.notify(guarded_apply(fun ():
                                             config.provider := args
                                             config.model := config.profile().get("default_model", config.model)
                                             when args == "openai-codex"
                                             | config.model := modelsdev.codex_model_id(to_string(config.model))
                                             "switched to " +& args +& " model=" +& config.model))
              | ~else:
                  match modelsdev.catalog().get(args, #false)
                  | entry :: Map:
                      match modelsdev.provider_profile(entry)
                      | prof :: Map:
                          api.notify(guarded_apply(fun ():
                                                     config.register_provider(args, prof)
                                                     config.provider := args
                                                     config.model := ""
                                                     "switched to " +& args +& "; pick a model with /model"))
                      | ~else: api.notify("provider " +& args +& " uses an unsupported protocol")
                  | ~else: api.notify("unknown provider: " +& args))
// ---- usage accounting ----
fun usage_totals() :: Map:
  for values(acc :: Map = { "input": 0, "output": 0, "cache_read": 0, "cost": 0.0 }) (m in session.messages()):
    skip_when m.get("role", "") != "assistant"
    let u = m.get("usage", {})
    skip_when !(u is_a Map) || u == {}
    { "input": acc["input"] + u.get("input", 0),
      "output": acc["output"] + u.get("output", 0),
      "cache_read": acc["cache_read"] + u.get("cache_read", 0),
      "cost": acc["cost"] + models.cost_of(config.model, u) }

fun round2(x) :: String:
  let cents = math.round(x * 10000)
  to_string(cents / 10000.0)

fun usage_line() :: String:
  let t = usage_totals()
  let info = models.model_info(config.model)
  "tokens: in=" +& t["input"] +& " out=" +& t["output"]
    +& " cached=" +& t["cache_read"]
    +& " cost=$" +& round2(t["cost"])
    +& " ctx-window=" +& info["context_window"]

fun list_models():
  match available_model_entries()
  | []:
      println("no models available: /login <provider> oauth  or  set an API")
      println("key (KIMI_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY, ...) and")
      println("rerun; the model catalog (models.dev) downloads in the background")
  | entries:
      for (entry in entries):
        let [full, desc] = entry
        println(full +& (if desc == "" | "" | "  " +& desc))

registry.register_command(
  ~name: "session", ~description: "show session file, entry count, token usage",
  ~handler: fun (_args):
              api.notify((if session.path is_a String | session.path | "(no session file)")
                           +& " (" +& session.entries.length() +& " entries)"
                           +& (if session.name == "" | "" | " name=" +& session.name))
              api.notify(usage_line()))
registry.register_command(
  ~name: "clear", ~description: "start a new branch from the root (history kept in tree)",
  ~handler: fun (_args):
              session.clear()
              api.notify("history cleared (old branch kept; see /tree)"))

// ---- session tree commands ----
fun snippet(s :: String) :: String:
  let one = String.join(s.split("\n"), " ")
  if one.length() > 56 | one.substring(0..56) +& "\u2026" | one

fun entry_label(e :: Map) :: String:
  match e["kind"]
  | "message":
      let m = e["data"]
      let role = m.get("role", "?")
      cond
      | role == "assistant" && m.get("tool_calls", []) != []:
          let names = (for List (tc in m["tool_calls"]): tc["name"])
          "assistant \u2699 " +& String.join(names, ",") +& " " +& snippet(m.get("content", ""))
      | ~else: role +& ": " +& snippet(m.get("content", ""))
  | "compaction": "[compaction] " +& snippet(e["data"].get("summary", ""))
  | "meta": "[meta " +& e["data"].get("event", "") +& "]"
  | k: "[" +& k +& "]"

fun show_tree(_args):
  let active:
    for values(s :: Set = Set()) (e in session.path_entries()):
      s ++ { e["id"] }
  for (e in session.entries):
    let depth:
      recur count(id = e.get("parent", #'null), n = 0):
        match session.entry(if id is_a Int | id | -1)
        | p :: Map: count(p.get("parent", #'null), n + 1)
        | ~else: n
    let marker = (if active.contains(e["id"]) | "*" | " ")
    let tag:
      match session.labels().get(e["id"], #false)
      | l :: String: " \u2605" +& l
      | ~else: ""
    out.write_string(marker +& " " +& e["id"] +& " "
                       +& String.make(depth * 2, Char" ")
                       +& entry_label(e) +& tag +& "\n")
  out.write_string("use /tree <id> to move the active leaf\n")

// Heuristic summary of the branch being abandoned when jumping from
// old_leaf to target: the user/assistant messages that are not on the new
// path, condensed to first lines.
fun branch_summary_text(old_leaf, target) :: String:
  let new_path:
    for values(s :: Set = Set()) (e in session.path_entries()):
      s ++ { e["id"] }
  let abandoned:
    recur walk(id = old_leaf, acc :: List = []):
      match session.entry(if id is_a Int | id | -1)
      | e :: Map:
          if new_path.contains(e["id"])
          | acc
          | walk(e.get("parent", #'null), acc.insert(0, e))
      | ~else: acc
  let parts:
    for List (e in abandoned):
      skip_when e["kind"] != "message"
      let m = e["data"]
      let role = m.get("role", "")
      skip_when role != "user" && role != "assistant"
      let content = to_string(m.get("content", ""))
      skip_when content == ""
      role +& ": " +& first_line(content).substring(
        0 .. math.min(120, first_line(content).length()))
  String.join(parts, "\n")

registry.register_command(
  ~name: "tree", ~description: "show session tree; /tree <id> jumps to an entry",
  ~handler: fun (args):
              match String.maybe_to_int(args.trim())
              | n :: Int:
                  cond
                  | !session_event_ok("session_before_branch", { "target": n }):
                      api.notify("branch switch cancelled by extension")
                  | ~else:
                      let old_leaf = session.leaf
                      session.set_leaf(n)
                      registry.emit("session_tree", { "target": n })
                      // keep a trace of what the abandoned branch contained
                      let summary = branch_summary_text(old_leaf, n)
                      when summary != "" && old_leaf != n
                      | session.append("branch_summary",
                                       { "summary": summary, "from": old_leaf })
                      api.notify("leaf moved to " +& n)
              | ~else: show_tree(args))

registry.register_command(
  ~name: "label", ~description: "bookmark the current entry: /label <name> (shown in /tree)",
  ~handler: fun (args):
              let text = args.trim()
              if text == ""
              | let ls = session.labels()
                if ls.keys().length() == 0
                | api.notify("no labels; /label <name> bookmarks the current entry")
                | for (id in ls.keys().sort()):
                    out.write_string("  " +& id +& "  " +& ls[id] +& "\n")
              | session.set_label(text)
                api.notify("labeled entry " +& session.leaf +& ": " +& text))

registry.register_command(
  ~name: "fork", ~description: "branch from a previous user message: /fork [id]",
  ~handler: fun (args):
              let target:
                match String.maybe_to_int(args.trim())
                | n :: Int: session.entry(n)
                | ~else:
                    // last user message on the active path
                    for values(found = #false) (e in session.path_entries()):
                      if e["kind"] == "message" && e["data"].get("role", "") == "user"
                      | e
                      | found
              cond
              | !target: api.notify("no user message to fork from")
              | ~else:
                  let parent = target.get("parent", #'null)
                  session.set_leaf(if parent is_a Int | parent | #false)
                  when target["kind"] == "message"
                  | add_history(target["data"].get("content", ""))
                  api.notify("forked before entry " +& target["id"]
                               +& "; press \u2191 to edit the original message"))

registry.register_command(
  ~name: "new", ~description: "start a fresh session file",
  ~handler: fun (_args):
              session := start_session(~cwd: cwd())
              api.notify("new session: " +& session.path))

registry.register_command(
  ~name: "name", ~description: "name this session: /name <name>",
  ~handler: fun (args):
              if args.trim() == ""
              | api.notify("name: " +& (if session.name == "" | "(none)" | session.name))
              | session.set_name(args.trim())
                api.notify("session named " +& args.trim()))

// cancellable session lifecycle events: a handler returning
// {"cancel": #true} aborts the operation
fun session_event_ok(name :: String, data :: Map) :: Boolean:
  match registry.emit(name, data)
  | m :: Map: m.get("cancel", #false) != #true
  | ~else: #true

registry.register_command(
  ~name: "clone", ~description: "copy this session to a new file and switch to it",
  ~handler: fun (_args):
              cond
              | !(session.path is_a String): api.notify("no session file to clone")
              | !session_event_ok("session_before_fork", { "path": session.path }):
                  api.notify("clone cancelled by extension")
              | ~else:
                  session := start_session(~cwd: cwd(), ~resume: session.path, ~fork: #true)
                  api.notify("cloned into " +& session.path))

fun session_age(mtime) :: String:
  let secs = rkt.#{current-seconds}() - mtime
  cond
  | secs < 3600: math.exact(math.floor(secs / 60)) +& "m ago"
  | secs < 86400: math.exact(math.floor(secs / 3600)) +& "h ago"
  | ~else: math.exact(math.floor(secs / 86400)) +& "d ago"

registry.register_command(
  ~name: "resume",
  ~description: "switch to a previous session: /resume [file] (menu completes)",
  ~handler: fun (args):
              let a = args.trim()
              cond
              | a != "":
                  cond
                  | !filesystem.file_exists(a): api.notify("no such session file: " +& a)
                  | !session_event_ok("session_before_switch", { "path": a }):
                      api.notify("switch cancelled by extension")
                  | ~else:
                      session := start_session(~cwd: cwd(), ~resume: a)
                      api.notify("resumed " +& a)
              | ~else:
                  match pick_session()
                  | path :: String:
                      if session_event_ok("session_before_switch", { "path": path })
                      | session := start_session(~cwd: cwd(), ~resume: path)
                        api.notify("resumed " +& path)
                      | api.notify("switch cancelled by extension")
                  | ~else: api.notify("unchanged"))

registry.register_command(
  ~name: "sessions",
  ~description: "list sessions here: /sessions [time|name]",
  ~handler: fun (args):
              let order = args.trim()
              let ss = list_sessions(cwd())
              let ss:
                if order == "name"
                | ss.sort(fun (a, b): a["name"] +& a["path"] < b["name"] +& b["path"])
                | ss
              if ss == []
              | api.notify("no sessions in this directory")
              | for (s in ss):
                  out.write_string("  " +& session_age(s["mtime"])
                                     +& (if s["name"] == "" | "" | "  [" +& s["name"] +& "]")
                                     +& "  " +& s["preview"] +& "\n"
                                     +& "    " +& s["path"] +& "\n"))

registry.register_command(
  ~name: "session-rename",
  ~description: "rename a session file: /session-rename <file> <name>",
  ~handler: fun (args):
              let parts = args.trim().split(" ")
              cond
              | parts.length() < 2: api.notify("usage: /session-rename <file> <name>")
              | ~else:
                  let path = to_string(parts[0])
                  let name = String.join(parts.rest, " ").trim()
                  cond
                  | !filesystem.file_exists(path): api.notify("no such session file: " +& path)
                  | ~else:
                      if session.path == path
                      | session.set_name(name)
                      | start_session(~cwd: cwd(), ~resume: path).set_name(name)
                      api.notify("renamed to " +& name))

registry.register_command(
  ~name: "session-delete",
  ~description: "delete a session file: /session-delete <file>",
  ~handler: fun (args):
              let path = args.trim()
              cond
              | path == "": api.notify("usage: /session-delete <file>")
              | !filesystem.file_exists(path): api.notify("no such session file: " +& path)
              | session.path == path: api.notify("refusing to delete the active session")
              | ~else:
                  filesystem.delete(path)
                  api.notify("deleted " +& path))

fun export_html(target :: String):
  let parts:
    for List (e in session.path_entries()):
      skip_when e["kind"] != "message"
      let m = e["data"]
      let role = m.get("role", "?")
      let body = html_escape(m.get("content", ""))
      let tools:
        for List (tc in m.get("tool_calls", [])):
          "<div class=tool>\u2699 " +& html_escape(tc["name"]) +& " "
            +& html_escape(tc["arguments"]) +& "</div>"
      "<div class=" +& role +& "><b>" +& role +& "</b><pre>" +& body +& "</pre>"
        +& String.join(tools, "") +& "</div>"
  let doc:
    "<!doctype html><meta charset=utf-8><title>rho session</title>"
      +& "<style>body{font-family:sans-serif;max-width:52em;margin:2em auto}"
      +& "pre{white-space:pre-wrap}div{margin:1em 0;padding:.5em 1em;border-radius:8px}"
      +& ".user{background:#eef}.assistant{background:#f7f7f7}.tool{color:#666;font-size:90%}"
      +& ".system{background:#ffe}</style>"
      +& String.join(parts, "\n")
  filesystem.write_string(target, doc, ~exists: #'truncate)

// --export <in> [out]: convert a session file to HTML and exit
fun run_export_mode():
  let src = to_string(opts["export"])
  cond
  | !filesystem.file_exists(src):
      println("error: session file not found: " +& src)
  | ~else:
      session := start_session(~cwd: cwd(), ~resume: src)
      let target:
        match opts.get("export_out", #false)
        | o :: String: o
        | ~else:
            (if src.ends_with(".jsonl") | src.substring(0 .. src.length() - 6) | src)
              +& ".html"
      export_html(target)
      println("exported " +& target)

fun html_escape(s :: String) :: String:
  let s = String.join(s.split("&"), "&amp;")
  let s = String.join(s.split("<"), "&lt;")
  String.join(s.split(">"), "&gt;")

registry.register_command(
  ~name: "export", ~description: "export session: /export [file.html|file.jsonl]",
  ~handler: fun (args):
              let target = (if args.trim() == "" | "session-export.html" | args.trim())
              cond
              | target.ends_with(".jsonl"):
                  cond
                  | session.path is_a String:
                      filesystem.write_string(target, filesystem.read_string(session.path),
                                              ~exists: #'truncate)
                      api.notify("exported " +& target)
                  | ~else: api.notify("no session file")
              | ~else:
                  export_html(target)
                  api.notify("exported " +& target))

registry.register_command(
  ~name: "import", ~description: "import a session file: /import <file.jsonl>",
  ~handler: fun (args):
              let src = args.trim()
              cond
              | !filesystem.file_exists(src): api.notify("no such file: " +& src)
              | ~else:
                  let dir = session_dir_for(cwd())
                  when !filesystem.directory_exists(dir)
                  | filesystem.make_directory(dir, ~parents: #true)
                  let dest = dir +& "/imported-" +& rkt.#{current-seconds}() +& ".jsonl"
                  filesystem.write_string(dest, filesystem.read_string(src),
                                          ~exists: #'truncate)
                  session := start_session(~cwd: cwd(), ~resume: dest)
                  api.notify("imported into " +& dest))
registry.register_command(
  ~name: "share", ~description: "upload the session as a GitHub gist (needs gh CLI)",
  ~handler: fun (_args):
              cond
              | !(session.path is_a String): api.notify("no session file to share")
              | ~else:
                  let values(code, text) = crypto.#{run-argv}(
                    "gh", ["gist", "create", session.path, "--desc", "rho session"])
                  if code == 0
                  | api.notify(to_string(text).trim())
                  | api.notify(if to_string(text).contains("not found")
                               | "gh CLI unavailable or failed"
                               | to_string(text).trim()))
registry.register_command(
  ~name: "packages", ~description: "list installed packages (rho install/remove to manage)",
  ~handler: fun (_args):
              match packages.installed()
              | []: api.notify("no packages installed (rho install <git-url|owner/repo>)")
              | ps:
                  for (p in ps):
                    out.write_string("  " +& p +& " (" +& packages.packages_dir() +& "/" +& p +& ")\n"))
registry.register_command(
  ~name: "compact", ~description: "summarize old turns to shrink context: /compact [instructions]",
  ~handler: fun (args):
              if !session_event_ok("session_before_compact", {})
              | api.notify("compaction cancelled by extension")
              | api.notify("compacting\u2026")
                api.notify(compaction.compact(~session: session, ~config: config,
                                              ~instructions: args.trim()))
                registry.emit("session_compact", { "auto": #false }))
registry.register_command(
  ~name: "quit", ~description: "exit",
  ~handler: fun (_args):
              registry.emit("session_shutdown", {})
              #'quit)

// ---- credentials: /login /logout (~/.rho/auth.json, chmod 600) ----
fun do_login_key(prov :: String, key :: String):
  if key == ""
  | api.notify("usage: /login " +& prov +& " <api-key>")
  | auth_set(prov, key)
    api.notify("saved key for " +& prov +& " in ~/.rho/auth.json")

fun refresh_codex_models():
  when has_chatgpt_auth()
  | codex.refresh_models_async(~api_key: oauth.chatgpt_access_token(),
                               ~extra_headers: oauth.chatgpt_headers())

fun adopt_chatgpt():
  config.provider := "openai-codex"
  config.model := to_string(config.providers["openai-codex"].get("default_model", "gpt-5.6-sol"))
  refresh_codex_models()
  api.notify("using openai-codex / " +& config.model +& " (ChatGPT subscription)")

fun login_notify(s :: String):
  api.notify(s)
  when s.contains("saved OAuth tokens") && s.contains("openai")
  | adopt_chatgpt()

fun do_login_oauth_start(prov :: String):
  try:
    api.notify(oauth.begin_oauth(prov, config.providers,
                                 ~notify: login_notify))
    ~catch e :: Exn.Fail:
      api.notify("oauth failed: " +& e.message)

fun do_login_oauth_finish(prov :: String, raw :: String):
  try:
    login_notify(oauth.complete_oauth(prov, raw, config.providers))
    ~catch e :: Exn.Fail:
      api.notify("oauth failed: " +& e.message)

registry.register_command(
  ~name: "login",
  ~description: "store credentials: /login <provider> [oauth [code]|<api-key>]",
  ~handler: fun (args):
              let parts = args.trim().split(" ")
              cond
              | args.trim() == "":
                  match auth_list()
                  | []: api.notify("no stored credentials; /login <provider> oauth  or  /login <provider> <key>")
                  | ps: api.notify("stored credentials: " +& String.join(ps, ", "))
              | ~else:
                  let prov = to_string(parts[0])
                  let rest = (if parts.length() > 1 | String.join(parts.rest, " ").trim() | "")
                  let has_oauth = oauth.supports_oauth(prov, config.providers)
                  cond
                  | rest == "oauth" || rest == "":
                      if has_oauth
                      | do_login_oauth_start(prov)
                      | api.notify("no OAuth for " +& prov +& "; /login " +& prov +& " <api-key>")
                  | rest.starts_with("oauth "):
                      do_login_oauth_finish(prov, rest.substring(6..).trim())
                  | rest == "key":
                      api.notify("usage: /login " +& prov +& " <api-key>")
                  | ~else:
                      do_login_key(prov, rest))

registry.register_command(
  ~name: "logout",
  ~description: "remove a stored API key: /logout <provider>",
  ~handler: fun (args):
              let prov = args.trim()
              cond
              | prov == "": api.notify("usage: /logout <provider>")
              | auth_remove(prov): api.notify("removed key for " +& prov)
              | ~else: api.notify("no stored key for " +& prov))

fun auto_compact():
  when compaction.needs_compaction(session, config)
      && config.settings.get("auto_compaction", #true) != #false
      && session_event_ok("session_before_compact", { "auto": #true })
  | api.notify("context is near the window limit; compacting\u2026")
    api.notify(compaction.compact(~session: session, ~config: config))
    registry.emit("session_compact", { "auto": #true })

// Refresh session-scoped environment variables so bash commands and
// subprocesses spawned by the agent see the current session/provider/model.
// Also exposes them via registry.state for extensions.
fun refresh_session_env():
  let sid = (if session.path is_a String | session.path | "")
  let thinking = (if config.thinking | config.thinking | "off")
  registry.state["env_session_id"] := sid
  registry.state["env_session_file"] := sid
  registry.state["env_provider"] := config.provider
  registry.state["env_model"] := config.model
  registry.state["env_thinking"] := thinking
  putenv("RHO_SESSION_ID", sid)
  putenv("RHO_SESSION_FILE", sid)
  putenv("RHO_PROVIDER", config.provider)
  putenv("RHO_MODEL", config.model)
  putenv("RHO_REASONING_LEVEL", thinking)

fun prepare_turn():
  refresh_session_env()
  let r = drain_pending_fit()
  when r != ""
  | api.notify(r)
  auto_compact()

// Also expose reload as a tool so the agent can activate its own extensions.
registry.register_tool(
  ~name: "reload_extensions",
  ~description: "Hot-reload agent extensions from the extension directories. Call after writing or editing an extension file to activate it.",
  ~schema: { "type": "object", "properties": {}, "required": [] },
  ~fn: fun (_args):
         let [ok, failed] = loader.load_extensions(registry, api,
                                                   ~notify: fun (s): api.notify(s),
                                                   ~extra_dirs: packages.package_extension_dirs(),
                                                   ~include_project: project_trusted)
         "extensions reloaded: " +& ok +& " ok, " +& failed +& " failed")

// ---- skills & prompt templates ----
registry.register_command(
  ~name: "skills", ~description: "list discovered skills",
  ~handler: fun (_args):
              let found = discover_skills()
              if found == []
              | api.notify("no skills found (put SKILL.md dirs in .rho/skills or ~/.rho/skills)")
              | for (s in found):
                  out.write_string("  " +& s["name"] +& " \u2014 " +& s["description"]
                                     +& " (" +& s["path"] +& ")\n"))
registry.register_command(
  ~name: "prompts", ~description: "list prompt templates (run one with /<name>)",
  ~handler: fun (_args):
              let found = discover_prompts()
              if found == []
              | api.notify("no templates found (put .md files in .rho/prompts or ~/.rho/prompts)")
              | for (t in found):
                  out.write_string("  /" +& t["name"]
                                     +& (if t["argument_hint"] == "" | "" | " " +& t["argument_hint"])
                                     +& " \u2014 " +& t["description"] +& "\n"))

// ---- wire up ----
fun handle_command(name :: String, args :: String):
  match registry.find_command(name)
  | c :: Command: c.handler(args)
  | ~else:
      cond
      | name.starts_with("skill:"):
          let sname = name.substring(6..)
          match skills.find_skill(sname, ~cwd: cwd(),
                                  ~extra: packages.package_skill_dirs(),
                                  ~include_project: project_trusted)
          | s :: Map:
              let content = filesystem.read_string(s["path"])
              handle_input("Load and follow this skill now.\n\n<skill source=\""
                             +& s["path"] +& "\">\n" +& content +& "\n</skill>"
                             +& (if args.trim() == "" | "" | "\n\nTask: " +& args))
          | ~else: api.notify("unknown skill: " +& sname +& " (see /skills)")
      | ~else:
          match prompts.find_template(name, ~cwd: cwd(),
                                      ~extra: packages.package_prompt_dirs(),
                                      ~include_project: project_trusted)
          | t :: Map: handle_input(prompts.expand(t, args))
          | ~else: api.notify("unknown command: /" +& name +& " (try /help)")

// @image.png CLI attachments ride along on the first turn only
def mutable pending_cli_images :: List:
  for List (p in opts.get("cli_images", [])):
    encode_image(to_string(p))

fun take_cli_images() :: List:
  let l = pending_cli_images
  pending_cli_images := []
  l

fun set_turn_ui(~on_text: on_text,
                ~on_thinking: on_thinking = fun (s): #void,
                ~on_tool: on_tool,
                ~on_tool_result: on_tool_result,
                ~on_sub_text: on_sub_text = #false,
                ~on_sub_think: on_sub_think = #false,
                ~on_sub_tool: on_sub_tool = #false,
                ~on_sub_result: on_sub_result = #false):
  registry.state["on_text"] := on_text
  registry.state["on_thinking"] := on_thinking
  registry.state["on_tool"] := on_tool
  registry.state["on_tool_result"] := on_tool_result
  registry.state["on_sub_text"] := on_sub_text
  registry.state["on_sub_think"] := on_sub_think
  registry.state["on_sub_tool"] := on_sub_tool
  registry.state["on_sub_result"] := on_sub_result

fun handle_input(input :: String):
  prepare_turn()
  set_turn_ui(
    ~on_text: fun (s):
                out.write_string(s)
                out.flush(),
    ~on_thinking: fun (s):
                    out.write_string(color("2;3", s))
                    out.flush(),
    ~on_tool: fun (name, args):
                out.write_string("\n" +& color("2", "\u25CF " +& name +& " "
                                                 +& summarize(args)) +& "\n")
                out.flush(),
    ~on_tool_result: fun (name, r):
                       out.write_string(color("2", "  \u21B3 " +& first_line(r)) +& "\n")
                       out.flush(),
    ~on_sub_text: fun (s):
                    out.write_string(s)
                    out.flush(),
    ~on_sub_think: fun (s):
                     out.write_string(color("2;3", s))
                     out.flush(),
    ~on_sub_tool: fun (name, args):
                    out.write_string("\n" +& color("2", "  \u2502 \u25CF " +& name +& " "
                                                     +& summarize(args)) +& "\n")
                    out.flush(),
    ~on_sub_result: fun (name, r):
                      out.write_string(color("2", "  \u2502 \u21B3 " +& first_line(r)) +& "\n")
                      out.flush())
  run_turn(~config: config,
           ~registry: registry,
           ~session: session,
           ~system_prompt: system_prompt(),
           ~input: input,
           ~images: take_cli_images(),
           ~on_text: fun (s):
                       out.write_string(s)
                       out.flush(),
           ~on_thinking: fun (s):
                           out.write_string(color("2;3", s))
                           out.flush(),
           ~on_tool: fun (name, args):
                       out.write_string("\n" +& color("2", "\u25CF " +& name +& " "
                                                        +& summarize(args)) +& "\n")
                       out.flush(),
           ~on_tool_result: fun (name, r):
                              out.write_string(color("2", "  \u21B3 " +& first_line(r)) +& "\n")
                              out.flush(),
           ~on_steer: fun (s):
                        out.write_string(color("33", "\u21AA steering: " +& s) +& "\n")
                        out.flush())
  out.write_string("\n")
  auto_compact()

fun summarize(args :: Map) :: String:
  let cmd = args.get("command", #false)
  let s:
    if cmd is_a String && cmd != ""
    | cmd
    | to_string(args)
  if s.length() > 80 | s.substring(0..80) +& "\u2026" | s

fun first_line(s :: String) :: String:
  let lines = s.split("\n")
  cond
  | lines == []: ""
  | lines.length() == 1: to_string(lines[0])
  | ~else: to_string(lines[0]) +& " \u2026"

def banner:
  if settings.get("quiet_startup", #false) == #true
  | ""
  | color("1;35", "rho") +& " \u2014 hot-reloadable Rhombus coding agent\n"
      +& "provider=" +& config.provider +& " model=" +& config.model
      +& " ctx-window=" +& models.model_info(config.model)["context_window"] +& "\n"
      +& "session=" +& (if session.path is_a String | session.path | "(none)")
      +& (if session.entries.length() > 1
          | " (" +& session.entries.length() +& " entries resumed)"
          | "")
      +& "\n"
      +& "type /help for commands\n\n"

// ---- headless mode ----
fun emit_json(m :: Map):
  out.write_string(json.to_string(m) +& "\n")
  out.flush()

fun stdin_text() :: String:
  let stdin = rkt.#{current-input-port}()
  if rkt.#{terminal-port?}(stdin)
  | ""
  | to_string(rktport.#{port->string}(stdin))

fun headless_prompt() :: String:
  let msg = String.join(opts["message"], " ")
  let piped = stdin_text()
  cond
  | piped == "": msg
  | msg == "": piped
  | ~else: msg +& "\n\n" +& piped

fun run_headless():
  let input = headless_prompt()
  when input.trim() == ""
  | println("error: no prompt (pass a message argument or pipe stdin)")
    rkt.exit(1)
  when json_mode
  | // output guard: stray prints must not corrupt the JSONL stream
    rkt.#{current-output-port}(rkt.#{current-error-port}())
    emit_json({ "type": "session_start",
                "session": (if session.path is_a String | session.path | ""),
                "provider": config.provider, "model": config.model })
  run_turn(~config: config,
           ~registry: registry,
           ~session: session,
           ~system_prompt: system_prompt(),
           ~input: input,
           ~images: take_cli_images(),
           ~on_thinking:
             if json_mode
             | fun (s): emit_json({ "type": "thinking", "text": s })
             | fun (s): #void,
           ~on_text:
             if json_mode
             | fun (s): emit_json({ "type": "text", "text": s })
             | fun (s):
                 out.write_string(s)
                 out.flush(),
           ~on_tool:
             if json_mode
             | fun (name, args): emit_json({ "type": "tool_call", "name": name, "args": args })
             | fun (name, args): #void,
           ~on_tool_result:
             if json_mode
             | fun (name, r): emit_json({ "type": "tool_result", "name": name, "result": r })
             | fun (name, r): #void)
  if json_mode
  | emit_json({ "type": "done",
                "session": (if session.path is_a String | session.path | "") })
  | out.write_string("\n")

// ---- TUI mode ----
fun load_theme() :: Map:
  match opts.get("theme", config.settings.get("theme", #false))
  | name :: String:
      let path = config_dir() +& "/themes/" +& name +& ".json"
      if filesystem.file_exists(path)
      | let parsed = try:
                       json.from_string(filesystem.read_string(path))
                       ~catch _: {}
        if parsed is_a Map | parsed | {}
      | (block:
           println("warning: theme not found: " +& path)
           {})
  | ~else: {}

fun renderer_for(name :: String):
  match registry.state.get("tool_renderers", #false)
  | m :: MutableMap: m.get(name, #false)
  | ~else: #false

fun render_tool(phase :: String, name :: String, data) :: maybe(String):
  let fn = renderer_for(name)
  if fn
  | try:
      let r = fn(phase, name, data)
      if r is_a String | r | #false
      ~catch _: #false
  | #false

fun tui_footer() :: String:
  let t = usage_totals()
  " " +& cwd() +& "  \u2502 " +& config.provider +& "/" +& config.model
    +& (if config.thinking | " \u00B7 think:" +& config.thinking | "")
    +& (if permission_mode(config) == "ask" | " \u00B7 ask" | "")
    +& "  \u2502 tok " +& t["input"] +& "/" +& t["output"]
    +& " $" +& round2(t["cost"])
    +& (if session.name == "" | "" | "  \u2502 " +& session.name)

def provider_ring = ["kimi", "openai-codex", "openai", "anthropic", "openrouter", "ollama"]

// scoped models (pi): --models a,b or settings enabled_models restrict the
// Ctrl-P cycle to a hand-picked list ("provider/model" or bare model names)
def mutable scoped_models :: List:
  match opts.get("models", #false)
  | l :: List: l
  | ~else:
      match settings.get("enabled_models", #false)
      | l :: List: (for List (x in l): to_string(x))
      | ~else: []

fun cycle_next_provider() :: String:
  let avail:
    for List (p in provider_ring):
      skip_when !config.providers.has_key(p)
      p
  cond
  | avail == []: "no providers to cycle"
  | ~else:
      let idx:
        for values(found = 0) (i in 0 .. avail.length()):
          if avail[i] == config.provider | i | found
      let next = avail[(idx + 1) mod avail.length()]
      config.provider := next
      config.model := config.providers[next].get("default_model", config.model)
      "model: " +& config.provider +& "/" +& config.model

fun cycle_model() :: String:
  cond
  | scoped_models != []:
      let cur = config.provider +& "/" +& config.model
      let idx:
        for values(found = -1) (i in 0 .. scoped_models.length()):
          let e = to_string(scoped_models[i])
          if e == cur || e == config.model | i | found
      let next = to_string(scoped_models[(idx + 1) mod scoped_models.length()])
      set_model(next, ~compact: #false)
  | ~else:
      guarded_apply(~compact: #false, cycle_next_provider)

registry.register_command(
  ~name: "scoped-models",
  ~description: "restrict Ctrl-P model cycling: /scoped-models [a,b,c | clear]",
  ~handler: fun (args):
              let a = args.trim()
              cond
              | a == "":
                  if scoped_models == []
                  | api.notify("no scoped models (Ctrl-P cycles providers); /scoped-models a,b,c")
                  | api.notify("scoped models: "
                                 +& String.join((for List (m in scoped_models): to_string(m)), ", "))
              | a == "clear":
                  scoped_models := []
                  settings.set_global("enabled_models", [])
                  api.notify("scoped models cleared")
              | ~else:
                  scoped_models := split_list(a)
                  settings.set_global("enabled_models", scoped_models)
                  api.notify("scoped models: " +& String.join(scoped_models, ", ")
                               +& " (Ctrl-P cycles)"))

// Shift-Tab: cycle the thinking level
def thinking_ring = [#false, "minimal", "low", "medium", "high", "xhigh", "max"]

// level -> description shown in the /thinking selector (pi-style)
def thinking_level_desc :: Map:
  { "off": "no reasoning",
    "minimal": "minimal reasoning (~1k tokens)",
    "low": "light reasoning (~4k tokens)",
    "medium": "moderate reasoning (~8k tokens)",
    "high": "deep reasoning (~16k tokens)",
    "xhigh": "extra-deep reasoning (~32k tokens)",
    "max": "maximum reasoning (~64k tokens)" }

fun set_thinking(level :: String) :: String:
  cond
  | level == "off":
      config.thinking := #false
      registry.emit("thinking_level_select", { "level": level })
      "thinking: off"
  | thinking_level_desc.has_key(level):
      if model_supports_thinking()
      | config.thinking := level
        registry.emit("thinking_level_select", { "level": level })
        "thinking: " +& level +& " (" +& thinking_level_desc[level] +& ")"
      | config.model +& " does not support thinking"
  | ~else: "unknown level: " +& level +& " (off, minimal, low, medium, high, xhigh, max)"

fun cycle_thinking() :: String:
  cond
  | !model_supports_thinking():
      "thinking: off (" +& config.model +& " does not support thinking)"
  | ~else:
      let idx:
        for values(found = 0) (i in 0 .. thinking_ring.length()):
          if thinking_ring[i] == config.thinking | i | found
      config.thinking := thinking_ring[(idx + 1) mod thinking_ring.length()]
      registry.emit("thinking_level_select",
                    { "level": (if config.thinking | config.thinking | "off") })
      "thinking: " +& (if config.thinking | config.thinking | "off")

registry.register_command(
  ~name: "thinking",
  ~description: "reasoning effort: /thinking [off|minimal|low|medium|high|xhigh|max] (chain of thought shows dim, Ctrl-T hides)",
  ~handler: fun (args):
              let level = args.trim()
              if level == ""
              | api.notify("thinking: " +& (if config.thinking | config.thinking | "off")
                             +& (if model_supports_thinking()
                                 | ""
                                 | " (" +& config.model +& " has no thinking support)"))
              | api.notify(set_thinking(level)))

// last assistant text on the active session path (for Ctrl-X / /copy)
fun last_assistant_text() :: String:
  for values(found = "") (m in session.messages()):
    if m.get("role", "") == "assistant" && m.get("content", "") != ""
    | to_string(m["content"])
    | found

registry.register_command(
  ~name: "copy", ~description: "copy the last assistant message to the clipboard",
  ~handler: fun (_args):
              let text = last_assistant_text()
              if text == ""
              | api.notify("nothing to copy")
              | tui.copy_text(text)
                api.notify("copied " +& text.length() +& " chars"))

fun tui_shell(text :: String) :: String:
  let double = text.starts_with("!!")
  let cmd = text.substring(if double | 2 | 1 ..).trim()
  let tool = registry.tools.get("bash", #false)
  cond
  | cmd == "": "(empty command)"
  | !tool: "(bash tool unavailable)"
  | ~else:
      registry.emit("user_bash", { "command": cmd, "to_context": double })
      let result = to_string(tool.fn({ "command": cmd }))
      when double
      | session.append_message({ "role": "user",
                                 "content": "I ran `" +& cmd +& "` and got:\n" +& result })
      result

fun handle_input_tui(input :: String):
  prepare_turn()
  set_turn_ui(
    ~on_text: fun (s):
                tui.set_activity("responding")
                tui.push_delta(s),
    ~on_thinking: fun (s):
                    tui.set_activity("thinking")
                    tui.push_think_delta(s),
    ~on_tool: fun (name, args):
                tui.set_activity("tool: " +& name)
                tui.push("tool",
                         render_tool("call", name, args)
                           || "\u25CF " +& name +& " " +& summarize(args)),
    ~on_tool_result: fun (name, r):
                       tui.set_activity("thinking")
                       tui.push_block("tool_result",
                                      render_tool("result", name, r)
                                        || "  \u21B3 " +& to_string(r)),
    ~on_sub_text: fun (s):
                    let lab = to_string(registry.state.get("subagent_label", "subagent"))
                    tui.set_activity("sub-agent " +& lab)
                    tui.push_delta_kind("subagent", s),
    ~on_sub_think: fun (s):
                     let lab = to_string(registry.state.get("subagent_label", "subagent"))
                     tui.set_activity("sub-agent " +& lab +& " thinking")
                     tui.push_think_delta(s),
    ~on_sub_tool: fun (name, args):
                    let lab = to_string(registry.state.get("subagent_label", "subagent"))
                    tui.set_activity("sub-agent " +& lab +& ": " +& name)
                    tui.push("tool",
                             "  \u2502 \u25CF " +& name +& " " +& summarize(args)),
    ~on_sub_result: fun (name, r):
                      tui.push_block("tool_result",
                                     "  \u2502 \u21B3 " +& to_string(r)))
  run_turn(~config: config,
           ~registry: registry,
           ~session: session,
           ~system_prompt: system_prompt(),
           ~input: input,
           ~images: take_cli_images() ++ tui.take_paste_images(),
           ~on_text: fun (s):
                       tui.set_activity("responding")
                       tui.push_delta(s),
           ~on_thinking: fun (s):
                           tui.set_activity("thinking")
                           tui.push_think_delta(s),
           ~on_tool: fun (name, args):
                       tui.set_activity("tool: " +& name)
                       tui.push("tool",
                                render_tool("call", name, args)
                                  || "\u25CF " +& name +& " " +& summarize(args)),
           ~on_tool_result: fun (name, r):
                              tui.set_activity("thinking")
                              // full text as one block: folds to the first
                              // line in the TUI, Ctrl-O expands
                              tui.push_block("tool_result",
                                             render_tool("result", name, r)
                                               || "  \u21B3 " +& to_string(r)))
  auto_compact()

registry.register_command(
  ~name: "hotkeys", ~description: "list TUI keyboard shortcuts",
  ~handler: fun (_args):
              out.write_string("Enter submit \u00B7 Ctrl-J newline \u00B7 Alt-Enter queue follow-up \u00B7 Tab complete path (@token fuzzy)\n"
                                 +& "Up/Down history or cursor \u00B7 PgUp/PgDn or mouse wheel scroll\n"
                                 +& "mouse drag selects + copies on release (Shift+drag for native terminal selection)\n"
                                 +& "Ctrl-C interrupt/clear/quit \u00B7 Esc interrupt (queued follow-ups return to editor)\n"
                                 +& "Ctrl-G external editor \u00B7 Ctrl-X copy last reply \u00B7 Ctrl-O expand/fold tool output\n"
                                 +& "Ctrl-T show/hide chain of thought \u00B7 Shift-Tab or /thinking cycle thinking level\n"
                                 +& "Ctrl-K kill to EOL \u00B7 Ctrl-W kill word \u00B7 Ctrl-Y yank \u00B7 Alt-Y yank-pop \u00B7 Ctrl-U kill line\n"
                                 +& "Ctrl-P cycle scoped models/providers \u00B7 Ctrl-L redraw \u00B7 Ctrl-D quit\n"
                                 +& "permission card: 1/y/Enter allow \u00B7 2/n/Esc deny \u00B7 click [1]/[2]\n"
                                 +& "!cmd run shell \u00B7 !!cmd run shell + add to context \u00B7 /follow queue follow-up\n"
                                 +& "remap: ~/.rho/keybindings.json (external_editor, copy_last, toggle_tool_output, toggle_thinking, cycle_thinking, queue_followup, kill_line, yank, kill_word, yank_pop)\n"))

// command menu entries: registered commands + prompt templates + quit/exit
fun tui_commands() :: List:
  (for List (c in registry.command_list()): [c.name, c.description])
    ++ (for List (t in discover_prompts()):
          [t["name"], "(prompt) " +& t["description"]])
    ++ [["quit", "exit rho"], ["exit", "exit rho"]]

// argument completions for /model and /provider (env key or /login auth)
fun tui_arg_complete(cmd :: String, prefix :: String):
  cond
  | cmd == "model":
      let lp = prefix.foldcase()
      for List:
        each entry in available_model_entries()
        let [full, desc] = entry
        skip_when !full.foldcase().contains(lp)
        let slash:
          for values(found = #false) (i in 0 .. full.length()):
            found || (full[i] == Char"/" && i)
        let label:
          if slash is_a Int
          | modelsdev.provider_label(full.substring(0 .. slash))
              +& " / " +& full.substring(slash + 1 ..)
          | full
        [full, label, desc]
  | cmd == "provider":
      let lp = prefix.foldcase()
      for List:
        each group in available_provider_groups()
        let [pname, mdls] = group
        let label = modelsdev.provider_label(pname)
        skip_when !(pname.foldcase().contains(lp) || label.foldcase().contains(lp))
        [pname, label, mdls.keys().length() +& " models"]
  | cmd == "thinking":
      let lp = prefix.foldcase()
      let supported = model_supports_thinking()
      for List:
        each level in ["off", "low", "medium", "high"]
        skip_when !level.starts_with(lp)
        let desc = to_string(thinking_level_desc[level])
        let desc:
          cond
          | level != "off" && !supported: desc +& " \u2014 not supported by " +& config.model
          | (if level == "off" | !config.thinking | config.thinking == level):
              desc +& " (current)"
          | ~else: desc
        [level, level, desc]
  | cmd == "resume" || cmd == "session-rename" || cmd == "session-delete":
      let lp = prefix.foldcase()
      for List:
        each s in list_sessions(cwd())
        let parts = to_string(s["path"]).split("/")
        let fname = to_string(parts[parts.length() - 1])
        let desc = session_age(s["mtime"])
                     +& (if s["name"] == "" | "" | " [" +& s["name"] +& "]")
                     +& " " +& s["preview"]
        skip_when !(fname +& " " +& desc).foldcase().contains(lp)
        [to_string(s["path"]), fname, desc]
  | cmd == "settings":
      let parts = prefix.split(" ")
      cond
      | parts.length() <= 1:
          let lp = prefix.foldcase()
          for List:
            each key in settings.known_keys.keys().sort()
            skip_when !key.foldcase().contains(lp)
            let [desc, _] = settings.known_keys[key]
            [to_string(key), to_string(key), to_string(desc)]
      | ~else:
          let key = to_string(parts[0])
          let vp = to_string(parts[parts.length() - 1]).foldcase()
          let spec = settings.known_keys.get(key, #false)
          let choices:
            match (if spec is_a List | spec[1] | #false)
            | l :: List: l
            | "bool": ["true", "false"]
            | ~else: []
          for List:
            each c in choices
            skip_when !to_string(c).foldcase().starts_with(vp)
            [key +& " " +& c, to_string(c), ""]
  | cmd == "permission":
      let lp = prefix.foldcase()
      for List:
        each m in ["allow", "ask"]
        skip_when !m.starts_with(lp)
        [m, m, (if m == "ask"
                | "prompt before write/bash tools"
                | "run tools without prompting")]
  | cmd == "mcp":
      let lp = prefix.foldcase()
      for List:
        each m in ["list", "reload", "stop"]
        skip_when !m.starts_with(lp)
        [m, m, ""]
  | ~else: #false

// extension message renderers (register_message_renderer): first hit wins
fun render_entry_ext(kind, text):
  for values(found = #false) (fn in registry.state.get("message_renderers", [])):
    found || (try:
                fn(kind, text)
                ~catch _: #false)

fun run_tui_mode():
  // live bash output: show the latest line on the TUI status row
  set_stream_handler(fun (line):
                       let l = to_string(line)
                       let shown = (if l.length() > 60 | l.substring(0 .. 60) +& "\u2026" | l)
                       tui.set_activity("bash: " +& shown))
  // extension UI hooks route into the TUI
  ui_hooks["set_status"] := fun (s): tui.set_activity(s)
  ui_hooks["set_widget"] := fun (id, text): tui.set_widget(to_string(id), text)
  ui_hooks["set_footer"] := fun (s): tui.set_footer_extra(to_string(s))
  // route notify/command prints into the TUI transcript
  let (pin, pout) = rkt.#{make-pipe}()
  out := pout
  rkt.thread(fun ():
               recur go():
                 match rkt.#{read-line}(pin, #'any)
                 | s :: ReadableString:
                     tui.push("notify", to_string(s))
                     go()
                 | ~else: #void)
  let tui_mode = opts.get("tui_mode", config.settings.get("tui_mode", "tui"))
  tui.run_tui(~theme: load_theme(),
              ~theme_loader: fun (): load_theme(),
              ~tui_mode: tui_mode,
              ~banner: banner +& "TUI: type / for the command menu, /hotkeys for keys\n",
              ~handle_command: handle_command,
              ~handle_input: handle_input_tui,
              ~footer: tui_footer,
              ~cycle_model: cycle_model,
              ~cycle_thinking: cycle_thinking,
              ~shell_exec: tui_shell,
              ~tool_line: render_entry_ext,
              ~commands: tui_commands,
              ~arg_complete: tui_arg_complete,
              ~editor_cmd: fun ():
                             match settings.get("external_editor", #false)
                             | s :: String: s
                             | ~else:
                                 getenv("VISUAL") || getenv("EDITOR") || "",
              ~last_assistant: last_assistant_text,
              ~keybind: fun (action, default):
                          settings.keybinding(action, to_string(default)),
              ~shortcuts: fun (): registry.state.get("shortcuts", #false),
              ~markdown_transformers: fun (): registry.state.get("markdown_transformers", []),
              ~clicks: fun (): registry.state.get("clicks", #false),
              ~pending_ask: pending_ask_state,
              ~bind_ask: bind_ask_state)

fun install_repl_ask():
  def mutable ask_sema = #false
  def mutable ask_answer = "deny"
  def mutable ask_waiting = #false
  fun wait_ask():
    ask_sema := rkt.#{make-semaphore}(0)
    ask_answer := "deny"
    ask_waiting := #true
    let ask = registry.state.get("pending_ask", {})
    let name:
      cond
      | ask is_a Map: to_string(ask.get("toolName", "tool"))
      | ~else: "tool"
    out.write_string("allow " +& name +& " [y/N] ")
    out.flush()
    rkt.#{semaphore-wait}(ask_sema)
    ask_answer
  fun reply_ask(d :: String):
    when ask_waiting
    | ask_waiting := #false
      ask_answer := d
      match ask_sema
      | #false: #void
      | sema: rkt.#{semaphore-post}(sema)
  registry.state["ask_reply"] := wait_ask
  registry.state["answer_ask"] := reply_ask

fun pending_ask_state():
  registry.state.get("pending_ask", #false)

fun bind_ask_state(w):
  registry.state["ask_reply"] := w

fun reply_ask_state(d):
  match registry.state.get("answer_ask", #false)
  | fn :: Function: fn(d)
  | ~else: #void

fun stdin_is_tty():
  rkt.#{terminal-port?}(rkt.#{current-input-port}())

// ---- project trust ----
fun ensure_trust() :: Boolean:
  cond
  | opts.get("approve", #false): #true       // -a: one-shot trust, not saved
  | opts.get("no_approve", #false): #false   // -na: one-shot distrust
  | !filesystem.directory_exists(cwd() +& "/.rho"): #true
  | ~else:
      match trust.trust_status(cwd())
      | #'trusted: #true
      | #'untrusted: #false
      | ~else:
          cond
          | headless || !stdin_is_tty():
              config.settings.get("default_project_trust", "ignore") == "trust"
          | ~else:
              out.write_string("This project has a .rho/ directory (extensions, skills, prompts).\n"
                                 +& "Trust it? Its code will run inside the agent. [y/N] ")
              out.flush()
              let ans = read_stdin_line()
              let yes = ans.starts_with("y") || ans.starts_with("Y")
              trust.set_trust(cwd(), yes)
              api.notify(if yes | "project trusted (saved)" | "project ignored (saved)")
              yes

fun init_trust():
  project_trusted := ensure_trust()
  // a just-approved project unlocks its .rho/settings.json
  when project_trusted
  | settings.reload(~include_project: #true)
    apply_settings()

// ---- RPC mode: JSON lines over stdin/stdout ----
fun run_rpc():
  // output guard: emit_json keeps the real stdout; stray prints (extension
  // handlers, debug output) are diverted to stderr so the protocol stays clean
  rkt.#{current-output-port}(rkt.#{current-error-port}())
  def mutable turn_t = #false
  def mutable bash_t = #false
  def mutable followups :: List = []
  let qlock = rkt.#{make-semaphore}(1)
  fun locked(thunk):
    rkt.#{semaphore-wait}(qlock)
    let r = thunk()
    rkt.#{semaphore-post}(qlock)
    r
  fun turn_running():
    turn_t && !rkt.#{thread-dead?}(turn_t)
  fun do_run_turn(msg :: String):
    prepare_turn()
    set_turn_ui(
      ~on_text: fun (x): emit_json({ "type": "text", "text": x }),
      ~on_tool: fun (name, args):
                  emit_json({ "type": "tool_call", "name": name, "args": args }),
      ~on_tool_result: fun (name, r):
                         emit_json({ "type": "tool_result", "name": name, "result": r }),
      ~on_sub_text: fun (x):
                      emit_json({ "type": "subagent_text",
                                  "label": registry.state.get("subagent_label", "subagent"),
                                  "text": x }),
      ~on_sub_think: fun (x):
                       emit_json({ "type": "subagent_thinking",
                                   "label": registry.state.get("subagent_label", "subagent"),
                                   "text": x }),
      ~on_sub_tool: fun (name, args):
                      emit_json({ "type": "subagent_tool",
                                  "label": registry.state.get("subagent_label", "subagent"),
                                  "name": name, "args": args }),
      ~on_sub_result: fun (name, r):
                        emit_json({ "type": "subagent_tool_result",
                                    "label": registry.state.get("subagent_label", "subagent"),
                                    "name": name, "result": r }))
    run_turn(~config: config,
             ~registry: registry,
             ~session: session,
             ~system_prompt: system_prompt(),
             ~input: msg,
             ~on_text: fun (x): emit_json({ "type": "text", "text": x }),
             ~on_tool: fun (name, args):
                         emit_json({ "type": "tool_call", "name": name, "args": args }),
             ~on_tool_result: fun (name, r):
                                emit_json({ "type": "tool_result", "name": name, "result": r }),
             ~on_steer: fun (x): emit_json({ "type": "steering_applied", "message": x }))
  // the turn thread drains queued follow-ups before finishing
  fun turn_loop(msg :: String):
    do_run_turn(msg)
    emit_json({ "type": "done" })
    auto_compact()
    let next:
      locked(fun ():
               match followups
               | []: #false
               | [first, & rest]:
                   followups := rest
                   to_string(first))
    when next is_a String
    | emit_json({ "type": "follow_up_started", "message": next })
      turn_loop(next)
  fun start_turn(msg :: String):
    turn_t := rkt.thread(fun ():
                           try:
                             turn_loop(msg)
                             ~catch:
                             | e :: Exn.Break: emit_json({ "type": "aborted" })
                             | e :: Exn.Fail: emit_json({ "type": "error", "message": e.message }))
  emit_json({ "type": "ready",
              "session": (if session.path is_a String | session.path | ""),
              "provider": config.provider, "model": config.model })
  recur loop():
    match rkt.#{read-line}(rkt.#{current-input-port}(), #'any)
    | s :: ReadableString:
        let req = try:
                    json.from_string(to_string(s))
                    ~catch _: {}
        let req = (if req is_a Map | req | {})
        match req.get("type", "")
        | "prompt":
            cond
            | turn_running():
                emit_json({ "type": "error", "message": "turn already running (use steer or follow_up)" })
            | ~else: start_turn(to_string(req.get("message", "")))
            loop()
        | "steer":
            if turn_running()
            | rkt.#{thread-send}(turn_t, to_string(req.get("message", "")))
              emit_json({ "type": "steering_queued" })
            | emit_json({ "type": "error", "message": "no turn running" })
            loop()
        | "follow_up":
            let msg = to_string(req.get("message", ""))
            if turn_running()
            | locked(fun (): followups := followups.add(msg))
              emit_json({ "type": "follow_up_queued", "queued": followups.length() })
            | start_turn(msg)
            loop()
        | "abort":
            when turn_running()
            | rkt.#{break-thread}(turn_t)
              rkt.#{thread-wait}(turn_t)
            locked(fun (): followups := [])
            emit_json({ "type": "aborted" })
            loop()
        | "get_state":
            emit_json({ "type": "state",
                        "provider": config.provider, "model": config.model,
                        "thinking": (if config.thinking | config.thinking | "off"),
                        "session": (if session.path is_a String | session.path | ""),
                        "leaf": (if session.leaf is_a Int | session.leaf | -1),
                        "turn_running": turn_running() == #true,
                        "queued_followups": followups.length() })
            loop()
        | "get_entries":
            let since = req.get("since", -1)
            let since = (if since is_a Int | since | -1)
            let es:
              for List (e in session.entries):
                skip_when e["id"] <= since
                e
            emit_json({ "type": "entries", "entries": es,
                        "leaf": (if session.leaf is_a Int | session.leaf | -1) })
            loop()
        | "get_tree":
            emit_json({ "type": "tree", "entries": session.entries,
                        "leaf": (if session.leaf is_a Int | session.leaf | -1),
                        "labels": session.labels() })
            loop()
        | "get_last_assistant_text":
            emit_json({ "type": "last_assistant_text", "text": last_assistant_text() })
            loop()
        | "set_steering_mode":
            let mode = to_string(req.get("mode", "all"))
            registry.state["steering_mode"] := mode
            emit_json({ "type": "steering_mode", "mode": mode })
            loop()
        | "set_auto_compaction":
            let enabled = req.get("enabled", #true) == #true
            config.settings := config.settings ++ { "auto_compaction": enabled }
            emit_json({ "type": "auto_compaction", "enabled": enabled })
            loop()
        | "compact":
            if turn_running()
            | emit_json({ "type": "error", "message": "turn running" })
            | let r = try:
                        compaction.compact(~session: session, ~config: config,
                                           ~instructions: to_string(req.get("instructions", "")))
                        ~catch e :: Exn.Fail: "error: " +& e.message
              emit_json({ "type": "compacted", "result": to_string(r) })
            loop()
        | "export_html":
            let target = to_string(req.get("path", "session.html"))
            try:
              export_html(target)
              emit_json({ "type": "exported", "path": target })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "bash":
            cond
            | bash_t && !rkt.#{thread-dead?}(bash_t):
                emit_json({ "type": "error", "message": "bash already running (abort_bash first)" })
            | ~else:
                let cmd = to_string(req.get("command", ""))
                let tool = registry.tools.get("bash", #false)
                if !tool
                | emit_json({ "type": "error", "message": "bash tool unavailable" })
                | bash_t := rkt.thread(fun ():
                                         let r = try:
                                                   to_string(tool.fn({ "command": cmd }))
                                                   ~catch:
                                                   | e :: Exn.Break: "(aborted)"
                                                   | e :: Exn.Fail: "error: " +& e.message
                                         emit_json({ "type": "bash_result", "result": r }))
            loop()
        | "abort_bash":
            when bash_t && !rkt.#{thread-dead?}(bash_t)
            | rkt.#{break-thread}(bash_t)
            emit_json({ "type": "bash_aborted" })
            loop()
        | "set_model":
            try:
              set_model(to_string(req.get("model", "")))
              emit_json({ "type": "model",
                          "provider": config.provider,
                          "model": config.model })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "cycle_model":
            try:
              cycle_model()
              emit_json({ "type": "model",
                          "provider": config.provider,
                          "model": config.model })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "get_available_models":
            emit_json({ "type": "available_models",
                        "models": available_model_entries() })
            loop()
        | "set_thinking_level":
            try:
              set_thinking(to_string(req.get("level", "")))
              emit_json({ "type": "thinking_level",
                          "level": (if config.thinking | config.thinking | "off") })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "cycle_thinking_level":
            try:
              cycle_thinking()
              emit_json({ "type": "thinking_level",
                          "level": (if config.thinking | config.thinking | "off") })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "get_available_thinking_levels":
            emit_json({ "type": "thinking_levels",
                        "levels": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
                        "current": (if config.thinking | config.thinking | "off") })
            loop()
        | "set_follow_up_mode":
            let mode = to_string(req.get("mode", "all"))
            registry.state["followup_mode"] := mode
            emit_json({ "type": "follow_up_mode", "mode": mode })
            loop()
        | "get_session_stats":
            emit_json({ "type": "session_stats",
                        "usage": usage_totals(),
                        "line": usage_line(),
                        "session": (if session.path is_a String | session.path | ""),
                        "name": session.name,
                        "leaf": (if session.leaf is_a Int | session.leaf | -1) })
            loop()
        | "switch_session":
            try:
              session := start_session(~cwd: cwd(),
                                       ~resume: to_string(req.get("path", "")))
              emit_json({ "type": "session_switched", "path": session.path })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "fork":
            try:
              session := start_session(~cwd: cwd(),
                                       ~resume: session.path, ~fork: #true)
              emit_json({ "type": "forked", "path": session.path })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "clone":
            try:
              session := start_session(~cwd: cwd(),
                                       ~resume: session.path, ~fork: #true)
              emit_json({ "type": "cloned", "path": session.path })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "set_session_name":
            try:
              session.set_name(to_string(req.get("name", "")))
              emit_json({ "type": "session_name", "name": session.name })
              ~catch e :: Exn.Fail:
                emit_json({ "type": "error", "message": e.message })
            loop()
        | "get_commands":
            emit_json({ "type": "commands",
                        "commands": (for List (c in registry.command_list()):
                                       { "name": c.name,
                                         "description": c.description }) })
            loop()
        | "quit":
            when turn_running()
            | rkt.#{break-thread}(turn_t)
              rkt.#{thread-wait}(turn_t)
            emit_json({ "type": "bye" })
        | t:
            emit_json({ "type": "error", "message": "unknown request type: " +& t })
            loop()
    | ~else:
        when turn_running()
        | rkt.#{thread-wait}(turn_t)

// ---- package subcommands: rho install <spec> / rho remove <name> / rho list ----
fun try_subcommand() :: Boolean:
  match opts["message"]
  | ["install", spec]:
      println(packages.install(to_string(spec)))
      #true
  | ["remove", name]:
      println(packages.remove(to_string(name)))
      #true
  | ["update"]:
      match packages.installed()
      | []: println("no packages installed")
      | ps:
          for (p in ps):
            println(packages.update(to_string(p)))
      #true
  | ["update", name]:
      println(packages.update(to_string(name)))
      #true
  | ["list"]:
      match packages.installed()
      | []: println("no packages installed")
      | ps:
          for (p in ps):
            println(p +& "  (" +& packages.packages_dir() +& "/" +& p +& ")")
      #true
  | ~else: #false

module main:
  // Process-level environment variables: visible to every subprocess spawned
  // by the agent (bash tool, grep, find, ...) and to extensions. Matches Pi.
  putenv("AI_AGENT", "rho")
  putenv("RHO_CODING_AGENT", "true")
  when !opts.get("offline", #false) && settings.get("offline", #false) == #false
  | modelsdev.refresh_async()
    #void
  when !opts.get("offline", #false) && settings.get("offline", #false) == #false
  | refresh_codex_models()
    #void
  cond
  | opts.get("export", #false) is_a String:
      run_export_mode()
  | opts.get("list_models", #false):
      // first run: wait for the catalog download so the list is complete
      when modelsdev.catalog() == {}
      | for values(done = #false) (_i in 0 .. 100):
          done || (block:
                     rkt.sleep(0.1)
                     modelsdev.catalog() != {})
        #void
      list_models()
  | try_subcommand():
      #void
  | ~else:
      init_trust()
      apply_tool_filters()
      if !opts.get("no_extensions", #false)
      | do_reload(#false)
      | mcp.reload(registry,
                   ~notify: fun (s): #void,
                   ~include_project: project_trusted)
      let tui_mode = opts.get("tui_mode", config.settings.get("tui_mode", "tui"))
      cond
      | rpc_mode: run_rpc()
      | headless: run_headless()
      | tui_mode == "tui" && stdin_is_tty():
          run_tui_mode()
      | tui_mode == "fullscreen" && stdin_is_tty():
          run_tui_mode()
      | ~else:
          install_repl_ask()
          run_repl(~banner: banner,
                   ~handle_command: handle_command,
                   ~handle_input: handle_input,
                   ~pending_ask: pending_ask_state,
                   ~answer_ask: reply_ask_state)
      registry.emit("session_shutdown", {})
      mcp.disconnect_all()
