#lang rhombus

// Line-oriented REPL with background turns.
//
// While a turn is running in a background thread, the main thread keeps
// reading stdin: plain lines become steering messages (delivered to the turn
// thread's mailbox and injected at the next tool-batch boundary), "/follow
// <msg>" queues a follow-up turn, and Ctrl-C breaks the turn thread.

import:
  lib("readline/readline.rkt") as rl
  lib("racket/base.rkt") as rkt
  lib("racket/port.rkt") as rktport

export:
  run_repl
  color
  add_history

fun color(code :: String, s :: String) :: String:
  "\u001B[" +& code +& "m" +& s +& "\u001B[0m"

// Pre-fill a line into readline history (e.g. /fork message editing).
fun add_history(s :: String):
  rl.#{add-history}(s)

// handle_command(name, args) is called for "/cmd args" lines; it returns
// #'quit to exit. handle_input(line) runs an agent turn.
fun repl_no_ask():
  #false
fun repl_ignore_ask(_d):
  #void

fun run_repl(~banner: banner :: String,
             ~handle_command: handle_command,
             ~handle_input: handle_input,
             ~pending_ask: pending_ask = repl_no_ask,
             ~answer_ask: answer_ask = repl_ignore_ask):
  let out = Port.Output.current()
  let stdin = rkt.#{current-input-port}()
  def mutable followups :: List = []
  out.write_string(banner)
  out.flush()

  fun note(s :: String):
    out.write_string(color("33", s) +& "\n")
    out.flush()

  // Watch a running turn; forward typed lines as steering.
  fun monitor(t):
    let dead = rkt.#{thread-dead-evt}(t)
    let r:
      try:
        rkt.sync(dead, rktport.#{read-line-evt}(stdin, #'any))
        ~catch e :: Exn.Break:
          answer_ask("deny")
          rkt.#{break-thread}(t)
          rkt.#{thread-wait}(t)
          #'interrupted
    cond
    | r == #'interrupted:
        note("[turn interrupted]")
    | r is_a ReadableString:
        let line = to_string(r).trim()
        cond
        | pending_ask() is_a Map:
            answer_ask(line)
            monitor(t)
        | line == "": monitor(t)
        | line == "/quit" || line == "/exit":
            rkt.#{break-thread}(t)
            rkt.#{thread-wait}(t)
            note("[turn interrupted]")
        | line.starts_with("/follow"):
            let msg = line.substring(7..).trim()
            if msg == ""
            | note("[usage: /follow <message>]")
            | followups := followups.add(msg)
              note("[follow-up queued: runs after this turn]")
            monitor(t)
        | line.starts_with("/"):
            note("[commands can't run during a turn; plain text steers, /follow <msg> queues]")
            monitor(t)
        | ~else:
            rkt.#{thread-send}(t, line)
            note("[steering queued: injected after the current tool batch]")
            monitor(t)
    | r == Port.eof:
        rkt.#{thread-wait}(t)
    | ~else: #void  // turn thread finished

  fun start_turn(input :: String):
    let t:
      rkt.thread(fun ():
                   try:
                     handle_input(input)
                     ~catch:
                     | e :: Exn.Break:
                         out.write_string("\n" +& color("33", "[interrupted]") +& "\n")
                     | e :: Exn.Fail:
                         out.write_string("\n" +& color("31", "error: ") +& e.message +& "\n"))
    monitor(t)
    out.flush()
    // deliver queued follow-ups as fresh turns
    match followups
    | []: #void
    | [next, & rest]:
        followups := rest
        note("[follow-up] " +& next)
        start_turn(next)

  recur loop():
    let line:
      try:
        rl.readline("\u276F ")
        ~catch e :: Exn.Break:
          out.write_string("\n")
          #'break
    cond
    | line == #'break:
        loop()
    | line == Port.eof:
        out.write_string("\nbye\n")
    | ~else:
        let line = to_string(line).trim()
        cond
        | line == "":
            loop()
        | line.starts_with("/follow"):
            // at the prompt a follow-up is just a normal turn
            rl.#{add-history}(line)
            let msg = line.substring(7..).trim()
            when msg != ""
            | start_turn(msg)
            loop()
        | line.starts_with("/"):
            rl.#{add-history}(line)
            let parts = line.substring(1..).split(" ")
            let name = (if parts == [] | "" | to_string(parts[0]))
            let args = (if parts.length() > 1
                        | String.join(parts.rest, " ")
                        | "")
            let r = try:
                      handle_command(name, args)
                      ~catch e :: Exn.Fail:
                        out.write_string(color("31", "error: ") +& e.message +& "\n")
                        #void
            if r == #'quit
            | out.write_string("bye\n")
            | loop()
        | ~else:
            rl.#{add-history}(line)
            start_turn(line)
            loop()
