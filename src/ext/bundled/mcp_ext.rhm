#lang rhombus

// MCP UI and connect. Protocol stays in ext/mcp.rhm; this extension
// owns /mcp and startup connect so --no-extensions stays disconnected.

import:
  "../../ext/mcp.rhm" as mcp

export:
  init

fun include_project(rho) :: Boolean:
  rho.state.get("project_trusted", #false) == #true

fun notify_fn(rho):
  fun say(s :: String):
    rho.notify(s)
  say

fun do_connect(rho):
  when rho.state.get("mcp_skip_reload", #false) != #true
  | mcp.reload(rho.events,
               ~notify: notify_fn(rho),
               ~include_project: include_project(rho))

fun mcp_cmd(rho, args :: String):
  let a = args.trim().foldcase()
  cond
  | a == "reload":
      rho.state["mcp_skip_reload"] := #false
      do_connect(rho)
      rho.notify("mcp reloaded")
  | a == "stop":
      mcp.disconnect_all()
      rho.notify("mcp stopped")
  | a == "" || a == "list":
      when !rho.open_page("extensions", "mcp")
      | match mcp.status()
        | []: rho.notify("no MCP servers (add ~/.rho/mcp.json)")
        | rows:
            for (row in rows):
              let srv = row[0]
              let ntools = row[1]
              let nres = mcp.list_resources().get(srv, []).length()
              let nprompts = mcp.list_prompts().get(srv, []).length()
              rho.notify("  " +& srv +& "  " +& ntools +& " tools  " +& nres +& " resources  " +& nprompts +& " prompts")
  | a == "resources":
      match mcp.list_resources()
      | {} :: Map: rho.notify("no MCP resources")
      | res_map:
          for ((srv, res_list) in res_map):
            rho.notify("  " +& srv +& ":")
            for (r in res_list):
              skip_when !(r is_a Map)
              rho.notify("    " +& to_string(r.get("uri", "")) +& "  " +& to_string(r.get("name", "")))
  | a == "prompts":
      match mcp.list_prompts()
      | {} :: Map: rho.notify("no MCP prompts")
      | p_map:
          for ((srv, p_list) in p_map):
            rho.notify("  " +& srv +& ":")
            for (p in p_list):
              skip_when !(p is_a Map)
              rho.notify("    " +& to_string(p.get("name", "")) +& "  " +& to_string(p.get("description", "")))
  | ~else:
      rho.notify("usage: /mcp [list|reload|stop|resources|prompts]")

fun init(rho):
  rho.register_command(
    ~name: "mcp",
    ~description: "MCP servers: /mcp [list|reload|stop|resources|prompts]",
    ~handler: fun (args): mcp_cmd(rho, args))
  rho.on("session_shutdown",
         fun (_e):
           mcp.disconnect_all()
           #false)
  do_connect(rho)
