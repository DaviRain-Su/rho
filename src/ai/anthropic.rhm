#lang rhombus

// Anthropic Messages API client with SSE streaming.

import:
  json
  net/http
  "sse.rhm"

export:
  stream_chat
  convert_messages

fun tools_payload(tools :: List) :: List:
  for List (t in tools):
    { "name": t["name"],
      "description": t["description"],
      "input_schema": t["schema"] }

// Split canonical messages into (system_text, anthropic_messages).
// Consecutive tool results merge into a single user message, as Anthropic requires.
fun convert_messages(messages :: List):
  def mutable system_text = ""
  def mutable out :: List = []
  def mutable pending_results :: List = []
  fun flush_results():
    when pending_results != []
    | out := out.add({ "role": "user", "content": pending_results })
      pending_results := []
  for (m in messages):
    match m.get("role", "")
    | "system":
        system_text := (if system_text == ""
                        | m.get("content", "")
                        | system_text +& "\n\n" +& m.get("content", ""))
    | "user":
        flush_results()
        let imgs = m.get("images", [])
        if imgs is_a List && imgs != []
        | out := out.add(
            { "role": "user",
              "content":
                [{ "type": "text", "text": m.get("content", "") }]
                  ++ (for List (im in imgs):
                        { "type": "image",
                          "source": { "type": "base64",
                                      "media_type": im.get("media_type", "image/png"),
                                      "data": im.get("data", "") } }) })
        | out := out.add({ "role": "user", "content": m.get("content", "") })
    | "assistant":
        flush_results()
        let blocks:
          // thinking blocks must be replayed verbatim (with signatures)
          // when thinking is enabled and the turn continues with tool results
          let base :: List:
            for List (tb in m.get("thinking_blocks", [])):
              tb
          let text = m.get("content", "")
          let base :: List = (if text is_a String && text != ""
                              | base.add({ "type": "text", "text": text })
                              | base)
          for values(bs = base) (tc in m.get("tool_calls", [])):
            let input = try:
                          json.from_string(tc["arguments"])
                          ~catch _: {}
            bs.add({ "type": "tool_use",
                     "id": tc["id"],
                     "name": tc["name"],
                     "input": if input is_a Map | input | {} })
        out := out.add({ "role": "assistant", "content": blocks })
    | "tool":
        pending_results := pending_results.add(
          { "type": "tool_result",
            "tool_use_id": m.get("tool_call_id", ""),
            "content": m.get("content", "") })
    | ~else: #void
  flush_results()
  values(system_text, out)

// Returns canonical assistant message (same shape as openai.stream_chat).
fun stream_chat(~base_url: base_url :: String,
                ~api_key: api_key :: String,
                ~model: model :: String,
                ~messages: messages :: List,
                ~tools: tools :: List = [],
                ~on_text: on_text = fun (s): #void,
                ~on_thinking: on_thinking = fun (s): #void,
                ~max_tokens: max_tokens :: Int = 8192,
                ~thinking: thinking :: maybe(String) = #false,
                ~extra_headers: extra_headers :: Map = {}) :: Map:
  let (system_text, converted) = convert_messages(messages)
  let budget:
    match thinking
    | "low": 4096
    | "medium": 8192
    | "high": 16384
    | ~else: 0
  let body:
    let base = { "model": model,
                 "max_tokens": (if budget > 0 | budget + max_tokens | max_tokens),
                 "messages": converted,
                 "stream": #true }
    let base:
      if budget > 0
      | base ++ { "thinking": { "type": "enabled", "budget_tokens": budget } }
      | base
    let base = (if system_text == "" | base | base ++ { "system": system_text })
    if tools == []
    | base
    | base ++ { "tools": tools_payload(tools) }
  let resp = http.post(base_url +& "/v1/messages",
                       ~headers: { "x-api-key": api_key,
                                   "anthropic-version": "2023-06-01" }
                                   ++ extra_headers,
                       ~data: http.payload.json(body),
                       ~stream: #true,
                       ~timeouts: http.Timeouts(~lease: 15, ~connect: 15, ~request: 600))
  when resp.status_code < 200 || resp.status_code >= 300
  | let err_body = Bytes.utf8_string(resp.body(), Char"\uFFFD")
    resp.close()
    error("anthropic: HTTP " +& resp.status_code +& ": " +& err_body)
  def mutable content = ""
  def mutable finish_reason = ""
  def mutable input_tokens = 0
  def mutable output_tokens = 0
  def mutable cache_read = 0
  def blocks = MutableMap()  // index -> {"type", "id", "name", "arguments"}
  fun handle(_event, data :: String):
    let msg = try:
                json.from_string(data)
                ~catch _: #false
    when msg is_a Map
    | match msg.get("type", "")
      | "message_start":
          let u = msg.get("message", {}).get("usage", {})
          when u is_a Map
          | input_tokens := u.get("input_tokens", 0)
              + u.get("cache_creation_input_tokens", 0)
              + u.get("cache_read_input_tokens", 0)
            cache_read := u.get("cache_read_input_tokens", 0)
      | "message_delta":
          let u = msg.get("usage", {})
          when u is_a Map
          | output_tokens := u.get("output_tokens", output_tokens)
          match msg.get("delta", {}).get("stop_reason", #'null)
          | "tool_use": finish_reason := "tool_calls"
          | "end_turn": finish_reason := "stop"
          | "max_tokens": finish_reason := "length"
          | s :: String: finish_reason := s
          | ~else: #void
      | "content_block_start":
          let idx = msg.get("index", 0)
          let cb = msg.get("content_block", {})
          match cb.get("type", "")
          | "tool_use":
              blocks[idx] := { "type": "tool_use",
                               "id": cb.get("id", ""),
                               "name": cb.get("name", ""),
                               "arguments": "" }
          | "thinking":
              blocks[idx] := { "type": "thinking", "thinking": "", "signature": "" }
          | "redacted_thinking":
              blocks[idx] := { "type": "redacted_thinking", "data": cb.get("data", "") }
          | ~else: #void
      | "content_block_delta":
          let idx = msg.get("index", 0)
          let delta = msg.get("delta", {})
          match delta.get("type", "")
          | "text_delta":
              let s = delta.get("text", "")
              content := content +& s
              on_text(s)
          | "thinking_delta":
              let s = delta.get("thinking", "")
              let prev = blocks.get(idx, { "type": "thinking", "thinking": "", "signature": "" })
              blocks[idx] := prev ++ { "thinking": prev.get("thinking", "") +& s }
              when s != "" | on_thinking(s)
          | "signature_delta":
              let prev = blocks.get(idx, { "type": "thinking", "thinking": "", "signature": "" })
              blocks[idx] := prev ++ { "signature": prev.get("signature", "") +& delta.get("signature", "") }
          | "input_json_delta":
              let prev = blocks.get(idx, { "type": "tool_use", "id": "", "name": "", "arguments": "" })
              blocks[idx] := prev ++ { "arguments": prev["arguments"] +& delta.get("partial_json", "") }
          | ~else: #void
      | "error":
          error("anthropic: stream error: " +& json.to_string(msg.get("error", {})))
      | ~else: #void
  sse.each_event(resp.output(), handle)
  resp.close()
  let tool_calls:
    for List:
      each idx in blocks.keys().sort()
      let b = blocks[idx]
      skip_when b.get("type", "") != "tool_use"
      { "id": b["id"], "name": b["name"],
        "arguments": if b["arguments"] == "" | "{}" | b["arguments"] }
  let thinking_blocks:
    for List:
      each idx in blocks.keys().sort()
      let b = blocks[idx]
      skip_when b.get("type", "") != "thinking" && b.get("type", "") != "redacted_thinking"
      b
  let thinking_text:
    String.join((for List:
                   each b in thinking_blocks
                   skip_when b.get("type", "") != "thinking"
                   to_string(b.get("thinking", ""))),
                "\n\n")
  let msg = { "role": "assistant", "content": content, "tool_calls": tool_calls,
              "finish_reason": finish_reason,
              "usage": { "input": input_tokens, "output": output_tokens,
                         "cache_read": cache_read } }
  let msg = (if thinking_blocks == [] | msg | msg ++ { "thinking_blocks": thinking_blocks })
  if thinking_text == "" | msg | msg ++ { "thinking": thinking_text }
