#lang rhombus

// Package management: git repos cloned into ~/.rho/packages/<name>.
// A package's extensions/, skills/ and prompts/ directories automatically
// join the discovery paths.

import:
  lib("racket/file.rkt") as rktfile
  "config.rhm"
  "crypto.rkt" as crypto
  "skills.rhm" as skills
  "prompts.rhm" as prompts

export:
  packages_dir
  install
  remove
  update
  installed
  package_extension_dirs
  package_skill_dirs
  package_prompt_dirs
  package_theme_dirs
  package_name
  safe_pkg_name

fun packages_dir() :: String:
  config.config_dir() +& "/packages"

fun installed() :: List:
  let dir = packages_dir()
  if filesystem.directory_exists(dir)
  | for List (f in filesystem.files(dir).sort()):
      skip_when !filesystem.directory_exists(dir +& "/" +& (f +& ""))
      f +& ""
  | []

// Accepts "npm:<pkg>", "git:<url>", a plain URL, a local path, or "owner/repo" GitHub shorthand.
fun resolve_url(spec :: String) :: String:
  cond
  | spec.starts_with("npm:"): spec // handled separately
  | spec.starts_with("git:"): spec.substring(4..)
  | spec.starts_with("http://") || spec.starts_with("https://")
      || spec.starts_with("git@"):
      spec
  | filesystem.file_exists(spec) || filesystem.directory_exists(spec): spec
  | ~else: "https://github.com/" +& spec

fun safe_pkg_name(name :: String):
  cond
  | name == "" || name == "." || name == "..": #false
  | name.contains("/") || name.contains("\\") || name.contains(".."): #false
  | name.contains("\n") || name.contains("\r"): #false
  | ~else: name

fun package_name(url :: String):
  let parts = url.split("/")
  let last = to_string(parts[parts.length() - 1])
  let last = if last.ends_with(".git") | last.substring(0 .. last.length() - 4) | last
  safe_pkg_name(last)

fun install(spec :: String) :: String:
  cond
  | spec.starts_with("npm:"): install_npm(spec)
  | filesystem.file_exists(spec) || filesystem.directory_exists(spec):
      install_local(spec)
  | ~else:
      let url = resolve_url(spec)
      let name = package_name(url)
      cond
      | !name: "invalid package name from " +& spec
      | ~else:
          let dest = packages_dir() +& "/" +& name
          cond
          | filesystem.directory_exists(dest):
              "already installed: " +& name +& " (rho remove " +& name +& " first)"
          | ~else:
              when !filesystem.directory_exists(packages_dir())
              | filesystem.make_directory(packages_dir(), ~parents: #true)
              let values(code, text) = crypto.#{run-argv}("git", ["clone", "--depth", "1", url, dest])
              if code == 0
              | skills.invalidate()
                prompts.invalidate()
                "installed " +& name +& " -> " +& dest
              | "install failed (exit " +& code +& "):\n" +& text

fun update(name :: String) :: String:
  let dest = packages_dir() +& "/" +& name
  cond
  | !(safe_pkg_name(name) is_a String):
      "invalid package name: " +& name
  | !filesystem.directory_exists(dest):
      "not installed: " +& name
  | ~else:
      let values(code, text) = crypto.#{run-argv}("git", ["-C", dest, "pull", "--ff-only"])
      let msg = to_string(text).trim()
      if code == 0
      | skills.invalidate()
        prompts.invalidate()
        name +& ": " +& msg
      | name +& ": update failed (exit " +& code +& "): " +& msg

fun remove(name :: String) :: String:
  let dest = packages_dir() +& "/" +& name
  cond
  | !(safe_pkg_name(name) is_a String):
      "invalid package name: " +& name
  | !filesystem.directory_exists(dest):
      "not installed: " +& name
  | ~else:
      rktfile.#{delete-directory/files}(Path(dest))
      skills.invalidate()
      prompts.invalidate()
      "removed " +& name

fun subdirs_of(kind :: String) :: List:
  for List (name in installed()):
    let d = packages_dir() +& "/" +& name +& "/" +& kind
    skip_when !filesystem.directory_exists(d)
    d

fun package_extension_dirs() :: List:
  subdirs_of("extensions")

fun package_skill_dirs() :: List:
  subdirs_of("skills")

fun package_prompt_dirs() :: List:
  subdirs_of("prompts")

fun package_theme_dirs() :: List:
  subdirs_of("themes")

fun npm_package_name(pkg :: String) :: String:
  // strip @version and @scope/
  let name = pkg.split("@")[0]
  let parts = name.split("/")
  to_string(parts[parts.length() - 1])

fun find_tarball(dir :: String):
  if filesystem.directory_exists(dir)
  | for values(found = #false) (f in filesystem.files(dir)):
      let fname = to_string(f)
      if fname.ends_with(".tgz") | fname | found
  | #false

fun install_npm(spec :: String) :: String:
  // spec is like "npm:@scope/pkg" or "npm:pkg@1.2.3"
  let pkg = spec.substring(4..) // strip "npm:"
  let name = npm_package_name(pkg)
  let dest = packages_dir() +& "/" +& name
  cond
  | !name: "invalid npm package name"
  | filesystem.directory_exists(dest):
      "already installed: " +& name +& " (rho remove " +& name +& " first)"
  | ~else:
      when !filesystem.directory_exists(packages_dir())
      | filesystem.make_directory(packages_dir(), ~parents: #true)
      // Use npm pack to download, then extract
      let tmpdir = dest +& ".tmp"
      filesystem.make_directory(tmpdir, ~parents: #true)
      let values(code, text) = crypto.#{run-argv}("npm", ["pack", pkg, "--pack-destination", tmpdir])
      cond
      | code != 0:
          rktfile.#{delete-directory/files}(Path(tmpdir))
          "npm pack failed (exit " +& code +& "):\n" +& text
      | ~else:
          // find the tarball
          let tgz = find_tarball(tmpdir)
          cond
          | !tgz:
              rktfile.#{delete-directory/files}(Path(tmpdir))
              "npm pack succeeded but no tarball found"
          | ~else:
              // extract
              let values(code2, text2) = crypto.#{run-argv}("tar", ["xzf", tgz, "-C", tmpdir])
              cond
              | code2 != 0:
                  rktfile.#{delete-directory/files}(Path(tmpdir))
                  "tar extract failed (exit " +& code2 +& "):\n" +& text2
              | ~else:
                  // move package/ contents to dest
                  let pkg_dir = tmpdir +& "/package"
                  cond
                  | !filesystem.directory_exists(pkg_dir):
                      rktfile.#{delete-directory/files}(Path(tmpdir))
                      "npm pack extracted but no package/ directory found"
                  | ~else:
                      filesystem.rename(Path(pkg_dir), Path(dest))
                      // cleanup tmp
                      rktfile.#{delete-directory/files}(Path(tmpdir))
                      skills.invalidate()
                      prompts.invalidate()
                      "installed " +& name +& " from npm -> " +& dest

fun copy_tree(src :: String, dest :: String):
  filesystem.make_directory(dest, ~parents: #true)
  for (f in filesystem.files(src)):
    let s = src +& "/" +& to_string(f)
    let d = dest +& "/" +& to_string(f)
    if filesystem.directory_exists(s)
    | copy_tree(s, d)
    | filesystem.write_string(d, filesystem.read_string(s), ~exists: #'error)

fun install_local(spec :: String) :: String:
  cond
  | !filesystem.file_exists(spec): "path not found: " +& spec
  | filesystem.directory_exists(spec):
      // directory: copy into packages
      let name = safe_pkg_name(to_string(spec.split("/").last()))
      cond
      | !name: "invalid package path: " +& spec
      | ~else:
          let dest = packages_dir() +& "/" +& name
          cond
          | filesystem.directory_exists(dest):
              "already installed: " +& name +& " (rho remove " +& name +& " first)"
          | ~else:
              when !filesystem.directory_exists(packages_dir())
              | filesystem.make_directory(packages_dir(), ~parents: #true)
              copy_tree(spec, dest)
              skills.invalidate()
              prompts.invalidate()
              "installed " +& name +& " from " +& spec
  | spec.ends_with(".rhm"):
      // single extension file: copy into packages as a package
      let base = to_string(spec.split("/").last())
      let name = safe_pkg_name(base.substring(0 .. base.length() - 4))
      cond
      | !name: "invalid package path: " +& spec
      | ~else:
          let dest = packages_dir() +& "/" +& name
          cond
          | filesystem.directory_exists(dest):
              "already installed: " +& name +& " (rho remove " +& name +& " first)"
          | ~else:
              when !filesystem.directory_exists(packages_dir())
              | filesystem.make_directory(packages_dir(), ~parents: #true)
              filesystem.make_directory(dest, ~parents: #true)
              filesystem.write_string(dest +& "/" +& name +& ".rhm",
                                      filesystem.read_string(spec),
                                      ~exists: #'error)
              skills.invalidate()
              prompts.invalidate()
              "installed " +& name +& " from " +& spec
  | ~else: "unsupported local path: " +& spec
