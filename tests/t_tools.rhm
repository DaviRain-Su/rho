#lang rhombus
import:
  "../src/kernel/registry.rhm" open
  "../src/tools/core.rhm" open

def reg = make_registry()
install_core_tools(reg)

// bash
def bash = reg.find_tool("bash")
println(bash.fn({}))
println(bash.fn({ "command": "echo hello && echo err >&2" }))
println(bash.fn({ "command": "exit 3" }))
println(bash.fn({ "command": "sleep 5", "timeout": 1 }))

// write / read / edit
def wf = reg.find_tool("write_file")
def rf = reg.find_tool("read_file")
def ef = reg.find_tool("edit_file")
println(wf.fn({ "path": "/tmp/pi-tests/demo.txt", "content": "line one\nline two\nline three" }))
println(rf.fn({ "path": "/tmp/pi-tests/demo.txt" }))
println(ef.fn({ "path": "/tmp/pi-tests/demo.txt", "old_string": "line two", "new_string": "LINE 2" }))
println(rf.fn({ "path": "/tmp/pi-tests/demo.txt", "offset": 2, "limit": 1 }))
println(ef.fn({ "path": "/tmp/pi-tests/demo.txt", "old_string": "nope", "new_string": "x" }))

// registry event + clear_extensions
reg.on("tool_call", fun (data): if data.get("toolName", "") == "bash" | { "block": #true, "reason": "no" } | #false)
println(reg.emit("tool_call", { "toolName": "bash" }))
println(reg.emit("tool_call", { "toolName": "read_file" }))
reg.current_source := "ext:/tmp/fake.rhm"
reg.register_tool(~name: "fake", ~description: "d", ~schema: {}, ~fn: fun (a): "x")
println(reg.find_tool("fake") != #false)
reg.clear_extensions()
println(reg.find_tool("fake") == #false)
println("tools ok")
