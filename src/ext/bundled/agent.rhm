#lang rhombus

// Nested agent tool. Like Pi: kernel only exposes run_turn + session;
// this extension owns the agent tool and the nesting policy (drop `agent`,
// depth, child prompt, subagent_* events).

import:
  "../../kernel/loop.rhm" open
  "../../kernel/registry.rhm" open
  "../../kernel/session.rhm" open
  "../../ui/tasks.rhm" as tasks

export:
  init
  run_subagent
  child_tool_names
  MAX_DEPTH

def MAX_DEPTH = 1

fun call1(rho, key :: String, fallback :: String, a):
  let f = rho.state.get(key, #false)
  let f:
    cond
    | f is_a Function: f
    | ~else: rho.state.get(fallback, #false)
  when f is_a Function
  | f(a)

fun call2(rho, key :: String, fallback :: String, a, b):
  let f = rho.state.get(key, #false)
  let f:
    cond
    | f is_a Function: f
    | ~else: rho.state.get(fallback, #false)
  when f is_a Function
  | f(a, b)

fun split_tools(raw) :
  cond
  | raw is_a String:
      for List (x in raw.split(",")):
        skip_when x.trim() == ""
        x.trim()
  | raw is_a List:
      for List (x in raw):
        to_string(x)
  | ~else: #false

fun child_prompt(rho) :: String:
  match rho.state.get("build_system_prompt", #false)
  | fn :: Function: to_string(fn())
  | ~else: "You are a coding agent. Use tools. Be concise."

fun child_tool_names(parent, allow) :: List:
  let names:
    for List (t in parent.tool_list()):
      skip_when t.name == "agent"
      t.name
  if allow is_a List && allow != []
  | for List (n in names):
      skip_when !allow.contains(n)
      n
  | names

fun last_assistant(session) :: String:
  for values(found = "") (m in session.messages()):
    let c = to_string(m.get("content", ""))
    if m.get("role", "") == "assistant" && c != "" | c | found

fun run_subagent(~config: config,
                 ~parent: parent,
                 ~prompt: prompt :: String,
                 ~system_prompt: system_prompt :: String,
                 ~label: label :: String = "subagent",
                 ~tools: tools = #false,
                 ~on_text: on_text = fun (s): #void,
                 ~on_thinking: on_thinking = fun (s): #void,
                 ~on_tool: on_tool = fun (name, args): #void,
                 ~on_tool_result: on_tool_result = fun (name, r): #void) :: String:
  let depth = parent.state.get("agent_depth", 0)
  let limit = parent.state.get("max_agent_depth", MAX_DEPTH)
  when depth >= limit
  | error("sub-agent depth limit reached (" +& limit +& ")")
  let child = make_registry()
  for (name in parent.tools.keys()):
    skip_when name == "agent"
    child.tools[name] := parent.tools[name]
  child.set_tool_filter(~allow: child_tool_names(parent, tools))
  child.state["agent_depth"] := depth + 1
  child.state["max_agent_depth"] := limit
  let child_session = start_session(~cwd: ".", ~no_session: #true)
  let child_sys = system_prompt
    +& "\n\nYou are a sub-agent (" +& label +& "). Complete the assigned task "
    +& "and return a concise final answer. Do not ask the user questions; decide and act. "
    +& "You cannot spawn further sub-agents."
  parent.emit("subagent_start", { "label": label, "prompt": prompt })
  run_turn(~config: config,
           ~registry: child,
           ~session: child_session,
           ~system_prompt: child_sys,
           ~input: prompt,
           ~on_text: fun (s):
                       parent.emit("subagent_text", { "label": label, "delta": s })
                       on_text(s),
           ~on_thinking: fun (s):
                           parent.emit("subagent_thinking", { "label": label, "delta": s })
                           on_thinking(s),
           ~on_tool: fun (name, args):
                       parent.emit("subagent_tool",
                                   { "label": label, "toolName": name, "input": args })
                       on_tool(name, args),
           ~on_tool_result: fun (name, r):
                              parent.emit("subagent_tool_result",
                                          { "label": label, "toolName": name, "result": r })
                              on_tool_result(name, r))
  let text = last_assistant(child_session)
  parent.emit("subagent_end", { "label": label, "result": text })
  if text == "" | "(sub-agent finished with no text)" | text

fun init(rho):
  when rho.state.get("max_agent_depth", #false) == #false
  | rho.state["max_agent_depth"] := MAX_DEPTH
  rho.register_prompt_snippet(
    "For isolated or parallelizable work, call the `agent` tool to run a nested "
      +& "sub-agent with its own session; it returns a final text answer. "
      +& "The sub-agent cannot spawn further agents.")
  rho.register_tool(
    ~name: "agent",
    ~description: "Delegate a focused subtask to a nested agent with its own session. Use for isolated research, a series of commands, or a draft change. The sub-agent cannot spawn further agents. Returns its final text answer.",
    ~schema: { "type": "object",
               "properties": {
                 "prompt": { "type": "string", "description": "The task for the sub-agent" },
                 "label": { "type": "string", "description": "Short name shown in the transcript" },
                 "tools": { "type": "string",
                            "description": "Optional comma-separated tool allowlist, e.g. read_file,grep,bash" }
               },
               "required": ["prompt"] },
    ~fn: fun (args):
           let prompt = to_string(args.get("prompt", ""))
           let label = to_string(args.get("label", "subagent"))
           let tools = split_tools(args.get("tools", #false))
           let cfg = rho.current_config()
           cond
           | prompt == "": "error: prompt is required"
           | cfg == #false: "error: no live config"
           | ~else:
               try:
                 rho.state["subagent_label"] := label
                 rho.notify("sub-agent " +& label +& " started")
                 let r = run_subagent(
                   ~config: cfg,
                   ~parent: rho.events,
                   ~prompt: prompt,
                   ~system_prompt: child_prompt(rho),
                   ~label: label,
                   ~tools: tools,
                   ~on_text: fun (s): call1(rho, "on_sub_text", "on_text", s),
                   ~on_thinking: fun (s): call1(rho, "on_sub_think", "on_thinking", s),
                   ~on_tool: fun (name, a):
                               call2(rho, "on_sub_tool", "on_tool", name, a),
                   ~on_tool_result: fun (name, res):
                                      call2(rho, "on_sub_result", "on_tool_result", name, res))
                 rho.notify("sub-agent " +& label +& " done")
                 r
                 ~catch e :: Exn.Fail:
                   "error: " +& e.message)
  rho.register_renderer(
    ~tool: "agent",
    ~fn: fun (phase, name, data):
           if phase == "call" && data is_a Map
           | "\u25CF agent " +& to_string(data.get("label", "subagent"))
           | #false)
  rho.on("subagent_start",
         fun (e :: Map):
           tasks.note_start("subagent", to_string(e.get("label", "subagent")))
           #false)
  rho.on("subagent_end",
         fun (e :: Map):
           let lab = to_string(e.get("label", "subagent"))
           rho.state["last_subagent"] := to_string(e.get("result", ""))
           tasks.note_end(lab)
           #false)
  rho.register_pane(
    ~id: "tasks",
    ~title: "tasks",
    ~lines: fun ():
              let live = tasks.live()
              if live == []
              | [{ "text": "  (no live tasks)", "id": "task_noop", "data": "" }]
              | for List (t in live):
                  { "text": "  \u25CE " +& to_string(t.get("kind", "task"))
                              +& "  " +& to_string(t.get("label", "")),
                    "id": "task_open",
                    "data": t.get("label", "") },
    ~on_click: fun (data):
                 let body = to_string(rho.state.get("last_subagent",
                                                    "(no sub-agent transcript yet)"))
                 rho.open_page("frame",
                               "sub-agent " +& to_string(data) +& "\n" +& body))
