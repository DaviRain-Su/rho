#lang rhombus

// OpenAI-compatible chat completions client with SSE streaming.
// Covers OpenAI, Moonshot/Kimi, OpenRouter, DeepSeek, Ollama, etc.

import:
  json
  net/http
  "sse.rhm"

export:
  stream_chat

// Convert canonical tool defs to OpenAI wire format
fun tools_payload(tools :: List) :: List:
  for List (t in tools):
    { "type": "function",
      "function": { "name": t["name"],
                    "description": t["description"],
                    "parameters": t["schema"] } }

// Canonical messages -> clean OpenAI wire format (strips extra keys)
fun messages_payload(messages :: List) :: List:
  for List (m in messages):
    match m.get("role", "")
    | "assistant":
        let base = { "role": "assistant", "content": m.get("content", "") }
        if m.get("tool_calls", []) == []
        | base
        | base ++ { "tool_calls":
                      for List (tc in m["tool_calls"]):
                        { "id": tc["id"],
                          "type": "function",
                          "function": { "name": tc["name"], "arguments": tc["arguments"] } } }
    | "tool":
        { "role": "tool",
          "tool_call_id": m.get("tool_call_id", ""),
          "content": m.get("content", "") }
    | role:
        { "role": role, "content": m.get("content", "") }

// Returns canonical assistant message:
//   {"role": "assistant", "content": String,
//    "tool_calls": [{"id", "name", "arguments"}, ...]}
fun stream_chat(~base_url: base_url :: String,
                ~api_key: api_key :: String,
                ~model: model :: String,
                ~messages: messages :: List,
                ~tools: tools :: List = [],
                ~on_text: on_text = fun (s): #void,
                ~thinking: thinking :: maybe(String) = #false) :: Map:
  let body:
    let base = { "model": model,
                 "messages": messages_payload(messages),
                 "stream": #true,
                 "stream_options": { "include_usage": #true } }
    let base = (if thinking | base ++ { "reasoning_effort": thinking } | base)
    if tools == []
    | base
    | base ++ { "tools": tools_payload(tools) }
  let headers:
    // identity: gzip streaming adds buffering that delays SSE deltas
    let base = { "Accept-Encoding": "identity" }
    if api_key == ""
    | base
    | base ++ { "Authorization": "Bearer " +& api_key }
  let resp = http.post(base_url +& "/chat/completions",
                       ~headers: headers,
                       ~data: http.payload.json(body),
                       ~stream: #true,
                       ~timeouts: http.Timeouts(~lease: 15, ~connect: 15, ~request: 600))
  when resp.status_code < 200 || resp.status_code >= 300
  | let err_body = Bytes.utf8_string(resp.body(), Char"\uFFFD")
    resp.close()
    error("openai: HTTP " +& resp.status_code +& ": " +& err_body)
  def mutable content = ""
  def mutable finish_reason = ""
  def mutable usage :: Map = {}
  def acc = MutableMap()  // index -> {id, name, arguments}
  fun handle(_event, data :: String):
    when data != "[DONE]"
    | let chunk = try:
                    json.from_string(data)
                    ~catch _: #false
      when chunk is_a Map
      | match chunk.get("usage", #'null)
        | u :: Map:
            let details = u.get("prompt_tokens_details", {})
            usage := { "input": u.get("prompt_tokens", 0),
                       "output": u.get("completion_tokens", 0),
                       "cache_read":
                         if details is_a Map
                         | details.get("cached_tokens", 0)
                         | u.get("cached_tokens", 0) }
        | ~else: #void
        let choices = chunk.get("choices", [])
        when choices is_a List && choices != []
        | match choices[0].get("finish_reason", #'null)
          | s :: String: finish_reason := s
          | ~else: #void
          let delta = choices[0].get("delta", {})
          match delta.get("content", #'null)
          | s :: String:
              // skip the empty role-announcement chunk so callers don't flip
              // to "responding" seconds before any text is visible
              when s != ""
              | content := content +& s
                on_text(s)
          | ~else: #void
          for (tc in delta.get("tool_calls", [])):
            let idx = tc.get("index", 0)
            let prev = acc.get(idx, { "id": "", "name": "", "arguments": "" })
            let fn = tc.get("function", {})
            let next:
              { "id": prev["id"] +& tc.get("id", ""),
                "name": prev["name"] +& fn.get("name", ""),
                "arguments": prev["arguments"] +& fn.get("arguments", "") }
            acc[idx] := next
  sse.each_event(resp.output(), handle)
  resp.close()
  let tool_calls:
    for List (idx in acc.keys().sort()):
      acc[idx]
  { "role": "assistant", "content": content, "tool_calls": tool_calls,
    "finish_reason": finish_reason, "usage": usage }
