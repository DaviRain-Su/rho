#lang rhombus

// Project trust: a project's .rho/ directory (extensions, skills, prompts)
// is only honored after the user approves it once. Decisions are stored in
// ~/.rho/trust.json as {"<cwd>": true|false}.

import:
  json
  lib("racket/base.rkt") as rkt
  "config.rhm"
  "errors.rhm" as errors

export:
  trust_status
  set_trust

fun trust_path() :: String:
  config.config_dir() +& "/trust.json"

fun read_trust() :: Map:
  errors.read_json_map(trust_path())

// #'trusted | #'untrusted | #'unknown
fun trust_status(cwd :: String):
  match read_trust().get(cwd, #'missing)
  | #true: #'trusted
  | #false: #'untrusted
  | ~else: #'unknown

fun set_trust(cwd :: String, decision :: Boolean):
  when !filesystem.directory_exists(config.config_dir())
  | filesystem.make_directory(config.config_dir(), ~parents: #true)
  filesystem.write_string(trust_path(),
                          json.to_string(read_trust() ++ { cwd: decision }),
                          ~exists: #'truncate)
  try:
    rkt.#{file-or-directory-permissions}(Path(trust_path()), 0o600)
    ~catch _:
      errors.warn("trust", "could not set permissions on trust.json")
