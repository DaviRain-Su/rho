#lang rhombus

// Prompt templates: markdown files in ~/.rho/prompts/ and <cwd>/.rho/prompts/.
// Invoked as /<filename> [args]. Frontmatter: description, argument-hint.
// "$ARGUMENTS" in the body is replaced with the arguments; if absent and
// arguments were given, they are appended.

import:
  "config.rhm"
  "frontmatter.rhm" as frontmatter

export:
  prompt_dirs
  discover
  find_template
  expand

fun prompt_dirs(~cwd: cwd :: String, ~extra: extra :: List = [],
                ~include_project: include_project = #true) :: List:
  [config.config_dir() +& "/prompts"]
    ++ (if include_project | [cwd +& "/.rho/prompts"] | [])
    ++ extra

fun template_of(path :: String, name :: String) :: Map:
  def (meta, body) = frontmatter.parse(filesystem.read_string(path))
  { "name": name,
    "description": meta.get("description", ""),
    "argument_hint": meta.get("argument-hint", ""),
    "body": body.trim() }

// Returns list of {"name", "description", "argument_hint", "body"}.
// ~direct entries are individual template .md files (--prompt-template).
fun discover(~cwd: cwd :: String, ~extra: extra :: List = [],
             ~include_project: include_project = #true,
             ~direct: direct :: List = [],
             ~standard: standard = #true) :: List:
  def seen = MutableMap()
  let direct_items:
    for List:
      each p in direct
      let p = to_string(p)
      skip_when !(p.ends_with(".md") && filesystem.file_exists(p))
      let parts = p.split("/")
      let fname = to_string(parts[parts.length() - 1])
      def name = fname.substring(0 .. fname.length() - 3)
      skip_when seen.has_key(name)
      seen[name] := #true
      template_of(p, name)
  let dir_items:
    for List:
      each dir in (if standard
                   | prompt_dirs(~cwd: cwd, ~extra: extra,
                                 ~include_project: include_project)
                   | [])
      skip_when !filesystem.directory_exists(dir)
      each entry in filesystem.files(dir).sort()
      def fname = entry +& ""
      skip_when !fname.ends_with(".md")
      def name = fname.substring(0 .. fname.length() - 3)
      skip_when seen.has_key(name)
      seen[name] := #true
      template_of(dir +& "/" +& fname, name)
  direct_items ++ dir_items

fun find_template(name :: String, ~cwd: cwd :: String, ~extra: extra :: List = [],
                  ~include_project: include_project = #true) :: maybe(Map):
  for values(found = #false) (t in discover(~cwd: cwd, ~extra: extra,
                                            ~include_project: include_project)):
    found || (t["name"] == name && t)

fun replace_all(s :: String, from :: String, to :: String) :: String:
  String.join(s.split(from, ~trim: #false), to)

// pi-style arguments: $1..$9 positional, $@ / $ARGUMENTS = everything.
fun expand(template :: Map, args :: String) :: String:
  let body = template["body"]
  let words:
    for List (w in args.trim().split(" ")):
      skip_when w == ""
      w
  let has_positional:
    for values(found = #false) (i in 1 .. 10):
      found || body.contains("$" +& i)
  let body2:
    for values(b = body) (i in 1 .. 10):
      replace_all(b, "$" +& i, if i <= words.length() | to_string(words[i - 1]) | "")
  cond
  | body.contains("$ARGUMENTS") || body.contains("$@"):
      replace_all(replace_all(body2, "$ARGUMENTS", args), "$@", args)
  | has_positional: body2
  | args.trim() == "": body2
  | ~else: body2 +& "\n\n" +& args
