#lang rhombus

// Configuration: provider profiles + current selection.
// Config file: ~/.rho/config.json (optional). Env vars supply API keys.

import:
  json
  rhombus/envvar
  lib("racket/base.rkt") as rkt
  "errors.rhm" as errors
  "sync.rkt" as sync

export:
  Config
  load_config
  config_dir
  sessions_dir
  set_sessions_dir
  global_extensions_dir
  project_extensions_dir
  set_api_key_override
  auth_list
  auth_set
  auth_set_record
  auth_record
  auth_remove
  has_auth
  credentials_ok
  has_chatgpt_auth
  migrate_chatgpt_auth
  auth_is_oauth
  home

fun home() :: String:
  match envvar.getenv("HOME")
  | s :: String:
      if s != "" | s | home_dir()
  | ~else: home_dir()

fun home_dir() :: String:
  try:
    let p = to_string(rkt.#{find-system-path}(rkt.#{string->symbol}("home-dir")))
    if p != "" | p | error("HOME is unset; refusing to store credentials under /tmp")
    ~catch _:
      error("HOME is unset; refusing to store credentials under /tmp")

fun config_dir() :: String:
  home() +& "/.rho"

// overridable via --session-dir or the session_dir setting
def mutable sessions_dir_override = #false

fun set_sessions_dir(d :: String):
  sessions_dir_override := d

fun sessions_dir() :: String:
  if sessions_dir_override is_a String
  | sessions_dir_override
  | config_dir() +& "/sessions"

fun global_extensions_dir() :: String:
  config_dir() +& "/extensions"

fun project_extensions_dir() :: String:
  ".rho/extensions"

// ---- credential store: ~/.rho/auth.json (0600) ----
// resolution order: --api-key override > auth.json entry > env var

def mutable api_key_override = #false

fun set_api_key_override(k :: String):
  api_key_override := k

fun auth_path() :: String:
  config_dir() +& "/auth.json"

def mutable auth_cache = #false
def mutable auth_mtime = -1
def auth_lock = sync.#{make-lock}()

fun load_auth_file(path :: String, mt) :: Map:
  let parsed:
    if mt < 0 | {} | errors.read_json_map(path)
  if parsed is_a Map | parsed | {}

fun read_auth_locked() :: Map:
  let path = auth_path()
  let mt:
    if filesystem.file_exists(path)
    | rkt.#{file-or-directory-modify-seconds}(path)
    | -1
  cond
  | auth_cache is_a Map && mt == auth_mtime: auth_cache
  | ~else:
      let m = load_auth_file(path, mt)
      auth_cache := m
      auth_mtime := mt
      m

fun read_auth() :: Map:
  sync.#{with-lock}(auth_lock, read_auth_locked)

fun write_auth_locked(m :: Map):
  auth_cache := m
  auth_mtime := (if filesystem.file_exists(auth_path())
                 | rkt.#{file-or-directory-modify-seconds}(auth_path())
                 | -1)
  #void

fun write_auth(m :: Map):
  when !filesystem.directory_exists(config_dir())
  | filesystem.make_directory(config_dir(), ~parents: #true)
  filesystem.write_string(auth_path(), json.to_string(m), ~exists: #'truncate)
  try:
    rkt.#{file-or-directory-permissions}(Path(auth_path()), 0o600)
    ~catch _: #void
  sync.#{with-lock}(auth_lock, fun (): write_auth_locked(m))

fun auth_list() :: List:
  read_auth().keys().sort()

fun auth_set(provider :: String, key :: String):
  write_auth(read_auth() ++ { provider: key })

fun auth_set_record(provider :: String, rec):
  write_auth(read_auth() ++ { provider: rec })

fun auth_record(provider :: String):
  read_auth().get(provider, #false)

fun token_from_record(rec) :: String:
  match rec
  | k :: String: k
  | m :: Map: to_string(m.get("access_token", m.get("key", "")))
  | ~else: ""

fun has_auth(provider :: String) :: Boolean:
  token_from_record(auth_record(provider)) != ""

fun auth_is_oauth(provider :: String) :: Boolean:
  match auth_record(provider)
  | m :: Map: m.get("type", "") == "oauth"
  | ~else: #false

fun has_chatgpt_auth() :: Boolean:
  (has_auth("openai-codex") && auth_is_oauth("openai-codex"))
    || (has_auth("openai") && auth_is_oauth("openai"))

// Older builds stored ChatGPT OAuth under "openai". Copy it to openai-codex.
fun migrate_chatgpt_auth():
  when has_auth("openai") && auth_is_oauth("openai") && !has_auth("openai-codex")
  | auth_set_record("openai-codex", auth_record("openai"))

fun env_set(env_name :: String) :: Boolean:
  env_name != "" && (block:
                       let v = envvar.getenv(env_name)
                       v is_a String && v != "")

// A provider can be used when an env key, auth.json entry, or --api-key is set.
// ChatGPT OAuth unlocks openai-codex only, never the platform `openai` API.
fun credentials_ok(provider :: String, env_name :: String) :: Boolean:
  cond
  | api_key_override is_a String: #true
  | provider == "openai-codex":
      has_chatgpt_auth() || env_set(env_name)
  | provider == "openai":
      (has_auth("openai") && !auth_is_oauth("openai")) || env_set(env_name)
  | has_auth(provider): #true
  | env_name == "": #true
  | ~else: env_set(env_name)

fun auth_remove(provider :: String) :: Boolean:
  let m = read_auth()
  if m.has_key(provider)
  | write_auth(m.remove(provider))
    #true
  | #false

class Config(mutable provider :: String,
             mutable model :: String,
             mutable providers :: Map,
             mutable thinking,
             mutable settings :: Map):
  method profile() :: Map:
    providers.get(provider, {})
  method register_provider(name :: String, prof :: Map):
    providers := providers ++ { name: prof }
  method base_url() :: String:
    profile().get("base_url", "")
  method api_key() :: String:
    cond
    | api_key_override is_a String: api_key_override
    | ~else:
        let stored = token_from_record(read_auth().get(provider, #false))
        let stored:
          if stored != ""
          | stored
          | if provider == "openai-codex"
            | token_from_record(read_auth().get("openai", #false))
            | ""
        if stored != ""
        | stored
        | let env_name = profile().get("api_key_env", "")
          if env_name == ""
          | ""
          | envvar.getenv(env_name) || ""
  method kind() :: String:
    // "openai" (chat completions) or "anthropic" (messages API)
    profile().get("kind", "openai")

